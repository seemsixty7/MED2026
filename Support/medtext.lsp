(defun c:mt()
  (prompt "\nSelect Text Objects to be changed: ")
  (setq chgss (ssget (list (cons 0 "TEXT")))
	mstent nil	 
  )
  (if chgss
   (progn
     (while (not mstent)
       (setq mstent (entsel "\nSelect Master Text Entity"))
       (if mstent
	 (progn
	   (setq mstent (entget (car mstent)))
	   (if (/= (dxf 0 mstent) "TEXT")
	     (progn
	       (setq mstent nil)
	       (prompt "\nEntity must be a text entity: ")
	     )
	   )
	 )
	 (prompt "\nYou must select a text entity: ")
       )
     )
     (if (not MT_MATCHLIST)
       (setq MT_MATCHLIST (list (cons 7 0) (cons 40 0) (cons 51 0) (cons 41 0) (cons 50 0)))
     )
     (setq tmplist MT_MATCHLIST)
     (if (> (setq index_val (load_dialog "med")) 0)
      (progn
         (if (new_dialog "Match_Text" index_val)
            (progn
	        (set_tile "mStyle" (itoa (dxf 7 tmplist)))
	        (set_tile "mHeight" (itoa (dxf 40 tmplist)))
	        (set_tile "mOblique" (itoa (dxf 51 tmplist)))
	        (set_tile "mWidth" (itoa (dxf 41 tmplist)))
	        (set_tile "mRotation" (itoa (dxf 50 tmplist)))
	      
                (action_tile "mStyle"    "(setq tmplist (listtoggle tmplist 7))")
                (action_tile "mHeight"   "(setq tmplist (listtoggle tmplist 40))")
	        (action_tile "mOblique"  "(setq tmplist (listtoggle tmplist 51))")
	        (action_tile "mWidth"    "(setq tmplist (listtoggle tmplist 41))")
	        (action_tile "mRotation" "(setq tmplist (listtoggle tmplist 50))")
                (setq result (start_dialog))
            )
         )
         (unload_dialog index_val)
         (if (= result 1)
            (progn
	      (setq MT_MATCHLIST tmplist)
	      (matchtxtprops chgss MT_MATCHLIST mstent)
	    )
         )

      )
     )
   )
   (prompt "\nNo text selected:")
  )
  (princ)
)

(defun matchtxtprops (mtchss chglist mstrdata)
  (setq chgdata nil)
  (foreach itm chglist
    (if (= (cdr itm) 1)
      (setq chgdata (append chgdata (list (assoc (car itm) mstrdata))))
    )
  )
  (setq num (sslength mtchss)
        cnt 0
  )
  (while (< cnt num)
    (setq ent (ssname mtchss cnt)
          data(entget ent)
	  cnt (1+ cnt)
    )
    (foreach itm chgdata
      (setq oldvals (assoc (car itm) data)
	    data    (subst itm oldvals data)
      )
    )
    (entmod data)
  )
)

(defun grldr(pt numpk blnm scadj)
  (setq genang nil)
  (if blnm
    (progn
      (if (not (tblsearch "BLOCK" blnm))
	 (command "insert" blnm nil)
      )
    )
  )
  (setq lentmrk(entlast))
  (while lentmrk
     (setq lentbk lentmrk
	   lentmrk (entnext lentmrk)
     )
  )
  (command "dim")
  (if blnm
    (command "dimblk" blnm)
  )
  (command "dimasz" (* (getvar "dimasz") scadj 1.0) "leader")
  (if pt
    (setq pt1 pt)
    (setq pt (getpoint "\nLeader start: ")
	pt1 pt
    )
  )
  (command pt)
  (setq cnt 0)
  (while (and (< cnt numpk) (setq pt (getpoint pt "\nto: ")))
    (if (not genang)
      (setq genang (angle pt1 pt))
    )
   (command pt)
   (setq cnt (1+ cnt))
  )
  (command nil)
  (command "dimblk" "." "dimasz" (* (getvar "dimasz") (/ 1.0 scadj) 1.0) "exit")
  (command "layer" "s" lay "")

  (if (if blnm (= (strcase blnm) "GRABIT"))
    (progn
      (if (and (<= genang (* PI 1.5)) (> genang (* PI 0.5)))
	 (progn
	    (if (not lentbk)
	      (setq entblk (ssname (setq allss (ssget "X"))
				   (1- (sslength allss))
			   )
	      )
	      (setq entblk (entnext lentbk))
	    )
	    (setq entdata(entget entblk)
		  oldy   (assoc 42 entdata)
		  newy   (cons 42 (* (dxf 42 entdata) -1))
		  entdata(subst newy oldy entdata)
	    )
	    (entmod entdata)
	 )
      )
    )
  )
  (entlast)
)

;; Attcopy for Revisions and whatever else
(defun c:attcopy()
  (setq patt (nentsel "\nSelect Attribute to Copy: "))
  (if patt
     (progn
        (setq pdata (entget (car patt))
              satt  (nentsel "\nSelect Attribute to copy to: ")
              sdata (entget (car satt))
              ment  (getmainent (car satt))
              pval  (dxf 1 pdata)
              sdata (subst (cons 1 pval) (assoc 1 sdata) sdata)
        )
        (entmod sdata)
        (entupd ment)
     )
  )
)
(defun getmainent(subent)
   (while (/= (dxf 0 (entget subent)) "SEQEND")
       (setq subent (entnext subent))
   )
   (setq retent (dxf -2 (entget subent)))
)

(defun c:LOADTXT()
	(setvar "REGENMODE" 0)
	(setvar "CMDECHO" 0)
	(foreach TextStyleToCreate MED_TXT_STYLE_MAP
		(command "STYLE" (nth 1 TextStyleToCreate)
			             (nth 2 TextStyleToCreate)
			             (* _SC _PLOTSCALE (nth 3 TextStyleToCreate))
			             (nth 4 TextStyleToCreate)
			             (nth 5 TextStyleToCreate)
			             (nth 6 TextStyleToCreate)
			             (nth 7 TextStyleToCreate)
			             (nth 8 TextStyleToCreate)
	   )
	)
	(C:BLDSTL)
	(princ "\nText Styles Now Loaded")
	(princ)
)
(princ "Done.")
