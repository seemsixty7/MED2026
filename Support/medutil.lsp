(defun c:lbreak( / lay ent selpt data pt1 pt2 ptlist stang endang nlen
                   val40 val41 stpt vtxt1 vtxt2 vtxt3 sqend)
   (med_cur_set "C:LBREAK")
   (setq ent    (entsel "\nSelect entity to break")
         selpt  (osnap (cadr ent) "NEA")
         ent    (car ent)
         data   (entget ent)
         pt1    (getpoint "\nPick 1st point of break: ")
         pt2    (getpoint "\nPick 2nd point of break: " pt1)
   )
   (if pt2
     (progn
       (setq ptlist (list pt1 pt2))
       (command "break" (list ent pt1) "F" pt1 pt2)
       (setq stang  (+ (* PI 0.5) (angle pt1 pt2)))
     )
     (setq ptlist (list pt1)
           stang  (+ (* PI 0.5) (angle pt1 selpt))
     )
   )

   (setq endang (+ stang PI)
         nlen   (* (* _PLOTSCALE 0.15625) _SC) ;Controls the offset from the line
         lay    (dxf 8 data)
   )

   (if (or (= (dxf 0 data) "POLYLINE")
           (= (dxf 0 data) "LWPOLYLINE")
       )
     (setq val40 (cons 40 (dxf 40 data))
           val41 (cons 41 (dxf 41 data))
     )
     (setq val40 (cons 40 0.0)
           val41 (cons 41 0.0)
     )
   )
   (command "layer" "s" lay "")
   (foreach stpt ptlist
     (setq spt (polar stpt stang (* 0.5 nlen))
           ept (polar spt  endang nlen)
           plin  (list (cons 0 "POLYLINE")
                       val41
                       val40
                 )
           vtxt1  (list (cons 0 "VERTEX") (cons 10 spt) (cons 42 1.0))
           vtxt2  (list (cons 0 "VERTEX") (cons 10 stpt) (cons 42 -1.0))
           vtxt3  (list (cons 0 "VERTEX") (cons 10 ept))
           sqend  (list (cons 0 "SEQEND"))
     )
     (entmake plin)
     (entmake vtxt1)
     (entmake vtxt2)
     (entmake vtxt3)
     (entmake sqend)
   )
   (med_ret_ok)
   (princ)
)
(defun snut(/ pt1 pt pt2 pt3 pt4 pt5 pt6 pt7 pt8 en1 en2 en3 en4 en5 
              en6 apt ang ans size)
  (ltback nil)
  (setq size (getdist "\nSize of nut: "))
  (initget 1 "Top Side")
  (setq ans (getkword "\nTop view/Side view: "))
  (if (= ans "Side")
   (progn
    (setq pt (getpoint "\nStart point of nut: "))
    (setq apt (getpoint pt "\nDirection angle of nut: "))
    (setq ang (- (angle pt apt) 1.5708)
          pt1 (polar pt ang (* size 0.5))
          pt2 (polar pt (+ ang 3.14159) (* size 0.5))
          pt3 (polar pt1 ang (* size 0.5))
          pt4 (polar pt2 (+ ang 3.14159) (* size 0.5))
          pt5 (polar pt3 (+ ang 1.5708) size)
          pt6 (polar pt1 (+ ang 1.5708) size)
          pt7 (polar pt2 (+ ang 1.5708) size)
          pt8 (polar pt4 (+ ang 1.5708) size)
    )
    (command "line" pt1 pt6 "") (setq en1 (entlast))
    (command "line" "" pt5 "")  (setq en6 (entlast))
    (command "line" "" pt3 "")  (setq en2 (entlast))
    (command "line" "" pt4 pt8 "") (setq en4 (entlast))
    (command "line" "" pt7 "")  (setq en5 (entlast))
    (command "line" "" pt2 "")  (setq en3 (entlast))
    (command "fillet" "r" (* size 0.125) "fillet" en3 en5 "fillet" en1 en6
                                         "fillet" en6 en3 "fillet" en5 en1
    )
    (command "erase" en5 en6 "" "line" pt8 pt5 "")
    (setq en5 (entlast))
    (command "fillet" en4 en5 "fillet" en2 en5)
   )
   (progn 
    (setq pt (getpoint "\nCenter point of nut: "))
    (command "circle" pt "d" size "polygon" "6" pt "i" size)
    )
   )
)
