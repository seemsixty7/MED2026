(defun grtag( cabtag / lay txt)
     (setq genang nil)
     (setq lay (getvar "clayer"))
     (smlayer _MEDTEXT)
     (command "style" "s1" nil)
     (if (not (tblsearch "BLOCK" "grab1"))
       (command "insert" "grab1" nil)
     )
     (setq lentmrk(entlast))

     (command "dim" "dimblk" "grab1" "dimasz" (* (getvar "dimasz") 0.5) "leader")
         (setq pt (getpoint "\nLeader start: ")
           pt1 pt)
         (command pt)
         (while
           (setq pt (getpoint pt "\nto: "))
       (if (not genang)
         (setq genang (angle pt1 pt))
       )
           (command pt)
         )
     (command "")
     (if (and (<= genang (* PI 1.5)) (> genang (* PI 0.5)))
        (progn
           (if (not lentmrk)
             (setq lentmrk (entnext (entlast)))
           )
           (setq entblk (entnext lentmrk)
                 entdata(entget entblk)
                 oldy   (assoc 42 entdata)
                 newy   (cons 42 (* (dxf 42 entdata) -1))
                 entdata(subst newy oldy entdata)
           )
           (entmod entdata)
        )
     )
         (setq txt cabtag)
         (command txt)
         (command "dimblk" "." "dimasz" (* (getvar "dimasz") 2.0) "exit")
         (command "layer" "s" lay "")
)

