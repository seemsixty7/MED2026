			      pt1    (cdr (nth 0 (nth 0 ptlist)))
			      pt2    (cdr (nth 1 (nth 0 ptlist)))
			      hyp    (distance pt1 pt2)
			      opp    18.0
			      adj    3.0
			      entang (angle pt2 pt1)
			      sinang (/ opp hyp)
			      cosang (/ adj hyp)
			      oppfac -1 
			      ang    (* oppfac (atan (/ sinang cosang)))
			      genang (+ entang ang)
			      gpt1   (polar pt2 genang adj)
			      genang (angle pt1 gpt1)
			      npt1 (polar gpt1 (+ genang (* PI (* oppfac 0.5))) alt)
			      npt2 (polar npt1 (+ genang PI) opp) 
			      npt3 (polar  npt2 (- genang (* PI (* oppfac 0.5))) size)
			      npt4 (polar npt3 genang 7.0)
			      npt6 gpt1
			      npt5 (polar npt6 (+ genang PI) 7.0)
			)
			(setq mlist  (list (list npt1  nil)
