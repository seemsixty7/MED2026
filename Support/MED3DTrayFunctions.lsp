(defun MEDDraw3DTray (TrayDataList UCSData / TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange) ; List includes StartPoint EndPoint Width Depth Flange
	(setq TrayPoint1 (nth 0 TrayDataList)
		  TrayPoint2 (nth 1 TrayDataList)
		  TrayWidth  (nth 2 TrayDataList)
		  TrayDepth  (nth 3 TrayDataList)
		  TrayFlange (if MED_TRAYTYPEOVERRIDE (nth 0 MED_TRAYTYPEOVERRIDE) (nth 4 TrayDataList))
		  ;TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBaseEnt (MEDBuild3DTrayBase TrayDataList UCSData) 
		  TrayFlangeEnt1 (MEDBuild3DTrayFlange TrayDataList 1.0 UCSData)
		  TrayFlangeEnt2 (MEDBuild3DTrayFlange TrayDataList -1.0 UCSData)
    )
    (command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 "")
)
(defun c:traytest()
	(MEDConvertTrayto3d (car (entsel)))
)
(defun MEDConvertTrayTo3D(TrayEntity / TrayPoint1 TrayPoint2)
	(setq TrayEntityData (entget TrayEntity)
		  TrayEntityUCSData (dxf 210 TrayentityData)
	)
	(if (equal (dxf 210 TrayEntityData) (list 0.0 0.0 1.0))
		(command "UCS" "")
		(command "ucs" "OB" trayentity)
	)
	(setq TrayPointlist (bld_lw_ptlist TrayEntity)
		  TrayPointList (car TrayPointlist)
		  TrayEntityPoint1 (append (cdr (nth 0 TrayPointlist)) (list (cdr (assoc 38 TrayEntityData))))
		  TrayEntityPoint1 (trans TrayEntityPoint1 TrayEntityUCSData 1) 
		  TrayEntityPoint2 (append (cdr (nth 1 Traypointlist)) (list (cdr (assoc 38 TrayEntityData))))
		  TrayEntityPoint2 (trans TrayEntityPoint2 TrayEntityUCSData 1)
		  TrayMEDData (xdataget TrayEntity _TRAY)
		  TrayUCSData (dxf 210 TrayEntityData)
	)


	(MEDDraw3DTray (list  TrayEntityPoint1
						  TrayEntityPoint2
			             (nth 2 TrayMEDData) ; Width
			             (nth 5 TrayMEDData) ; Depth
			             (nth 7 TrayMEDData) ; FlangeSize
			       )
					TrayUCSData
	)
)
		  
(defun MEDBuild3DTrayBase (MB3DTB_TrayData TrayUCSData / TrayPoint1 TrayPoint2 TrayAngle)
	(setq TrayPoint1 (nth 0 MB3DTB_TrayData)
		  TrayPoint2 (nth 1 MB3DTB_TrayData)
		  CheckAngle (angle TrayPoint1 TrayPoint2)
		  ExtrudeDir 1
	)
	;(if (not (equal UCSData (list 0.0 0.0 1.0)))
	;	(setq TrayPoint1 (trans TrayPoint1 TrayUCSData 1)
	;		  TrayPoint2 (trans TrayPoint2 TrayUCSData 1)
	;		  ExtrudeDir (if (or (<= CheckAngle (* PI 0.5)) (> CheckAngle (* PI 1.5))) -1 1)
	;	)
	;)
	(setq t1 traypoint1 t2 traypoint2)
	(setq TrayWidth  (nth 2 MB3DTB_TrayData)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* PI 0.5)) (* TrayWidth 0.5))
		  TrayBasePoint2 (polar TrayPoint1 (+ TrayAngle (* PI -0.5)) (* TrayWidth 0.5))
		  TrayBasePoint3 (polar TrayPoint2 (+ TrayAngle (* PI -0.5)) (* TrayWidth 0.5))
		  TrayBasePoint4 (polar TrayPoint2 (+ TrayAngle (* PI 0.5)) (* TrayWidth 0.5))
    )
    ;(command "UCS" "")
    (command "3DPOLY" TrayBasePoint1 TrayBasePoint2 TrayBasePoint3 TrayBasePoint4 "C")
    (command "Extrude" "l" "" (* MED_TRAY_MATERIALWIDTH ExtrudeDir)) 
    (setq TrayReturnEntity (entlast))
)
(defun MEDBuild3DTrayFlange (MB3DTF_TrayData MB3DTF_FlipValue UCSData / TrayPoint1 TrayPoint2) ;Flip value is 1.0 normal opposite is -1
	(setq TrayPoint1 (nth 0 MB3DTF_TrayData)
		  TrayPoint2 (nth 1 MB3DTF_TrayData)
		  TrayWidth  (nth 2 MB3DTF_TrayData)
		  TrayDepth  (nth 3 MB3DTF_TrayData)
		  TrayFlange (nth 4 MB3DTF_TrayData)
		 ; UCSPoint1 (trans TrayPoint1 UCSData 0)
		 ; UCSPoint2 (trans TrayPoint2 UCSData 0)
		 ; UCSPoint3 (polar UCSPoint1 (+ (angle UCSPoint1 UCSPoint2) (* PI 0.5)) 1.0)
	)
	;(if (equal (dxf 210 TrayEntityData) (list 0.0 0.0 1.0))
	;	(command "UCS" "")
	;	(progn
	;		(command "UCS" "" "UCS" "n" "3p"  UCSPoint1 UCSPoint2 UCSPoint3)
	;		(setq TrayPoint1 (trans UCSPoint1 0 1)
	;			  TrayPoint2 (trans UCSPoint2 0 1)
	;		)
	;	)
	;)
	(setq TrayLength (distance TrayPoint1 TrayPoint2)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* MB3DTF_FlipValue PI 0.5)) (* TrayWidth 0.5))
	)
	(if (< TrayFlange (* 2.0 MED_TRAY_MATERIALWIDTH))
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) MED_TRAY_MATERIALWIDTH)
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) MED_TRAY_MATERIALWIDTH)
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 "C")
		)
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) (* TrayFlange 0.5))
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ MED_TRAY_MATERIALWIDTH (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (- (* TrayFlange 0.5) MED_TRAY_MATERIALWIDTH))
				  TrayFlangePoint4 (list (nth 0 TrayFlangePoint3) (nth 1 TrayFlangePoint3) (+ (- TrayDepth (* 2.0 MED_TRAY_MATERIALWIDTH)) (nth 2 TrayFlangePoint3)))
				  TrayFlangePoint5 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ (- TrayDepth MED_TRAY_MATERIALWIDTH) (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint6 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint7 (polar TrayFlangePoint6 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (* TrayFlange 0.5))
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 TrayFlangePoint4 TrayFlangePoint5 TrayFlangePoint6 TrayFlangePoint7 "C")
		)
     )
     (command "Extrude" "l" "" "Dir" TrayBasePoint1 (polar TrayBasePoint1 Trayangle TrayLength))
     (setq TrayReturnEntity (entlast))
)

;;Work on Reverse Flange
(defun MEDBuild3DTrayFlange (MB3DTF_TrayData MB3DTF_FlipValue UCSData / TrayPoint1 TrayPoint2) ;Flip value is 1.0 normal opposite is -1
	;(princ "\nHere")
	(setq TrayPoint1 (nth 0 MB3DTF_TrayData)
		  TrayPoint2 (nth 1 MB3DTF_TrayData)
		  TrayWidth  (nth 2 MB3DTF_TrayData)
		  TrayDepth  (nth 3 MB3DTF_TrayData)
		  TrayFlange (nth 4 MB3DTF_TrayData)
		 ; UCSPoint1 (trans TrayPoint1 UCSData 0)
		 ; UCSPoint2 (trans TrayPoint2 UCSData 0)
		 ; UCSPoint3 (polar UCSPoint1 (+ (angle UCSPoint1 UCSPoint2) (* PI 0.5)) 1.0)
	)
	;(if (equal (dxf 210 TrayEntityData) (list 0.0 0.0 1.0))
	;	(command "UCS" "")
	;	(progn
	;		(command "UCS" "" "UCS" "n" "3p"  UCSPoint1 UCSPoint2 UCSPoint3)
	;		(setq TrayPoint1 (trans UCSPoint1 0 1)
	;			  TrayPoint2 (trans UCSPoint2 0 1)
	;		)
	;	)
	;)
	(setq TrayLength (distance TrayPoint1 TrayPoint2)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* MB3DTF_FlipValue PI 0.5)) (* TrayWidth 0.5))
	)
	(if (< (abs TrayFlange) (* 2.0 MED_TRAY_MATERIALWIDTH))
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) MED_TRAY_MATERIALWIDTH)
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) MED_TRAY_MATERIALWIDTH)
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 "C")
		)
		(progn
			(if (< TrayFlange 0.0)
				(setq FlangeFLIP T)
				(setq FlangeFLIP nil)
			)
				
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) (* TrayFlange 0.5))
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ MED_TRAY_MATERIALWIDTH (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (- (* TrayFlange 0.5) (if FlangeFlip (* -1 MED_TRAY_MATERIALWIDTH) MED_TRAY_MATERIALWIDTH)))
				  TrayFlangePoint4 (list (nth 0 TrayFlangePoint3) (nth 1 TrayFlangePoint3) (+ (- TrayDepth (* 2.0 MED_TRAY_MATERIALWIDTH)) (nth 2 TrayFlangePoint3)))
				  TrayFlangePoint5 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ (- TrayDepth MED_TRAY_MATERIALWIDTH) (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint6 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint7 (polar TrayFlangePoint6 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (* TrayFlange 0.5))
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 TrayFlangePoint4 TrayFlangePoint5 TrayFlangePoint6 TrayFlangePoint7 "C")
		)
     )
     (command "Extrude" "l" "" "Dir" TrayBasePoint1 (polar TrayBasePoint1 Trayangle TrayLength))
     (setq TrayReturnEntity (entlast))
)


;This function simply needs same info as tray, but then pass it the offset entity form the MED Centerline Copy and it will create it nice and smooth
(defun MEDBuild3DTrayFitFlange (MB3DTF_TrayData MB3DTF_FlipValue MB3DTF_Entity NotVerticalTrayFlag / TrayPoint1 TrayPoint2 TrayAngle) ;Flip value is 1.0 normal opposite is -1
	(setq TrayPoint1 (nth 0 MB3DTF_TrayData)
		  TrayPoint2 (nth 1 MB3DTF_TrayData)
		  TrayWidth  (nth 2 MB3DTF_TrayData)
		  TrayDepth  (nth 3 MB3DTF_TrayData)
		  TrayFlange (nth 4 MB3DTF_TrayData)
		  TrayLength (distance TrayPoint1 TrayPoint2)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* MB3DTF_FlipValue PI 0.5)) (* TrayWidth 0.5))
	)
	(if (< TrayFlange (* 2.0 MED_TRAY_MATERIALWIDTH))
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) MED_TRAY_MATERIALWIDTH)
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) MED_TRAY_MATERIALWIDTH)
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 "C")
			(setq ExtrudeEntity (entlast))
		)
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) (* TrayFlange 0.5))
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ MED_TRAY_MATERIALWIDTH (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (- (* TrayFlange 0.5) MED_TRAY_MATERIALWIDTH))
				  TrayFlangePoint4 (list (nth 0 TrayFlangePoint3) (nth 1 TrayFlangePoint3) (+ (- TrayDepth (* 2.0 MED_TRAY_MATERIALWIDTH)) (nth 2 TrayFlangePoint3)))
				  TrayFlangePoint5 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ (- TrayDepth MED_TRAY_MATERIALWIDTH) (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint6 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint7 (polar TrayFlangePoint6 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (* TrayFlange 0.5))
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 TrayFlangePoint4 TrayFlangePoint5 TrayFlangePoint6 TrayFlangePoint7 "C")
			(setq ExtrudeEntity (entlast))
		)
			
     )
    (setq t1 VerticalTrayFlag)
     (if NotVerticalTrayFlag
     	 (command "offset" (distance TrayPoint1 TrayBasePoint1) MB3DTF_Entity TrayBasePoint1 "")
     	 (command "Copy" MB3DTF_Entity "" TrayPoint1 TrayBasePoint1)
     )
     (setq PathEntity (entlast))
     (command "Extrude" ExtrudeEntity "" "Path" Pathentity)
     (setq TrayReturnEntity (entlast))
)


