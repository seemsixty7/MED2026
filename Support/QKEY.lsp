;; This command will simplay add a supplied number of specified RE's to an Entity:
(defun c:addre()
   (setq addent (car (entsel "\nSelect Entity to Add RE'S to: "))
         sizedata (xdataget addent _FITTING)
         tagdata  (nth 1 sizedata)
         sizedata (nth 2 sizedata)
         addata (entget addent (list _FITTING))
         xadata (cadr (assoc -3 addata))
         rsizelist (list 0.50 0.75 1.00
                                 1.25 1.50 2.00
                                 2.50 3.00 3.50
                                 4.00 5.00 6.00
                   )
         redlst  (reverse (cdr (member sizedata (reverse rsizelist))))
         recode nil
         resize nil
         retag  nil
         realt  nil
         redpth nil
         re_ssize 100.0

  )
  (while (not (member re_ssize redlst))
      (prompt "\nSize may not be larger than current size.")
      (initget 1)
      (setq re_ssize (getreal "\nSize to Reduce to: "))
  )
  (setq re_qty (getint "\nNumber of Reducers to add: "))
  (if (not re_qty)
      (setq re_qty 1)
  )
  (repeat re_qty
     (setq recode (append recode (list 103))
           resize (append resize (list sizedata))
           retag  (append retag  (list tagdata))
           realt  (append realt  (list re_ssize))
           redpth (append redpth (list 0.0))
     )
  )
  (setq xbdata(bld_fitting recode resize retag realt redpth)
        xdlist (xdatappend xbdata xadata)
  )
  (xdatadd addent xdlist)
  (princ)

)
