(defun c:dd ( / ent)
        (setq ent (entget (car (entsel))))
        (if (or (= (dxf 0 ent) "TEXT" )(= (dxf 0 ent) "ATTDEF") (= (dxf 0 ent) "MTEXT"))
              (command "DDEDIT" (dxf -1 ent) "")
              (if (= (dxf 0 ent) "INSERT")
                  (command "DDATTE" (dxf -1 ent))
              )
        )
        (princ)
)
(defun c:mcon( / ment mdata xdlist)
   (setq ment (car (entsel "\nSelect Entity to add a conduit: "))
         mdata(entget ment)
   )
   (if (or (= (dxf 0 mdata) "POLYLINE")
           (= (dxf 0 mdata) "LWPOLYLINE")
       )
      (progn
        (setq xdlist (bld_conduit _CODE _CSIZE "NONE" nil nil))
        (xdatadd ment xdlist)
      )
      (progn
        (prompt "\nEntity selected is not a polyline")
      )
   )
)
(defun c:medcopy()
   (setq ment (car (entsel "\nSelect Entity to with Xdata to Copy: "))
         mdata(entget ment (list "MED*"))
         xdlist (dxf -3 mdata)
         cnt 0
   )
   (prompt "\nSelect Entities to copy data to:")
   (setq copyss (ssget))
   (if copyss
     (progn
      (setq num (sslength copyss))
      (while (< cnt num)
        (setq ment (ssname copyss cnt)
              mdata (entget ment)
        )
        (foreach xditm xdlist
           (if (and (/= (dxf 0 mdata) "POLYLINE")
                    (/= (dxf 0 mdata) "LWPOLYLINE")
               )
             (progn
              (setq itmtype (car xditm))
              (if (or (= _CONDUIT itmtype)
                      (= _CABLE   itmtype)
                      (= _TRAY    itmtype)
                  )
                  (progn
                    (setq xditmnew nil)
                    (setq typlist (cdr xditm)
                          typlistcnt 0
                          xditmnew (list itmtype)
                    )
                    (foreach itmdata typlist
                       (setq firstpart (cdr itmdata)
                             field (substr firstpart 1 9)
                       )
                       (if (= field "ITEM_MESR")
                          (setq itmdata (cons 1000 "ITEM_MESR=F"))
                       )
                       (setq xditmnew (append xditmnew (list itmdata)))

                    )
                    (setq xditm xditmnew)
                  )
               )
              )
           )
           (xdatadd ment xditm)
        )
        (setq cnt (1+ cnt))
      )
     )
   )
)
