(defun trayepg_hd (blname1 blname2 mainlay angpt mwidth hd_list)
   (setq atmd (getvar "attdia")
         info nil
         cnt 0
         num 1
   )
   (setq opeqlst nil
         instr ""
   )
   (foreach itm hd_list
     (setq desc (nth 1 (med_detail itm))
           instr (strcat instr desc " ")
           opeqlst (append opeqlst (list (list desc itm)))
     )
   )
   (setq eqdef (car (nth 0 opeqlst)))

   (if (> (length hd_list) 1)
     (progn
       (initget instr)
       (if TAT_VAL
           (setq eqsel TAT_VAL)
           (setq eqsel (getkword (strcat "\nEnter Detail " instr "<" eqdef ">: ")))
       )
       (if (or (not eqsel) (= eqsel eqdef))
         (setq eqsel eqdef)
       )
     )
     (progn
        (setq eqsel eqdef)
     )
   )
   (setq TAT_VAL eqsel)
   (if _MATCODE
     (setq _EQCODE _MATCODE)
     (setq _EQCODE (cadr (assoc eqsel opeqlst)))
   )
   (setq eppt (getpoint "\nSelect Point for insertion: "))
   (if (not angpt)
      (progn
        (setq angpt(getangle eppt "\nRotation: "))
        (if (not angpt)
          (setq angpt (angle eppt (polar eppt 0.0 0.125)))
        )
      )
      (progn
        (setq angpt(osnap eppt "END")
              angpt(angle eppt angpt)
              angpt(+ angpt (* PI 0.5))
        )
      )
   )
   (setq epss (ssget "C" eppt eppt)
         num  (sslength epss)
   )
   (while (and (not info) (< cnt num))
    (if (< cnt num)
     (progn
       (setq ent  (ssname epss cnt)
                 info (xdataget ent _TRAY)
             cnt  (1+ cnt)
       )
     )
    )
   )
   (setq size (+ (nth 2 info) (nth 7 info))
             trtag (nth 1 info)
             ipt1 (polar eppt angpt (* size 0.5))
             ipt2 (polar eppt (+ angpt PI) (* size 0.5))
   )
   (smlayer _ZEROLAY)
   (setvar "attdia" 0)
   (medblkins nil blname1 ipt1 (* angpt (/ 180 PI)) _SC -1)
   (if TAT_VAL
       (progn
          (setq ent (entlast)
                val (sel_att_ent ent "DETNUM" TAT_VAL)
                TAT_VAL nil
          )
        )
   )
   (if blname2
    (progn
      (medblkins nil blname2 ipt2 (* (+ angpt PI) (/ 180 PI)) _SC -1)
      (if TAT_VAL
          (progn
             (setq ent (entlast)
                   val (sel_att_ent ent "DETNUM" TAT_VAL)
                   TAT_VAL nil
             )
           )
      )
    )
   )
   (setvar "attdia" atmd)
   (smlayer mainlay)
   (command "pline" ipt1 "w" (* _SC mwidth) "" ipt2 "")
   (setq _EQCODE (MEDRemapEQCodeToProjectCode _EQCODE))
   (setq ent (entlast)
         xdlist (bld_equip _EQCODE trtag)
   )
   (xdatadd ent xdlist)

)
(defun getinst( addone ecode)
   (setq _EQCODE ecode)
   (if addone
    (progn
      (setq addlet (getstring "\nDetail <A> or B:"))
      (if (or (not addlet) (= addlet ""))
         (setq _EQCODE _EQCODE)
         (setq _EQCODE (1+ _EQCODE))
      )
    )
   )
)
(defun geninst(inprt1 inprt2 inprt3)
   (medblkins _MEDINST inprt1 nil 0.0 _SC 9)
   (setq stpt (getvar "LASTPOINT")
         ang  (getangle stpt "\nSelect loaction of additonal inst: ")
         data1(get_bl_data inprt1)
         data2(get_bl_data inprt2)
         data3(get_bl_data inprt3)
         cnt  0
   )
   (if ang
     (progn
        (cond
            ((= ang 0.0)
              (setq cnt 0)
            )
            ((= ang (* PI 0.5))
              (setq cnt 1)
            )
            ((= ang PI)
              (setq cnt 2)
            )
            ((= ang (* PI 1.5))
              (setq cnt 3)
            )
        )
        (setq dist1 (nth cnt data1)
              dist2 (+ (nth 0 data2) (nth cnt data3))
              inspt1(polar stpt ang dist1)
              inspt2(polar inspt1 ang dist2)
        )
        (medblkins _MEDINST inprt2 inspt1 (* ang (/ 180 PI)) _SC 0)
        (medblkins _MEDINST inprt3 inspt2 0.0 _SC 0)
     )
   )
)
(defun getlit(letlist ecode)
   (setq _EQCODE ecode)
   (if letlist
    (progn
      (setq klet "")
      (foreach let letlist
         (setq klet (strcat klet " " let ))
      )
      (initget 1 klet)
      (setq let (getkword (strcat "\nDetail letter (" klet ")"))
            len (length letlist)
            sublst(member let letlist)
            sublen(length sublst)
            letnum(- len sublen)
            _EQCODE (+ letnum _EQCODE)
      )
    )
   )
)
(defun c:attlay()
  (setq txtlay (nth 0 _MEDTEXT))
  (prompt "\nSelect blocks to change attribute layer: ")
  (setq attss (ssget))
  (if attss
     (progn
       (setq sslen (sslength attss)
             cnt 0
       )
       (while (< cnt sslen)
         (setq attent (ssname attss cnt)
               mattent attent
               attdata(entget attent)
         )
         (if (and (= (dxf 0 attdata) "INSERT") (assoc 66 attdata))
           (progn
              (while (/= (dxf 0 attdata) "SEQEND")
                (setq attent (entnext attent)
                      attdata(entget attent)
                      old (assoc 8 attdata)
                      new (cons 8 txtlay)
                      attdata(subst new old attdata)
                )
                (entmod attdata)
              )
              (entupd mattent)
           )
         )
         (setq cnt (1+ cnt))
      )
    )
  )
)
(defun c:wbl()
  (setq blname (getstring "\nBlock name: ")
        inspt (getpoint "\n Insertion Point: ")
        ss (ssget)
  )
  (if (tblsearch "BLOCK" blname)
    (command "block" blname "y" inspt ss "")
    (command "block" blname inspt ss "")
  )
  (setq fullfile (strcat CPELECDIR "/USER/" blname))
  (if (findfile (strcat fullfile ".dwg"))
     (command "wblock" fullfile "y" blname)
     (command "wblock" fullfile blname)
  )
)
(defun c:attrot()
  (prompt "\nSelect blocks to rotate attributes to 0 degrees: ")
  (setq attss (ssget))
  (if attss
     (progn
       (setq sslen (sslength attss)
             cnt 0
       )
       (while (< cnt sslen)
         (setq attent (ssname attss cnt)
               mattent attent
               attdata(entget attent)
               blinpt (dxf 10 attdata)
               blinptx (car blinpt)
               blinpty (cadr blinpt)
               blinptz (caddr blinpt) 
               blinpt (list blinptx blinpty 0.0)
         )
         (if (and (= (dxf 0 attdata) "INSERT") (assoc 66 attdata))
           (progn
              (while (/= (dxf 0 (entget (entnext attent))) "SEQEND")
                (setq attent (entnext attent)
                      attdata(entget attent)
                )
                (setq attins (dxf 10 attdata)
                      attinsx (car attins)
                      attinsy (cadr attins)
                      attins (list attinsx attinsy 0.0)
                      attrot (dxf 50 attdata)
                      attdist(distance blinpt attins)
                      attang (angle blinpt attins)
                      newpt  (polar blinpt (- attang attrot) attdist)
                      old_pt (assoc 10 attdata)
                      new_pt (cons 10 newpt)
                      attdata(subst new_pt old_pt attdata)
                      oldang (assoc 50 attdata)
                      newang (cons 50 0.0)
                      attdata(subst newang oldang attdata)
                )
                (entmod attdata)
              )
              (entupd mattent)
           )
         )
         (setq cnt (1+ cnt))
      )
    )
  )
)

