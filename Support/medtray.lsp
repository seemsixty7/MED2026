(defun m3dvtrayfit(trent)
  (setq trentdata (xdataget trent _FITTING))
  (setq trvdata   (vtrayxdataget trent))
  (if (and trentdata trvdata)
    (progn
      (setq trpt         (nth 0 (bld_lw_ptlist trent))
	    trpt1        (cdr (nth 0 trpt))
	    trpt2        (cdr (nth 1 trpt))
	    actgenang   (angle trpt1 trpt2)
	    sendlist     (list (nth 2 trentdata)
			       (nth 5 trentdata)
			       (nth 1 trvdata)
			       (nth 2 trvdata)
			       (nth 3 trvdata)
			 )
      )
      (if (= (nth 3 trvdata) 1)
	(setq sendgenang PI
	      rotateang (- actgenang PI)
	      shiftfact (* _PLOTSCALE (nth 5 trentdata))
	)
	
	(setq sendgenang 0
	      rotateang actgenang
	      shiftfact 0.0
	)
      )
      (3dtrayang (nth 4 trvdata) trpt1 sendgenang sendlist)
      (setq 3dvent (entlast)
	    3dventdata (entget 3dvent)
	    3dold  (assoc 210 3dventdata)
	    3dnew  (cons 210 (list 0.0 -1.0 -1.83691e-016))
	    3dventdata (subst 3dnew 3dold 3dventdata)
	    3dventdata (entmod 3dventdata)
	    3dventpts (nth 0 (bld_lw_ptlist 3dvent))
	    frompoint (trans (append (cdr (nth 0 3dventpts)) (list (dxf 38 3dventdata))) 3dvent 0)
	    movetopoint (append (polar trpt1 (+ actgenang (* PI -0.5)) (* 0.5 (* _PLOTSCALE (nth 2 trentdata)))) (list (dxf 38 (entget trent))))
      )
      (command "move" 3dvent "" frompoint movetopoint)
      (command "rotate" 3dvent "" movetopoint (angtos rotateang 0 8))
      (command "move" 3dvent "" "0,0,0" (strcat "0,0," (rtos shiftfact 2 8)))
      (command "extrude" 3dvent "" (* (nth 3 trvdata) (* _PLOTSCALE (nth 2 trentdata))) "" )
      
     
    )
  )
)
(defun 3dtrayang (inclang intpt genang tr_dat_lst / tr_data)
  (setq trsize (nth 0 tr_dat_lst)
        trdpth (nth 1 tr_dat_lst)
        trrad  (nth 2 tr_dat_lst)
        trtan  (nth 3 tr_dat_lst)
        angpol (nth 4 tr_dat_lst)  ;-1 = -(down) and 1 = +(up)
	;angpol -1
  )
  
  (setq troff (* trdpth 0.5))
  (setq br_len  (+ trrad troff trtan)
        bul     (med_tan (* inclang 0.25))
  )
  (setq tpt1   (polar intpt genang (* _PLOTSCALE trtan))
        tcen   (polar tpt1  (+ genang (* angpol (* PI 0.5))) (* _PLOTSCALE (+ trrad troff)))
        tpt2   (polar tcen  (+ (angle tcen tpt1) (* angpol inclang)) (* _PLOTSCALE (+ trrad troff)))
        pt1    (polar intpt (- genang (* PI 0.5)) (* _PLOTSCALE troff))
        pt2    (polar pt1   genang (* _PLOTSCALE trtan))
        tpt    (polar tpt2  (+ genang (* angpol inclang)) (* _PLOTSCALE trtan))
        tang   (angle tpt2  tpt)
        pt4    (polar tpt   (- tang (* PI 0.5)) (* _PLOTSCALE troff))
        pt3    (polar pt4   (+ tang PI) (* _PLOTSCALE trtan))
        pt5    (polar tpt   (+ tang (* PI 0.5)) (* _PLOTSCALE troff))
        pt6    (polar pt5   (+ tang PI) (* _PLOTSCALE trtan))
        pt8    (polar intpt (+ genang (* PI 0.5)) (* _PLOTSCALE troff))
        pt7    (polar pt8   genang (* _PLOTSCALE trtan))
        prpt1  (be pt1 pt8)
        prpt1a (be pt2 pt7)
        prpt2  (be pt4 pt5)
        prpt2a (be pt3 pt6)


  )
  (setq mlist  (list (list pt1 nil)
                     (list pt2 (* bul angpol))
                     (list pt3 nil)
                     (list pt4 nil)
