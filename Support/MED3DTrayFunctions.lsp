(defun MEDConvertTrayElbowTo3D(TrayEntity)
	(setq TrayEntityData (entget TrayEntity)
		  TrayMEDData (xdataget TrayEntity _FITTING)
	)
	(if (equal (dxf 210 TrayEntityData) (list 0.0 0.0 1.0))
		(command "UCS" "")
		(command "ucs" "OB" trayentity)
	)
	(MEDDraw3DTrayFit (list nil
			             	nil
			             (nth 2 TrayMEDData) ; Width
			             (nth 5 TrayMEDData) ; Depth
			             (nth 6 TrayMEDData) ; FlangeSize
			       )
		           TrayEntity
	)
)

(defun MEDDraw3DTrayFit (TrayDataList TrayCenterLine / TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange) ; List includes StartPoint EndPoint Width Depth Flange
	(setq t1e Traycenterline)
	(setq t1d traydatalist)
	(setq Traypoints (bld_lw_ptlist TrayCenterLine)
		  TrayCenterLineData (entget TrayCenterLine)
		  TrayPoint38 (dxf 38 TrayCenterLineData)
	)
	(setq TrayPoint1 (trans (append (cdr (nth 0 (car TrayPoints))) (list traypoint38)) T1e 1) 
		  TrayPoint2 (trans (append (cdr (nth 1 (car TrayPoints))) (list traypoint38)) T1e 1)
	)
	(if (setq TrayfitVData (vtrayxdataget TrayCenterline))
		(progn
			;(sd)
			(command "UCS" "New" "3P" TrayPoint1 TrayPoint2 (list (car TrayPoint1) (cadr Traypoint1) (- (caddr TrayPoint1) 10.0)));(* 1.0 (nth 3 trayfitvdata)))))
			;(sd)
			(setq TrayPoint1 (trans (append (cdr (nth 0 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1) 
		          TrayPoint2 (trans (append (cdr (nth 1 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		    )
		 )
	)
	(setq TrayWidth  (nth 2 TrayDataList)
		  TrayDepth  (nth 3 TrayDataList)
		  TrayFlange (nth 4 TrayDataList)
		  TrayDataList (list TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange)
		  ;TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBaseEnt (MEDBuild3DTrayFitBase TrayDataList TrayCenterLine) 
		  TrayFlangeEnt1 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TrayCenterLine (not (vtrayxdataget TrayCenterline)))
		  TrayFlangeEnt2 (MEDBuild3DTrayFitFlange TrayDataList -1.0 TrayCenterLine (not (vtrayxdataget TrayCenterline)))
		  ;TrayFlangeEnt1 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TrayCenterLine (equal (dxf 210 TrayCenterLineData) (list 0.0 0.0 1.0)))
		  ;TrayFlangeEnt2 (MEDBuild3DTrayFitFlange TrayDataList -1.0 TrayCenterLine (equal (dxf 210 TrayCenterLineData) (list 0.0 0.0 1.0)))
    )
    (command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 "")
)    	  
(defun MEDBuild3DTrayFitBase (MB3DTB_TrayData MB3DTF_Entity / TrayPoint1 TrayPoint2 TrayAngle)
	(setq t1 MB3DTB_TrayData)
	(setq TrayPoint1 (nth 0 MB3DTB_TrayData)
		  TrayPoint2 (nth 1 MB3DTB_TrayData)
		  TrayWidth  (nth 2 MB3DTB_TrayData)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* PI 0.5)) (* TrayWidth 0.5))
		  TrayBasePoint2 (polar TrayPoint1 (+ TrayAngle (* PI -0.5)) (* TrayWidth 0.5))
		  TrayBasePoint3 (list (car TrayBasePoint2) (cadr TrayBasepoint2) (+ (caddr TrayBasePoint2) MED_TRAY_MATERIALWIDTH))
		  TrayBasePoint4 (list (car TrayBasePoint1) (cadr TrayBasepoint1) (+ (caddr TrayBasePoint1) MED_TRAY_MATERIALWIDTH))
     )
     (command "Copy" MB3DTF_Entity "" "0,0,0" "0,0,0")
     (setq PathEntity (entlast))
     (command "3DPOLY" TrayBasePoint1 TrayBasePoint2 TrayBasePoint3 TrayBasePoint4 "C")
     (command "Extrude" "l" "" "path" Pathentity)
     (setq TrayReturnEntity (entlast))
)

(defun MEDSet3DTrayLayer(trayentity)
	(setq trayentityLayer (dxf 8 (entget trayentity))
		  traydesc (substr trayentityLayer 10)
		  trayLayer (strcat "MEDTRAY" traydesc)
		  3dtraylayername (strcat "MED_3DTRAY-" traydesc)
	)
	(if (not (tblsearch "layer" 3DTrayLayerName))
		(progn
			(setq NewLayColor (MEDGetLayerColor TrayLayer)
		          NewLayData (list 3dTrayLayerName NewLayColor "Continuous" nil)
		    )
		    (medsmlayer newlaydata)
		)
		(setvar "CLAYER" 3DtrayLayerName)
	)
)
	
	

(defun c:Make3DTray()
	(smlayer _MED3DTRAY)
	(command "vpoint" "1,1,1")
	(initget "3DS Dwg Layer")
	(setq outputformat (getkword "\n Output to 3DS Layer <Dwg>: "))
	(if (not outputformat)
	  (setq outputformat "Dwg")
	)
	(setq 3douttray (ssget "x" (list (list -3 (list "MED_TRAY")))))
	(if 3douttray
	  (progn
	    (setq trayoutnum (sslength 3douttray)
	   trayoutcnt 0
	    )
	    (while (< trayoutcnt trayoutnum)
	    	  (setq trayent (ssname 3douttray trayoutcnt))
	    	  (MEDSet3DTrayLayer trayent)
	    	  (MEDConvertTrayto3d trayent)
	    	  (setq trayoutcnt (1+ trayoutcnt))
	    )
	  )
	)
	(setq 3douttray (ssget "x" (list (list -3 (list "MED_FITTING")))))
	(if 3douttray
	   (progn
	     (setq trayoutnum (sslength 3douttray)
	     	   trayoutcnt 0
	     )
	     (while (< trayoutcnt trayoutnum)
	     	 (setq trayent (ssname 3douttray trayoutcnt))
	     	 (MEDSet3DTrayLayer trayent)
	     	 (MEDConvertTrayFittingsTo3D trayent)
	     	 (setq trayoutcnt (1+ trayoutcnt))
	     )
	   )
	 )
	(command "UCS" "")
	(cond
    ((= outputformat "3DS")
      (Prompt "\nMake3dtray will export to 3ds file:")
      (if (not c:3dsout)
	(arxload "render")
      )
      (setq 3dsoutfname (getfiled "Select file name for 3Dtray output" (substr (getvar "dwgname") 1 (- (strlen (getvar "dwgname")) 4)) "3ds" 1))
      (c:3dsout (ssget "X" (list (cons 0 "3dsolid") (cons 8 (nth 0 _MED3DTRAY)))) 0 0 30 0.1 3dsoutfname)
      (command "erase" (ssget "X" (list (cons 0 "3dsolid") (cons 8 (nth 0 _MED3DTRAY)))) "")
      (command "plan" "")
    )
    ;;testing default path as the drawing prefix
    ;(setq 3dsoutfname (getfiled "Select file name for 3Dtray output" (substr (getvar "dwgname") 1 (- (strlen (getvar "dwgname")) 4)) "dwg" 1))
    ((= outputformat "Dwg")
      (setq 3dsoutfname (getfiled "Select file name for 3Dtray output" (getvar "dwgprefix") "dwg" 1))
      (if (findfile 3dsoutfname)
	(command "wblock" 3dsoutfname "y" "")
	(command "wblock" 3dsoutfname "")
      )
      ;(command (list 0.0 0.0 0.0) (ssget "X" (list (cons 0 "3dsolid") (cons 8 (nth 0 _MED3DTRAY)))) "")
      (command (list 0.0 0.0 0.0) (ssget "X" (list (cons 0 "3dsolid") )) "")
      (command "plan" "")
    )
    ((= outputformat "Layer")
      ;(command "-layer" "off" "*" "" "On" (nth 0 _MED3DTRAY) "")
      (prompt "\nUse the PLAN command to return to plan view:")
    )
  )

)

(defun MEDConvertTrayFittingsTo3D (trayfitent)
  (setq fitptbllist (bld_lw_ptlist trayfitent)
  	    fitptlist   (nth 0 fitptbllist)
  	    fitbllist   (nth 1 fitptbllist)
  	    Trayfitdata (xdataget trayfitent _FITTING)
  	    fitwidth    (nth 2 trayfitdata)
  	    fitdpth     (nth 5 trayfitdata)
  	    fitalt      (nth 4 trayfitdata)
  	    m3delev     (getvar "ELEVATION")
  	    trayfitentdata (entget trayfitent)
  )
  (setvar "ELEVATION" (dxf 38 trayfitentdata))
  
  (cond
    ((= (length fitptlist) 4)
    		(MEDConvertTrayElbowTo3D trayfitent)
    )
    ((= (length fitptlist) 7)
    		(MEDConvertTrayTeeTo3D trayfitent)
    )
    ((= (length fitptlist) 10)
    	  	(MEDConvertTrayTeeTo3D trayfitent)
    )
    ((and (= (length fitptlist) 2)
	  (= 18.0 (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist)))))
       (MEDConvertTrayReducerTo3d trayfitent)
    )
    ((and (= (length fitptlist) 2)
          (> (rem (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist))) 1.0) 0.0))
       (MEDConvertTrayLRReducerTo3d trayfitent)
     )
    (T nil)
    
  )
  (setvar "ELEVATION" m3delev)
  
)

