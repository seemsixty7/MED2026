(setq MEDListAppDataFormat
	(list (list "MED_FITTING" (list (list "Tag" 0) (list "Size" 1) (list "Code" 2) (list "Desc" nil) (list "Alt" 3) (list "Depth" 4)(list "Flange" 5)))
		  (list "MED_CONDUIT" (list (list "Tag" 0) (list "Size" 1) (list "Code" 2) (list "Desc" nil) (list "Dist" 3) (list "Mesr" 4)))
		  (list "MED_CABLE"   (list (list "Tag" 0) (list "Size" 1) (list "Code" 2) (list "Desc" nil) (list "RTag" 3) (list "Dist" 4) (list "Mesr" 5)))
		  (list "MED_TRAY"    (list (list "Tag" 0) (list "Size" 1) (list "Code" 2) (list "Desc" nil) (list "Dist" 3) (list "Depth" 4) (list "Mesr" 5) (list "Flange" 6)))
		  (list "MED_EQUIP"   (list (list "Tag" 0) (list "Code" 1) (list "Desc" nil)))
	)
)

(defun c:MEDlist( / medent)
 (med_cur_set "c:MEDlist")
 (while (not medent)
   (setq medent (car (entsel "\nSelect Entity to list: ")))
 )
 (setq applist (xd_apps medent)
       numapps (length applist)
       appcnt  0
 )
 (prompt "\n\n")
 (textscr)
 (while (< appcnt numapps)
   (setq appnm (nth appcnt applist)
         appdata (cdr (xdataget medent appnm))
         datalen (length appdata)
         applen  (eval (read (strcat "len" (substr appnm 4))))
         numtags (/ datalen applen)
         tagcnt 0
   )
   (while (< tagcnt numtags)
   	 (setq printdata (ShowMEDListData appnm tagcnt appdata medent))
   	 (foreach stringtoprint printdata
   	 	 (princ stringtoprint)
   	 )
     (setq tagcnt (1+ tagcnt))
     (getstring "\n\nPress Return to Continue")
   )
   (setq appcnt (1+ appcnt))
 )
 (med_ret_ok)
 (princ)
)
(defun ShowMEDListData (MEDAppName TagCount MEDAppData MEDEntity / 
		smld-count smld-printlist smld-applen smld-datacnt smld-code smld-mesr smld-length)
	(setq smld-printlist (list)
		  smld-applen (eval (read (strcat "len" (substr MEDAppName 4))))
		  smld-DataCnt (1- smld-applen)
	)
	(foreach MEDListItem (cadr (assoc MEDAppName MEDListAppDataFormat))
		(setq smld-count (cadr MedListItem))
	    (if smld-count
	    	(setq smld-item (nth (+ smld-count (*  smld-applen TagCount)) MEDAppData))
	    )
		(setq smld-itemstring (car MEDListItem))
		(cond
			((= smld-itemstring "Tag")
				(setq smld-printlist (append smld-printlist (list (strcat "\n" MEDAppName " | " smld-item))))
			)
			((= smld-itemstring "Size")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Size  = " (rtos smld-item 2 8))))
					  smld-size smld-item
				)
			)
			((= smld-itemstring "Code")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Code  = " (itoa smld-item))))
					  smld-code smld-item
				)
			)
			((= smld-itemstring "Desc")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Desc  = " (clookup smld-code smld-size MEDAppName)))))
			)
			((= smld-itemstring "Alt")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Alt   = " (rtos smld-item 2 4)))))
			)
			((= smld-itemstring "Depth")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Depth = " (rtos smld-item 2 4)))))
			)
			((= smld-itemstring "Dist")
				(if (= MEDAppName _TRAY)
					(setq smld-mesr (nth (1- (+ smld-datacnt (*  smld-applen TagCnt))) MEDAppData))
					(setq smld-mesr (nth (+ smld-datacnt (*  smld-applen TagCnt)) MEDAppData))
				)
				(if (= smld-mesr "T")
					(setq smld-length (polylen MEDEntity)
						  smld-printlist (append smld-printlist (list (strcat "\n--->Dist  = " (rtos smld-length) " (Calculated)")))
					)
					(setq smld-printlist (append smld-printlist (list (strcat "\n--->Dist  = " (rtos smld-item) " (Stored)"))))
				)
			)
			((= smld-itemstring "Mesr")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Mesr  = " smld-item))))
			)
			((= smld-itemstring "RTag")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->RTag  = " smld-item))))
			)
			((= smld-itemstring "Flange")
				(setq smld-printlist (append smld-printlist (list (strcat "\n--->Flange= " (rtos smld-item 2 2)))))
			)
			
		)
	)
	smld-printlist
)

(defun med_text (txt_specifier txt_startpoint)
                                        ;txt_specifier is the reference found int the spec file as in "T1" or "T2"
                                        ;txt_startpoint is a startpoint, rotation for the text, and justification ((0.0 0.0 0.0) 0.0 "L")
   (setq layerdata _MEDTEXT)
   (setq txtstydata (assoc txt_specifier MED_TXT_STYLE_MAP)
         txtstylnm  (cadr txtstydata)
         txtstyleheight (nth 3 txtstydata)
   )
   (if layerdata
      (progn
         (if (= (length txtstydata) 11)
            (setq newlayname (if (= (nth 1 (nth 9 txtstydata)) 0)
            		       		(strcat (nth 0 (nth 9 txtstydata)) (nth 0 layerdata))
            		       		(strcat (nth 0 layerdata) (nth 0 (nth 9 txtstydata)))
            		       	)
                  oldlayname (nth 0 layerdata)
                  layerdata  (subst newlayname oldlayname layerdata)
                  newlaycol  (nth 10 txtstydata)
                  oldlaycol  (nth 1 layerdata)
                  layerdata  (subst newlaycol oldlaycol layerdata)
            )
         )
         (smlayer layerdata)
      )
      (prompt "\n*********Layer Info Not Found Using Current Layer")
   )
   (if (not (tblsearch "style" txtstylnm))
      (MEDMakeTextStyle txtstydata)
   )
   (if (= (getvar "TILEMODE") 1)
   	   (MEDSetTextStyleHeight txtstylnm (* _SC _PLOTSCALE txtstyleheight))
   	   (MEDSetTextStyleHeight txtstylnm (* _PLOTSCALE txtstyleheight))
   )
   (if txt_startpoint
      (command "dtext"
               "s"
               txtstylnm
               "j"
               (nth 2 txt_startpoint)
               (nth 0 txt_startpoint)
               (nth 1 txt_startpoint)
      )
      (command "dtext" "s" txtstylnm)
   )
)

