(defun c:traysize(/ tsz_sizelist)
   (setq tsz_sizelist (list (list 6.0 "a")
                            (list 9.0 "b")
                            (list 12.0 "c")
                            (list 18.0 "d")
                            (list 24.0 "e")
                            (list 30.0 "f")
                            (list 36.0 "g")
                            (list 42.0 "h")
                            (list 48.0 "i")
                      )
         tsz_depthlist(list (list 3.0 "a")
                            (list 4.0 "b")
                            (list 6.0 "c")
                      )
         tsz_radiuslist(list (list 12.0 "a")
                             (list 24.0 "b")
                             (list 36.0 "c")
                             (list 48.0 "d")
                       )
   )
   (setq curwidth (assoc _TRSIZE tsz_sizelist)
         curwidth (strcat "size" (nth 1 curwidth))
         curdepth (assoc _TRDEPTH tsz_depthlist)
         curdepth (strcat "depth" (nth 1 curdepth))
         curradius(assoc _TRRAD tsz_radiuslist)
         curradius(strcat "radius" (nth 1 curradius))
         tsz_width _TRSIZE
         tsz_depth _TRDEPTH
         tsz_radius _TRRAD
         tsz_add    _TRFITTADD
   )
   (if (> (setq index_val (load_dialog "MED")) 0)
      (progn
         (if (new_dialog "Med_TraySize" index_val)
            (progn 
                (set_tile curwidth "1")
                (set_tile curdepth "1")
                (set_tile curradius "1")
                (action_tile "sizea" "(setq tsz_width 6.0)")
                (action_tile "sizeb" "(setq tsz_width 9.0)")
                (action_tile "sizec" "(setq tsz_width 12.0)")
                (action_tile "sized" "(setq tsz_width 18.0)")
                (action_tile "sizee" "(setq tsz_width 24.0)")
                (action_tile "sizef" "(setq tsz_width 30.0)")
                (action_tile "sizeg" "(setq tsz_width 36.0)")
                (action_tile "sizeh" "(setq tsz_width 42.0)")
                (action_tile "sizei" "(setq tsz_width 48.0)")
                (action_tile "deptha" "(setq tsz_depth 3.0)")
                (action_tile "depthb" "(setq tsz_depth 4.0)")
                (action_tile "depthc" "(setq tsz_depth 6.0)")
                (action_tile "radiusa" "(setq tsz_radius 12.0 tsz_add 0)")
                (action_tile "radiusb" "(setq tsz_radius 24.0 tsz_add 1)")
                (action_tile "radiusc" "(setq tsz_radius 36.0 tsz_add 2)")
                (action_tile "radiusd" "(setq tsz_radius 48.0 tsz_add 120)")
                (action_tile "accept" "(done_dialog 1)")
                (action_tile "cancel" "(done_dialog 0)")
                (setq result (start_dialog))
            )
         )
         (unload_dialog index_val)
         (if (= result 1)
          (progn
           (setq _TRSIZE tsz_width
                 _TRDEPTH tsz_depth
                 _TRRAD tsz_radius
                 _TRFITTADD tsz_add
           )
           (c:tray)
          )
         )
      )
   )
)


