;
; C:CTAG inserts a conduit tagging block and retrieves info about conduit
; from entity selected
;

(defun c:ctag( / ctlt ctlay cctid ccten cctszl ctpt1 ctpt2 ctpt3 ctan ctlen ctinfo)
         (setq ctlt (getvar "celtype"))
         (med_cur_set "c:ctag")
         (ltback nil)
         (setq ctlay (getvar "clayer"))
         (smlayer _ECTAG)
         (setq curattdia (getvar "attdia"))
         (setq cten     (entsel "\nSelect conduit to tag: ")
               ctendata (xdataget (car cten) _CONDUIT)
         )
         (if ctendata
           (progn
             (setq ctszl (nth 2 ctendata)
                   ctid  (nth 1 ctendata)
             )
             (setq ctinfo (nth 2 (getsize nil (rtos ctszl 4))))
             (if ctinfo
               (progn
                  (setvar "ATTDIA" 0)
                  (command "insert" "contag" "pscale" (* _PLOTSCALE _SC) pause (* _PLOTSCALE _SC)
                           "" "" ctid ctinfo "" "")
                  
                  (setvar "ATTDIA" curattdia)
                  (setq ctpt1 (getvar "lastpoint")
                        ctpt2 (osnap (cadr cten) "perp")
                        ctan (/ (* (angle ctpt1 ctpt2) 180.0) pi))
                  (if (or (= 180 ctan) (= 0 ctan))
                     (setq ctlen (* _SC 0.28867513))
                     (setq ctlen (* _SC 0.25))
                  )
                  (setq ctpt3 (polar ctpt1 (angle ctpt1 ctpt2) ctlen))
                  (command "line" ctpt3 ctpt2 "")
               )
               (progn
                 (princ)
                 (prompt "Invalid selection of conduit ")
                 (princ)
               )
             )
           )
           (progn
             (princ)
             (prompt "Invalid selection of conduit ")
             (princ)
           )
         )
         (command "layer" "s" ctlay "")
         (ltback ctlt)
)
(defun c:traycon()
   (setq etype (getstring "\nSide entry or End entry <S>/E: "))
   (if (or (= etype "") (= (strcase etype) "S"))
      (setq _EQCODE (nth 0 _TRAYCON))
      (setq _EQCODE (nth 1 _TRAYCON))
   )
   (setq conlist (list 0.75 0 "B"
                       1.0  1 "C"
                       1.5  2 "E"
                       2.0  3 "F"
                       2.5  4 "G"
                       3.0  5 "H"
                       4.0  6 "J"
                 )
   )
   (setq con    (car (entsel "\nSelect conduit: "))
         data   (xdataget con _CONDUIT)
         consz  (nth 2 data)
         contg  (nth 1 data)
         endlist(member consz conlist)
         addmt  (nth 1 endlist)
         lalet  (nth 2 endlist)
         _EQCODE(+ _EQCODE addmt)
   )
   (smlayer (cons (strcat lalet "con") _CON))
   (medblkins nil "tray2con" nil nil _SC 9)
   (setq ent (entlast)
         xdlist (bld_equip _EQCODE contg)
   )
   (xdatadd ent xdlist)

   (princ)
)
