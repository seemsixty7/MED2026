(defun MEDDatabaseRestore (FileImportName ProjectToRestore)
	(prompt "\nMED Database Restore utility")
	(setq fileimporthandle (open FileImportname "r")
		  fileimportdata (list)
	)
	(while (setq linedata (read-line fileimporthandle))
		(setq fileimportdata (append fileimportdata (list (mparse linedata "," "\"" nil))))
	)
	(close fileimporthandle)
	(if (/= ProjectToRestore "ALL")
		(progn
			(setq DatatoRestore (list))
			(foreach RecordItem (cdr FileImportData)
				(if (= (car (reverse RecordItem)) ProjectToRestore)
					(setq DatatoRestore (append DataToRestore (list recordItem)))
				)
			)
		)
		(setq DatatoRestore (cdr FileimportData))
	)
	
