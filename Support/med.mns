***POP2
**POP2CONDUIT
               [Plan Conduit]
               [->Set Size]
                 [ Set Size... ]^C^CCONSIZE 
                 [--]
                 [  1/2"  ]^C^C(setq _ACSIZE 0.84  _CLETT "A" _CSIZE 0.5 ) 
                 [  3/4"  ]^C^C(setq _ACSIZE 1.050 _CLETT "B" _CSIZE 0.75) 
                 [   1"   ]^C^C(setq _ACSIZE 1.315 _CLETT "C" _CSIZE 1.0 ) 
                 [ 1-1/4" ]^C^C(setq _ACSIZE 1.660 _CLETT "D" _CSIZE 1.25) 
                 [ 1-1/2" ]^C^C(setq _ACSIZE 1.9   _CLETT "E" _CSIZE 1.5 ) 
                 [   2"   ]^C^C(setq _ACSIZE 2.375 _CLETT "F" _CSIZE 2.0 ) 
                 [ 2-1/2" ]^C^C(setq _ACSIZE 2.875 _CLETT "G" _CSIZE 2.5 ) 
                 [   3"   ]^C^C(setq _ACSIZE 3.50  _CLETT "H" _CSIZE 3.0 ) 
                 [ 3-1/2" ]^C^C(setq _ACSIZE 4.0   _CLETT "I" _CSIZE 3.5 ) 
                 [   4"   ]^C^C(setq _ACSIZE 4.50  _CLETT "J" _CSIZE 4.0 ) 
                 [   5"   ]^C^C(setq _ACSIZE 5.563 _CLETT "K" _CSIZE 5.0 ) 
                 [<-   6"   ]^C^C(setq _ACSIZE 6.625 _CLETT "L" _CSIZE 6.0 ) 
               [--]
               [EMT     ]^C^C(smlayer _MCON) (setq _CODE 4) CONDUIT 
               [PVC     ]^C^C(smlayer _MCON) (setq _CODE 3) CONDUIT 
               [RIGID   ]^C^C(smlayer _MCON) (setq _CODE 1) CONDUIT 
               [PVC-COAT]^C^C(smlayer _MCON) (setq _CODE 2) CONDUIT 
               [--]
               [Down    ]^C^C(smlayer _MCON) (medblkins nil "1cond" nil nil _SC 4) 
               [Up      ]^C^C(smlayer _MCON) (medblkins nil "1conu" nil nil _SC 5) 
               [--]
               [Flex    ]^C^Cflex 
               [--]
               [Define: ]^C^CDEFINE 
               [--]
               [ Icons     ]$i=MED.MEDplancon $i=* 
               [--]
               [->Fittings]
                 [Bub     ]^C^C(setq _FITTCODE  94) (medblkins _MEDFIT "1bub"     nil nil _SC 2) 
                 [Cee     ]^C^C(setq _FITTCODE  50) (medblkins _MEDFIT "1cee"     nil nil _SC 2) 
                 [Gual    ]^C^C(setq _FITTCODE 141) (medblkins _MEDFIT "1gual"    nil nil _SC 2) 
                 [Guat    ]^C^C(setq _FITTCODE 142) (medblkins _MEDFIT "1guat"    nil nil _SC 2) 
                 [Guax    ]^C^C(setq _FITTCODE 143) (medblkins _MEDFIT "1guax"    nil nil _SC 2) 
                 [Guatside]^C^C(setq _FITTCODE 142) (medblkins _MEDFIT "1guatsid" nil nil _SC 2) 
                 [Gualside]^C^C(setq _FITTCODE 141) (medblkins _MEDFIT "1gualsid" nil nil _SC 2) 
                 [Hub     ]^C^C(setq _FITTCODE 120) (medblkins _MEDFIT "1hub"     nil nil _SC 2) 
                 [Lbr     ]^C^C(setq _FITTCODE  30) (medblkins _MEDFIT "1lbr"     nil nil _SC 2) 
                 [Lbl     ]^C^C(setq _FITTCODE  30) (medblkins _MEDFIT "1lbl"     nil nil _SC 2) 
                 [Lbd  R  ]^C^C(setq _FITTCODE  39) (medblkins _MEDFIT "1lbdr"    nil nil _SC 2) 
                 [Lbd  L  ]^C^C(setq _FITTCODE  39) (medblkins _MEDFIT "1lbdl"    nil nil _SC 2) 
                 [Lb-down ]^C^C(setq _FITTCODE  30) (medblkins _MEDFIT "1lbd"     nil nil _SC 3) 
                 [Lb-up   ]^C^C(setq _FITTCODE  30) (medblkins _MEDFIT "1lbu"     nil nil _SC 6) 
                 [Lby     ]^C^C(setq _FITTCODE  41) (medblkins _MEDFIT "1lby"     nil nil _SC 2) 
                 [Plug-Rec]^C^C(setq _FITTCODE 100) (medblkins _MEDFIT "1cap"     nil nil _SC 2) 
                 [Plug-SqH]^C^C(setq _FITTCODE 101) (medblkins _MEDFIT "1cap"     nil nil _SC 2) 
                 [Reducer ]^C^C(setq _FITTCODE 103 _TYPE T) (medblkins _MEDFIT "1re"      nil nil _SC 8) 
                 [Seal    ]^C^C(setq _FITTCODE  61) (medblkins _MEDFIT "1seal"    nil nil _SC 2) 
                 [Seal-Drn]^C^C(setq _FITTCODE  64) (medblkins _MEDFIT "1sealdr"  nil nil _SC 2) 
                 [Tee     ]^C^C(setq _FITTCODE  11) (medblkins _MEDFIT "1tee"     nil nil _SC 2) 
                 [T-down  ]^C^C(setq _FITTCODE  11) (medblkins _MEDFIT "1teed"    nil nil _SC 3) 
                 [T-up    ]^C^C(setq _FITTCODE  11) (medblkins _MEDFIT "1teeu"    nil nil _SC 3) 
                 [Union   ]^C^C(setq _FITTCODE  72) (medblkins _MEDFIT "1union"   nil nil _SC 2) 
                 [<-X     ]^C^C(setq _FITTCODE  80) (medblkins _MEDFIT "1exs"     nil nil _SC 2) 
               [ Icons ]$i=MED.MEDplanfit $i=* 
               [->Long Radius Elbows]
                 [18" RGS Long Radius Elbow  ]^C^C(attachfitting 89) 
                 [24" RGS Long Radius Elbow  ]^C^C(attachfitting 90) 
                 [<-36" RGS Long Radius Elbow]^C^C(attachfitting 91) 
               [--]
               [->Cables]
                 [#4/0 Gnd Cable ]^C^C(smlayer _MEDGRND)(setq _CABCODE 308) cable 
                 [#2/0 Gnd Cable ]^C^C(smlayer _MEDGRND)(setq _CABCODE 310) cable 
                 [<-#2 Gnd Cable   ]^C^C(smlayer _MEDGRND)(setq _CABCODE 313) cable 
               [Ground Cable Down    ]^C^C(smlayer _MEDGRND) (medblkins nil "1cond" nil nil _SC 10) 
               [Ground Cable Up      ]^C^C(smlayer _MEDGRND) (medblkins nil "1conu" nil nil _SC 11) 

***POP2DETCONDUIT
               [Detail Conduit]
               [->Set Size]
                 [Size Menu]
                 [Current Size](if _CSIZE (progn (princ (rtos _CSIZE 4))(princ))(princ)) 
                 [--]
                 [  1/2"  ]^C^C(setq _ACSIZE 0.84  _CLETT "A" _CSIZE 0.5 ) 
                 [  3/4"  ]^C^C(setq _ACSIZE 1.050 _CLETT "B" _CSIZE 0.75) 
                 [   1"   ]^C^C(setq _ACSIZE 1.315 _CLETT "C" _CSIZE 1.0 ) 
                 [ 1-1/4" ]^C^C(setq _ACSIZE 1.660 _CLETT "D" _CSIZE 1.25) 
                 [ 1-1/2" ]^C^C(setq _ACSIZE 1.9   _CLETT "E" _CSIZE 1.5 ) 
                 [   2"   ]^C^C(setq _ACSIZE 2.375 _CLETT "F" _CSIZE 2.0 ) 
                 [ 2-1/2" ]^C^C(setq _ACSIZE 2.875 _CLETT "G" _CSIZE 2.5 ) 
                 [   3"   ]^C^C(setq _ACSIZE 3.50  _CLETT "H" _CSIZE 3.0 ) 
                 [ 3-1/2" ]^C^C(setq _ACSIZE 4.0   _CLETT "I" _CSIZE 3.5 ) 
                 [   4"   ]^C^C(setq _ACSIZE 4.50  _CLETT "J" _CSIZE 4.0 ) 
                 [   5"   ]^C^C(setq _ACSIZE 5.563 _CLETT "K" _CSIZE 5.0 ) 
                 [   6"   ]^C^C(setq _ACSIZE 6.625 _CLETT "L" _CSIZE 6.0 ) 
                 [<---]
               [--]
               [Bends   ](toggle "_CONFILL" "Conduit Bend Radius") 
               [ ON/OFF ](toggle "_CONFILL" "Conduit Bend Radius") 
               [--]
               [Draw Conduit   ]^C^C(smlayer _MCON) (setq _CODE 1) 2lcon 
               [--]
               [FLEX    ]^C^C(smlayer _MCON) (setq _CODE 7) 2lflex 
               [--]
               [Add Break]^C^C2break 
               [Turn Away]^C^C2away 
               [Turn Toward]^C^C2toward 

