(defun sel_att_ent (hd_ent at_tag new_val / sent sdata oldval newval)
 (setq sent hd_ent
       smdata (entget sent)
       sdata (list (cons 2 ""))
       at_tag (strcase at_tag)
 )
 (if (dxf 66 smdata)
  (progn
   (while (and (not (equal (dxf 0 sdata) "SEQEND"))
               (not (equal (dxf 2 sdata) at_tag))
          )
     (setq sent (entnext sent)
           sdata(entget sent)
     )
   )
   (if (= (dxf 0 sdata) "SEQEND")
     (setq sent nil)
   )
   (if new_val
      (progn
         (setq oldval (assoc 1 sdata)
               newval (cons 1 new_val)
               sdata  (subst newval oldval sdata)
         )
         (entmod sdata)
         (entupd hd_ent)
      )
   )
  )
  (setq sent nil)
 )
