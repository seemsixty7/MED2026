(defun c:cd (/ ex len y1 y2 x1 x2 dirxy coor cord coord inspt rot part1
               part2 sub trl usepoint1 usepoint2)
   (setvar "cmdecho" 0)
   (setq ex nil
         len 1
         orgosmode (getvar "OSMODE")
   )
   (setvar "OSMODE" 0)
   (prompt "\nSelect coordinate line:[Press Enter to Pick two Points] ")
   (setq trl (entsel))
   (if trl
       (setq usepoint1 (osnap (cadr trl) "endp")
       	     usepoint2 (osnap (cadr trl) "midp")
       	     y1 (cadr usepoint1)
             y2 (cadr usepoint2)
             x1 (car usepoint1)
             x2 (car usepoint2)
             ex T
       )
       (progn
		   (setq usepoint1 (getpoint "\nSelect Point: "))
		   (if usepoint1
			   (progn
				   (setq orgorthomode (getvar "ORTHOMODE"))
				   (setvar "ORTHOMODE" 1)
				   (setq usepoint2 (getpoint usepoint1 "\nSelect otherpoint"))
				   (setvar "ORTHOMODE" orgorthomode)
				   (if usepoint2
					   (setq ex T)
					   (princ "\nInvalid Point")
				   )
				)
				(princ "\nInvalid Point")
			)
	  )
    )
    (if ex
    	(progn
    		(setq test1 usepoint1 test2 usepoint2)
			(setq y1 (cadr usepoint1)
				  y2 (cadr usepoint2)
				  x1 (car usepoint1)
				  x2 (car usepoint2)
			)
           (cond 
           	   ((and (< y1 0)(equal y1 y2 0.001))
           	   	   (setq dirxy "S")
           	   	   (setq coor (cadr (trans usepoint1 0 1)))
           	   )
           	   ((and (< x1 0)(equal x1 x2 0.001))
           	   	   (setq dirxy "W")
           	   	   (setq coor (car (trans usepoint1 0 1)))
               )
               ((and (>= y1 0)(equal y1 y2 0.001))
               	   (setq dirxy "N")
               	   (setq coor (cadr (trans usepoint1 0 1)))
               )
               ((and (>= x1 0)(equal x1 x2 0.001))
               	   (setq dirxy "E")
               	   (setq coor (car (trans usepoint1 0 1)))
               )
           )
        )
       
    )
    (if (< (atoi (rtos (abs coor)))  10) 
      (setq cord (strcat "00" (rtos (abs coor))))
      (progn
        (if (< (atoi (rtos (abs coor))) 100)
          (setq cord (strcat "0" (rtos (abs coor))))
          (setq cord (rtos (abs coor))
                len (- (strlen (itoa (atoi (rtos (abs coor))))) 2)
          )
        )
    )  )
    (setq sub "0")
    (while (= sub "0")
         (setq sub (substr cord (strlen cord) 1))
         (if (= sub "0")
              (setq cord (substr cord 1 (1- (strlen cord))))
         )
    )
    (if (= "." (substr cord (strlen cord) 1))
        (setq cord (substr cord 1 (1- (strlen cord))))
    )
    (if (= "-" (substr cord 1 1))
        (setq cord (substr cord 2 (strlen cord)))
    )
    (setq part1 (substr cord 1 len)
          part2 (substr cord (1+ len) (strlen cord))
          coord (strcat dirxy " " part1 "+" part2)
    )
    (smlayer _COORDS)
    (princ)
    (setq inspt (getpoint "\nStarting point of text: ")
          rot (getpoint inspt "\nRotation of text: ")
          txtstyle (assoc "T1" MED_TXT_STYLE_MAP)
    )
    (if (not (tblsearch "style" (nth 1 txtstyle)))
      (MEDMakeTextStyle txtstyle)
    )
    (command "text" "s" (nth 1 txtstyle) inspt rot coord )
    (setvar "OSMODE" orgosmode)
    (princ)
)
	
