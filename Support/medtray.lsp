(defun xdrtray (xdrelent1 xdmainent / handmdata handr1data
;                xdrelent1 rent1data 
;                 rxdadd mentdata mxdadd
                )
   (setq handr1data (dxf 5 (entget xdrelent1)))
   (setq mentdata (entget xdmainent (list "MED_*"))
         mxdadd   (list '(1002 . "}"))
   )
   (if _VERTICALTRAY
      (setq mxdadd(cons (cons 1000 "VERTICAL") mxdadd))
   )
   (setq mxdadd   (cons (cons 1000 handr1data) mxdadd)
         mxdadd   (cons '(1002 . "{") mxdadd)
         mxdadd   (cons _DOUBLE  mxdadd)
         mxdadd   (cons -3 (cons mxdadd (cdr (assoc -3 mentdata))))
         mentdata (subst mxdadd (assoc -3 mentdata) mentdata)
   )
   (if _RESETVTRAY
      (setq _VERTICALTRAY nil
            _RESETVTRAY   nil
      )
   )
   (entmod mentdata) 
)

(defun maketray (traylist closeflag layerset / clay vtxt sqend vtxt vert vertxt)
  (setq plin '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (67 . 0)))
  (setq clay (getvar "CLAYER"))
  (if (not layerset)
     (setq bldlayer (nth 0 _MEDTRAY)
           layerset _MEDTRAY
     )
     (setq bldlayer (nth 0 layerset))
  )
  (if (not (tblsearch "layer" bldlayer))
    (progn
       (smlayer layerset)
       (setvar "CLAYER" clay)
    )
  )
  (setq plin (append plin (list (cons 8 bldlayer))))
  (setq plin (append plin (list (cons 100 "AcDbPolyline") (cons 67 0))))
  (setq ptlistlen (length traylist)
        plin (append plin (list (cons 90 ptlistlen)))
  )
  (if closeflag
     (setq plin  (append plin (list (cons 70 1))))
  )
  (setq plin (append plin (list (cons 43 0.0) (cons 38 (getvar "ELEVATION")) (cons 39 0.0))))

  (foreach vertxt traylist
     (setq vert (cons 10 (nth 0 vertxt))
           ver1 (cons 40 0.0)
           ver2 (cons 41 0.0)
     )
     (if (nth 1 vertxt)
         (setq ver3 (cons 42 (nth 1 vertxt)))
         (setq ver3 (cons 42 0.0))
     )
     (setq plin (append plin (list vert ver1 ver2 ver3)))
  )
  (if _ZFLAG
    (setq twoten (cons 210 (list 0.0 -1.0 0.0))
          plin (append plin (list twoten))
    )
  )
  (entmake plin)
)   


(defun tray_brk_rot (br_pt br_bldata)

  (setq br_data   (entget (car (nentselp "\n" br_pt)))
        br_d1     (nth 0 br_bldata)
        br_d2     (nth 1 br_bldata)
        br_d3     (nth 2 br_bldata)
        br_d4     (nth 3 br_bldata)
        rt_spec   (nth 4 br_bldata)
        br_list   (list br_d1 br_d2 br_d3 br_d4)
        bl_sz     4.5
        pckbx     (getvar "PICKBOX")
  )
  (setvar "PICKBOX" 0)
  (if (= _USERROT 1)
     (setq rt_spec 4)
  )
  (cond 
       ((not rt_spec)
          (setq br_ang 0.0)
          (med_brk_rot br_ang br_pt br_list)

       )
       ((= rt_spec 0)
          (setq br_pt2 (osnap br_pt "MID"))
          (if (or (equal (dxf 10 br_data) br_pt)
                  (equal (osnap (polar br_pt2 (angle (dxf 10 br_data) br_pt2)
                                              0.125)
                                              "END") br_pt)
              )
              (progn 
                (setq br_ang (angle br_pt br_pt2))
              )
              (progn
                (if (not _TANG)
                   (progn
                      (setq br_pt2 (osnap (cadr (entsel "\nSelect point on line for rotation: ")) "NEA"))
                      (if (not br_pt2)
                        (setq br_pt2 (osnap br_pt "MID"))
                      )
                      (setq br_ang (angle br_pt br_pt2))
                   )
                )
              )
          )
          (if _TANG
            (med_brk_out _TANG br_pt br_list T)
            (med_brk_out br_ang br_pt br_list T)
          )
       )
       ((= rt_spec 1)
          (setq br_pt2 (osnap br_pt "MID")
                br_ang (angle br_pt br_pt2)
          )
          (med_brk_out br_ang br_pt br_list T)
       )
       ((= rt_spec 22)
          (setq br_pt2 (osnap br_pt "MID")
                tmp_ang(angle br_pt br_pt2)
                br_pt3 (polar br_pt (+ (* 0.5 PI) tmp_ang) bl_sz)
                br_pt4 (polar br_pt (+ (* 1.5 PI) tmp_ang) bl_sz)
          )
          (if (nentselp "\n" br_pt3)
              (setq br_ang tmp_ang)
              (setq br_ang (angle br_pt br_pt4))
          )
          (med_brk_out br_ang br_pt br_list T)
       )   
       ((= rt_spec 24)
          (setq br_pt2 (osnap br_pt "MID")
                tmp_ang(angle br_pt br_pt2)
                br_pt3 (polar br_pt (+ (* 0.5 PI) tmp_ang) bl_sz)
                br_pt4 (polar br_pt (+ (* 1.5 PI) tmp_ang) bl_sz)
          )
          (if (nentselp "\n" br_pt4)
            (progn
              (setq br_ang tmp_ang)
              (prompt "\nPT4")
            )
            (progn
              (setq br_ang (angle br_pt br_pt3))
              (prompt "\nPT3")
            )
          )
          (med_brk_out br_ang br_pt br_list T)
       )   
       ((= rt_spec 3)
          (setq br_pt2 (osnap br_pt "MID")
                tmp_ang(angle br_pt br_pt2)
                br_pt3 (polar br_pt (+ (* 0.5 PI) tmp_ang) bl_sz)
                br_pt4 (polar br_pt (+ (* 1.5 PI) tmp_ang) bl_sz)
          )
          (if (and (nentselp "\n" br_pt3) (nentselp "\n" br_pt4))
              (setq br_ang tmp_ang)
              (progn
                (if (nentselp "\n" br_pt3)
                    (setq br_ang (angle br_pt br_pt3))
                    (setq br_ang (angle br_pt br_pt4))
                )
              )
          )
          (med_brk_out br_ang br_pt br_list T)
       )   
       ((= rt_spec 4)
          (setq br_pt2 (osnap br_pt "MID")
                tmp_ang (angle br_pt br_pt2)
                br_ang (getangle br_pt "\nRotation: ")
                sub_ang (- tmp_ang br_ang)
          )
          (if (> sub_ang 0.0)
             (setq br_ang tmp_ang)
             (setq br_ang br_ang)
          )
          (med_brk_out br_ang br_pt br_list T)

       )

  )
  (setvar "PICKBOX" pckbx)
  br_ang
)

; this function will return one of two items pending on a value of ckpt
; if ckpt is true then dblchk will erase entities assosiated with
; a double line conduit found at the point specified by ckpt

(defun traychck ( ckpt); / dblnum dblcnt dblent dbldata dblinfo condata dblsz dbllett)
  (setq trayss  (ssget "C" ckpt ckpt)
        trsslen (sslength trayss)
        trcnt   0
        TR_MAIN (ssadd)
  )
  (while (< trcnt trsslen)
      (setq dblent  (ssname trayss trcnt)
            dbldata (xdataget dblent _DOUBLE)
            trcnt (1+ trcnt)
      )
      (if dbldata
        (progn
          (setq dbl1ent (handent (nth 1 dbldata))
                TR_MAIN (ssadd dblent TR_MAIN)
          )
          (if dbl1ent
            (progn
              (if (entget dbl1ent)
                (entdel dbl1ent)
              )
            )
          )
        )
      )
  )
)

(defun get_tray_data(tray_ss / cnt num cmsize tray_size cmpent cmlent rtsize
                              tray_code)
;;;
;;;     Variable Name  ||    Description
;;;     ---------------------------------------------------------------
;;;     tray_ss        ||    Selection set of entities at insertion point
;;;     cnt            ||    counter variable
;;;     num            ||    selection set length
;;;     cmsize         ||    size stored in base entity
;;;     tray_size      ||    size of tray_duit set to equal cmsize
;;;     cmpent         ||    compare entity name for filtering therough sset
;;;     cmlent         ||    entity name to be used as base entity
;;;     rtsize         ||    list of data to be returned to calling function
;;;     tray_code      ||    tray_duit code used in xdata

   (setq num (sslength tray_ss)
         cnt 0
         cmsize 0
         cssize 100
   )
   (while (< cnt num)
     (setq cmpent (ssname tray_ss cnt)
           tray_size(xdataget cmpent _TRAY)
     )
     (if (not tray_size)
        (progn
          (setq tray_size (xdataget cmpent _FITTING))
        )
     )
     (if tray_size
       (progn
         (setq tr_tag   (nth 1 tray_size)
	             tr_code  (nth 3 tray_size)
	             tr_size  (nth 2 tray_size)
	             tr_dpth  (nth 5 tray_size)
	             tr_flng  (nth 7 tray_size)

               
         )
         (if (> tr_size cmsize)
           (setq cmsize tr_size
                 cmlent cmpent
                 mxtag  tr_tag
                 mxcode tr_code
                 mxdpth tr_dpth
                 mxent  cmpent
           )
         )
         (if (< tr_size cssize)
           (setq cssize tr_size
                 cslent cmpent
                 mntag  tr_tag
                 mncode tr_code
                 mdpth  tr_dpth
                 mnent  cmpent
           )
         )

       )
     )
     (setq cnt (1+ cnt))
   )
   (if (/= cmsize 0)
       (setq rt_size (list cmsize mxtag mxcode mxdpth cssize mntag mncode mndpth mxent mnent tr_flng))
   )
   rt_size
)


