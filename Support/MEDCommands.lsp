(defun c:chgtag( / newsz chgapp chgss chglen allsiz taglst codlst sizlst
                    dislst msrlst altlst dptlst rtglst medtag medsiz medcod
                    medmsr meddis medalt meddpt xdlist)
  (prompt "\nSelect Entities to change TAG: ")
  (setq chgss  (ssget)
        chglen (sslength chgss)
        chgcnt 0
        allsiz(list 0.5 0.75 1.0 1.25 1.5 2.0 2.5 3.0 3.5 4.0 5.0 6.0)
;        allsiz(list 0.0 0.5 0.75 1.0 1.25 1.5 1.625 1.75 
;                    2.0 2.5 3.0 3.5 4.0 5.0 6.0 9.00 12.00
;                    18.00 24.00 30.0 36.0
;              )
        
  )
  (while (not (member newsz allsiz))
     (setq newsz (getreal "\nNew Size for Selected Entities: "))
  )
  (cond
    ((or (= chgapp "") (= chgapp "COnduit") (= chgapp nil))
       (setq chgapp _CONDUIT)
    )
    ((= chgapp "CAble")
       (setq chgapp _CABLE)
    )
    ((= chgapp "Tray")
       (setq chgapp _TRAY)
    )
    ((= chgapp "Fitting")
       (setq chgapp _FITTING)
    )
  )
  (while (< chgcnt chglen)
     (setq chgent (ssname chgss chgcnt)
           appdata(xdataget chgent chgapp)
     )
     (if appdata
       (progn
        (setq applen (eval (read (strcat "len" (substr chgapp 4))))
              numtag (/ (1- (length appdata)) applen)
              tagcnt 0
              taglst nil
              codlst nil
              sizlst nil
              dislst nil
              msrlst nil
              altlst nil
              dptlst nil
              rtglst nil
        )
        (repeat numtag
           (setq medtag (nth (+ 1 (* applen tagcnt)) appdata)
                 medsiz (nth (+ 2 (* applen tagcnt)) appdata)
                 medsiz newsz
                 medcod (nth (+ 3 (* applen tagcnt)) appdata)
           )
           (cond
             ((= chgapp _CONDUIT)
                (setq meddis (nth (+ 4 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 5 (* applen tagcnt)) appdata)
                )
             )         
             ((= chgapp _CABLE)
                (setq medrtg (nth (+ 4 (* applen tagcnt)) appdata)
                      meddis (nth (+ 5 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 6 (* applen tagcnt)) appdata)
                )
             )
             ((= chgapp _TRAY)
                (setq meddis (nth (+ 4 (* applen tagcnt)) appdata)
                      meddpt (nth (+ 5 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 6 (* applen tagcnt)) appdata)
                )
             )         
             ((= chgapp _FITTING)
                (setq medalt (nth (+ 4 (* applen tagcnt)) appdata)
                      meddpt (nth (+ 5 (* applen tagcnt)) appdata)
                )
             )
           )
           (setq taglst (append taglst (list medtag))
                 sizlst (append sizlst (list medsiz))
                 codlst (append codlst (list medcod))
                 dislst (append dislst (list meddis))
                 msrlst (append msrlst (list medmsr))
                 rtglst (append rtglst (list medrtg))
                 altlst (append altlst (list medalt))
                 dptlst (append dptlst (list meddpt))
                 tagcnt (1+ tagcnt)
           )
        )
        (cond
          ((= chgapp _CONDUIT)
              (setq xdlist (bld_conduit codlst sizlst taglst dislst msrlst))
              (xdatadd chgent xdlist)
          )         
          ((= chgapp _CABLE)
              (setq xdlist (bld_cable codlst sizlst taglst rtglst dislst msrlst))
              (xdatadd chgent xdlist)
          )
          ((= chgapp _TRAY)
              (setq xdlist (bld_tray codlst sizlst taglst dislst dptlst msrlst))
              (xdatadd chgent xdlist)
          )         
          ((= chgapp _FITTING)
              (setq xdlist (bld_fitting codlst sizlst taglst altlst dptlst))
              (xdatadd chgent xdlist)
          )         
        )
       )
     )
     (setq chgcnt (1+ chgcnt))

  )
)
(princ "Done.")
