(setvar "attdia" 1)
(setvar "cmdecho" 0)
(cond
  ((and (= _SC 1.0) (= _PLOTSCALE 25.4))
    (setvar "LUNITS" 2)
    (setvar "ltscale" 10.0)
    (command "grid" 10.0 "snap" 1.0)
  )
  ((and (< _SC 4.0) (/= _PLOTSCALE 25.4))
    (setvar "LUNITS" 2)
    (setvar "ltscale" (* 0.25 _SC ))
    (command "grid" (* _SC 0.25) "snap" (* _SC 0.25))
  )
  ((and (>= _SC 4.0) (<= _SC 384.0) (/= _SC 120) (/= _SC 240) (/= _SC 360))
    (setvar "LUNITS" 4)
    (setvar "ltscale" (* 0.25 _SC ))
    (command "grid" (* _SC 0.25) "snap" (* _SC 0.25))
  )
  ((or (= _SC 120) (= _SC 240) (= _SC 360) (> _SC 384))
    (setvar "LUNITS" 3)
    (setvar "ltscale" (* 0.25 _SC ))
    (command "grid" (* _SC 0.25) "snap" (* _SC 0.25))
  ) 
)
(setq cu  (getvar "ucsname"))
(command ".ucs" "W")
(command ".zoom" "e")
(setlim)
(if
  (= cu "")
  (command ".ucs" "W")
  (command ".ucs" "R" cu)
)
(setvar "ATTREQ" 1)
(c:loadtxt)
(command nil)


