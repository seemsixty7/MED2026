  (setvar "CMDECHO" 0)
  (setq attdi (getvar "attdia"))
  (setvar "OSMODE" 0)
  (setq p1 (getpoint "\nFrom point: ")
        p2 (getpoint p1 "\nTo point: ")
  )
  (if (<= (car p2) (car p1))
     (setq a (* -0.5 _SC))
     (setq a (* 0.5 _SC))
  )
  (setq LeaderAngle (angle p1 p2))
  
  (smlayer _MEDTEXT)
  (if (or (= LeaderAngle PI) (= LeaderAngle 0.0))
  	  (progn
  	  	  (setq p3 p2)
  	  	  (makeleader (list p1 p2) nil (list "" _LEADSYMSIZE))
  	  	  (if (< (car p1) (car p2))
  	  	  	  (setq p4 (list (+ (car p3) distance0) (cadr p3)))
  	  	  	  (setq p4 (list (+ (car p3) distance180) (cadr p3)))
  	  	  )
  	  )
  	  (progn
  	  	  (setq p3 (list (+ (car p2) a) (cadr p2)))
  	  	  (makeleader (list p1 p2 p3) nil (list "" _LEADSYMSIZE))
  	  	  (if (< (car p2) (car p3))
  	  	  	  (setq p4 (list (+ (car p3) distance0) (cadr p3)))
  	  	  	  (setq p4 (list (+ (car p3) distance180) (cadr p3)))
  	  	  )
  	  )
  )
  (setq dent (entsel "\nSelect Entity with Detail info: "))
  (if dent
    (progn
     (if (xdataget (car dent) _EQUIP)
       (setq dent (car dent))
       (progn
         (setq dentss (ssget "C" (nth 1 dent) (nth 1 dent))
               sslen  (sslength dentss)
               cnt    0
               dent   (ssname dentss cnt)
         )
         (while (not (xdataget dent _EQUIP))
             (setq cnt (1+ cnt)
               dent (ssname dentss cnt)
             )
         )
       )
     )
     (setq data (xdataget dent _EQUIP)
           dcode(nth 2 data)
           dline(med_detail dcode)
           dnum (nth 1 dline)
           dwgn (nth 2 dline)
     )
     (setq typnum (medcount _EQUIP dcode nil nil nil nil nil nil))
     (if (not typnum)
       (setq typnum "")
       (progn
         (if (= typnum 1)
               (setq typnum "")
               (setq typnum (strcat "(TYP. " (itoa typnum) ")"))
         )
       )
     )
    )
    (progn
       (setq dnum (getstring "\nDetail Number: ")
             dwgn (getstring "\nDrawing Number: ")
             typnum (getstring "\nTypical: ")
       )
       (if (/= typnum "")
          (setq typnum (strcat "(TYP. " typnum ")"))
       )
    )
  )
  (setvar "attdia" 0)
  (command "insert" detailblockname p4 (* _PLOTSCALE _SC) "" "0" dnum dwgn typnum)
  (setvar "attdia" attdi)
  (setvar "DIMTAD" dt)
  (setvar "CMDECHO" ne)
  (setvar "OSMODE" currosmode)
)
