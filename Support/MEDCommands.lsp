(defun c:isolate()
  (setq dent (entsel "\nSelect Entity with Detail info: "))
  (if dent
   (progn
    (if (xdataget (car dent) _EQUIP)
      (setq dent (car dent))
      (progn
        (setq dentss (ssget "C" (nth 1 dent) (nth 1 dent))
		    sslen  (sslength dentss)
		    cnt    0
		    dent   (ssname dentss cnt)
        )
        (while (not (xdataget dent _EQUIP))
		  (setq cnt (1+ cnt)
			dent (ssname dentss cnt)
		  )
        )
      )
    )
    (setq data (xdataget dent _EQUIP)
          dcode(nth 2 data)
    )
   )
   (progn
    (setq dcode (getint "\nCode value to be used: "))
   )
  )
  (setq isolayer (list "MED_TEMP_ISOLATE" "cyan" "continuous")
        cntval (medcount _EQUIP dcode nil nil nil nil nil nil)
  )
  (smlayer  isolayer)
  (setq num (sslength _COUNTSS)
        cnt 0
        ISO_LIST nil 
        _CURRLAY (getvar "CLAYER")
  )
  (while (< cnt num)
    (setq ent (ssname _COUNTSS cnt)
          data(entget ent)
          entlay (dxf 8 data)
          ISO_LIST (append ISO_LIST (list (list ent entlay)))
          cnt (1+ cnt)
    )
  )  
  (command "change" _COUNTSS "" "P" "LA" (nth 0 isolayer) "")
  (command "layer" "F" "*" "")
)
(defun c:unisolate()
  (foreach entgrp ISO_LIST
      (setq ent (nth 0 entgrp)
            entlay (nth 1 entgrp)
            data (entget ent)
            new (cons 8 entlay)
            old (assoc 8 data)
            data (subst new old data)
      )
      (entmod data)
  )
  (command "layer" "t" "*" "s" _CURRLAY "")
  (command "REGEN")
)

(defun c:MEDstrip()
   (prompt "\nMEDSTRIP Select Entities to strip XDATA from: ")
   (setq stripset (ssget)
         stripnum (sslength stripset)
         stripcnt 0
   )
   (while (< stripcnt stripnum)
      (setq stripent  (ssname stripset stripcnt)
            strip_apps(xd_apps stripent)
      )
      (foreach st_app strip_apps
         (xdstrip stripent st_app)
      )
      (setq stripcnt (1+ stripcnt))
   )
   (prompt "\nXdata has been removed!")
)

(defun c:chgsize( / newsz chgapp chgss chglen allsiz taglst codlst sizlst
                    dislst msrlst altlst dptlst rtglst medtag medsiz medcod
                    medmsr meddis medalt meddpt xdlist)
  (prompt "\nSelect Entities to change Size: ")
  (setq chgss  (ssget)
        chglen (sslength chgss)
        chgcnt 0
        allsiz(list 0.5 0.75 1.0 1.25 1.5 2.0 2.5 3.0 3.5 4.0 5.0 6.0)
;        allsiz(list 0.0 0.5 0.75 1.0 1.25 1.5 1.625 1.75 
;                    2.0 2.5 3.0 3.5 4.0 5.0 6.0 9.00 12.00
;                    18.00 24.00 30.0 36.0
;              )
        
  )
  (initget "COnduit Fitting")
  (setq chgapp (getkword "\nChange COnduit or Fitting <CO>: "))
  (while (not (member newsz allsiz))
     (setq newsz (getreal "\nNew Size for Selected Entities: "))
  )
  (cond
    ((or (= chgapp "") (= chgapp "COnduit") (= chgapp nil))
       (setq chgapp _CONDUIT)
    )
    ((= chgapp "CAble")
       (setq chgapp _CABLE)
    )
    ((= chgapp "Tray")
       (setq chgapp _TRAY)
    )
    ((= chgapp "Fitting")
       (setq chgapp _FITTING)
    )
  )
  (while (< chgcnt chglen)
     (setq chgent (ssname chgss chgcnt)
           appdata(xdataget chgent chgapp)
     )
     (if appdata
       (progn
        (setq applen (eval (read (strcat "len" (substr chgapp 4))))
              numtag (/ (1- (length appdata)) applen)
              tagcnt 0
              taglst nil
              codlst nil
              sizlst nil
              dislst nil
              msrlst nil
              altlst nil
              dptlst nil
              rtglst nil
        )
        (repeat numtag
           (setq medtag (nth (+ 1 (* applen tagcnt)) appdata)
                 medsiz (nth (+ 2 (* applen tagcnt)) appdata)
                 medsiz newsz
                 medcod (nth (+ 3 (* applen tagcnt)) appdata)
           )
           (cond
             ((= chgapp _CONDUIT)
                (setq meddis (nth (+ 4 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 5 (* applen tagcnt)) appdata)
                )
             )         
             ((= chgapp _CABLE)
                (setq medrtg (nth (+ 4 (* applen tagcnt)) appdata)
                      meddis (nth (+ 5 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 6 (* applen tagcnt)) appdata)
                )
             )
             ((= chgapp _TRAY)
                (setq meddis (nth (+ 4 (* applen tagcnt)) appdata)
                      meddpt (nth (+ 5 (* applen tagcnt)) appdata)
                      medmsr (nth (+ 6 (* applen tagcnt)) appdata)
                )
             )         
             ((= chgapp _FITTING)
                (setq medalt (nth (+ 4 (* applen tagcnt)) appdata)
                      meddpt (nth (+ 5 (* applen tagcnt)) appdata)
                )
             )
           )
           (setq taglst (append taglst (list medtag))
                 sizlst (append sizlst (list medsiz))
                 codlst (append codlst (list medcod))
                 dislst (append dislst (list meddis))
                 msrlst (append msrlst (list medmsr))
                 rtglst (append rtglst (list medrtg))
                 altlst (append altlst (list medalt))
                 dptlst (append dptlst (list meddpt))
                 tagcnt (1+ tagcnt)
           )
        )
        (cond
          ((= chgapp _CONDUIT)
              (setq xdlist (bld_conduit codlst sizlst taglst dislst msrlst))
              (xdatadd chgent xdlist)
          )         
          ((= chgapp _CABLE)
              (setq xdlist (bld_cable codlst sizlst taglst rtglst dislst msrlst))
              (xdatadd chgent xdlist)
          )
          ((= chgapp _TRAY)
              (setq xdlist (bld_tray codlst sizlst taglst dislst dptlst msrlst))
              (xdatadd chgent xdlist)
          )         
          ((= chgapp _FITTING)
              (setq xdlist (bld_fitting codlst sizlst taglst altlst dptlst))
              (xdatadd chgent xdlist)
          )         
        )
       )
     )
     (setq chgcnt (1+ chgcnt))

  )
)

(defun c:unj ( / ans pt1 pt2 ang blk)
 (ltback nil)
 (if (or (= _CLETT "A") (= _CLETT "B"))
  (progn
  (initget 1 "UNJ UNJC")
  (setq ans (getkword "\nType of fitting UNJ or UNJC: "))
  (if (= ans "UNJ")
    (setq blk (strcat "" "unj" _CLETT))
  )
  (if (= ans "UNJC")
    (setq blk (strcat "" "unjc" _CLETT))
  )
  (setq pt1 (getpoint "\n Insertion point: "))
  (setvar "LASTPOINT" pt1)
  (prompt "\nSelect reference entity: ")
  (setq pt2 (osnap (cadr (entsel)) "perp"))
  (setq ang (angle pt1 pt2))
  (command "insert" (strcat "" "un" _CLETT) pt1 "" "" (angtos (+ ang PI)))
  (setq pt1 (polar pt1 (+ ang 3.14159) 1.1400))
  (command "insert" blk pt1 "" "" pause)
  )
  (prompt "\n Invalid size set conduit size to 1/2 or 3/4\n")
  
 )
)

;
; C:HUBS request info from the user about the type of box desired
; and number of hubs desired
;
(defun c:hubs( / hubpt hinspt bxent bxins refang)
  (med_cur_set "c:hubs")
  (setq hubpt  (nentsel "\nSelect Jbox and location of hub: ")
        hinspt (osnap (cadr hubpt) "MID")
        bxent  (entget (car (last hubpt)))
        bxins  (dxf 10 bxent)
        refang (angle hinspt bxins)
  )
  (cond
   ((= refang (* PI 1.25))
      (progn
         (if (< (distance hinspt bxins) 6.805)
             (jbhub 2.5 "0 1 2"   "jbhub4" hinspt (* PI 1.5))
             (jbhub 3.0 "0 1 2 3" "jbhub8" hinspt (* PI 1.5))
         )
      )
   )       
   ((= refang (* PI 1.75))
      (progn
         (if (< (* _PLOTSCALE (distance hinspt bxins)) (* _PLOTSCALE 6.805))
             (jbhub 2.5 "0 1 2"   "jbhub4" hinspt (* PI 0.5))
             (jbhub 3.0 "0 1 2 3" "jbhub8" hinspt (* PI 0.5))
         )
      )
   )       
   ((= refang (* PI 1.5))
      (progn
         (if (< (* _PLOTSCALE (distance hinspt bxins)) (* _PLOTSCALE 6.805))
          (progn
           (if (/= (dxf 2 bxent) "JBOX8X4")
             (jbhub 2.5 "0 1 2"   "jbhub4" hinspt 0.0)
             (jbhub 3.0 "0 1 2 3" "jbhub8" hinspt 0.0)
           )
          )
          (progn
           (jbhub 3.0 "0 1 2 3" "jbhub8" hinspt 0.0)
          )
         )
      )
   )
   ((= refang 0.0)
      (progn
         (if (= (dxf 2 bxent) "JBOX4X4")
             (jbhub 2.5 "0 1 2"   "jbhub4" hinspt PI)
             (jbhub 3.0 "0 1 2 3" "jbhub8" hinspt PI)
         )
      )
   )

   ((equal refang 3.6025 0.005)
     (progn
       (jbhub 2.5 "0 1 2"   "jbhub4" hinspt (* PI 1.5))
     )
   )
   ((equal refang 5.8195 0.0005)
     (progn
       (jbhub 2.5 "0 1 2"   "jbhub4" hinspt (* PI 0.5))
     )
   )
  )
  (med_ret_ok)
  (princ)
)

(defun c:ddMEDlist( / index_val max_y max_x result tlist1 tlist2 fname fn)
   (med_cur_set "c:DDMEDlist")
   (setq MDL_SS (ssget (list (list -3 (list "MED*")))))
   (if MDL_SS
     (progn
       (setq MDL_CURENT 0
	     MDL_NUM (sslength MDL_SS)
	     MDL_ENTLIST (getmedlistdata (ssname MDL_SS 0))
       )
      (if (> (setq index_val (load_dialog "MED")) 0)
      (progn
         (if (new_dialog "Med_DDMEDlist" index_val)
            (progn 
                (setmdltiles)
	        (start_list "meddatalist")
                (foreach meddataitem MDL_ENTLIST
                   (add_list meddataitem)
                )
                (end_list)
	        (action_tile "selprev"    "(medlistprev)")
	        (action_tile "selnext"    "(medlistnext)")
                (action_tile "accept"    "(done_dialog 0)")
	        (action_tile "medchg"    "(done_dialog 1)")
                (setq result (start_dialog))
            )
         )
         (unload_dialog index_val)
