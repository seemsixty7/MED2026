(defun mk2lcon (mkent)
  (if (dxf -3 (entget mkent (list _CONDUIT)))
    (progn
      (if (= (dxf 0 (entget mkent)) "LWPOLYLINE")
        (progn
           (setq mklwptlist (nth 0 (bld_lw_ptlist mkent))
                 mkentpt (cdr (nth 0 mklwptlist))
                 offang (angle mkentpt (nth 1 mklwptlist))
           )
        )
        (progn
           (setq mkentpt (dxf 10 (entget (entnext mkent)))
                 offang  (angle mkentpt (dxf 10 (entget (entnext(entnext mkent)))))
           )
        )
      )
      (setq mksel   (list mkent mkentpt)
            mksz    (nth 2 (xdataget mkent _CONDUIT))
            conlett (nth 3 (getsize nil (rtos mksz 4)))
            mksz    (nth 1 (getsize nil (rtos mksz 4)))
      )

      (xdstrip mkent _DOUBLE)
      (command "offset" (* (* _PLOTSCALE mksz) 0.5) mksel
                        (polar mkentpt (+ offang (* 0.5 PI)) (* _PLOTSCALE 1.0)))
      (setq 2lent1 (entlast))
      (command mksel (polar mkentpt (- offang (* 0.5 PI)) (* _PLOTSCALE 1.0)) "")
      (setq 2lent2 (entlast))
      (chg_tray_pl_wdth 2lent1 _CONDTLPLWIDTH)
      (chg_tray_pl_wdth 2lent2 _CONDTLPLWIDTH)
      (xdr2line  2lent1 2lent2 mkent)
      (if _MEDCENLAY
        (progn
           (if (tblsearch "layer" (nth 0 _MEDCENLAY))
              (progn
                 (command "change" mkent "" "P" "LA" (nth 0 _MEDCENLAY) "")
              )
              (progn
                 (smlayer _MEDCENLAY)
                 (command "change" mkent "" "P" "LA" (nth 0 _MEDCENLAY) "")
              )
           )
        )
      )
      (if (tblsearch "layer" (nth 0 _MEDDETCON))
         (progn
            (command "change" 2lent1 2lent2 "" "P" "LA" (nth 0 _MEDDETCON) "")
         )
         (progn
            (smlayer _MEDDETCON)
            (command "change" 2lent1 2lent2 "" "P" "LA" (nth 0 _MEDDETCON) "")
         )
      )

    )
  )
  (med_ret_ok)
  (princ)
  
)
(defun dblins( dblblname ins_code / pt1 pt2 dist inspt)
  (ltback nil)
  (prompt "\nSelect lines of conduit:")
    (setq currosmode (getvar "osmode")
  	    cmdechomode (getvar "cmdecho")
  )
  (setvar "CMDECHO" 0)
  (setq pt1 (osnap (cadr (setq ent1 (entsel "\nFirst line: "))) "endpoint")
  	    pt1a (osnap pt1 "midpoint")
  )
  (setvar "lastpoint" pt1)
  (setq entdata (entget (car ent1))
        laynm (list (dxf 8 entdata) nil nil)
  )
  (smlayer laynm)

  (setq pt2 (osnap (cadr (entsel "\nSecond line:")) "perp")
        dist (abs (distance pt1 pt2))
        inspt (be pt1 pt2)
  )
  (cond
  	  ((= ins_code nil)
  	  	  (setq insang 0.0)
  	  )
  	  ((= ins_code 0)
  	  	  (setq insang (* (angle pt1 pt1a) (/ 180.0 PI)))
  	  )
  	  ((= ins_code 1)
  	  	  (setq insang (* (angle pt1a pt1) (/ 180.0 PI)))
  	  )
  )
  (setq origin-insunits (getvar "insunits"))
  (setvar "insunits" 0)
  (command "-insert" dblblname inspt dist dist insang)
  (setvar "insunits" origin-insunits)
  (setvar "osmode" currosmode)
  (setvar "cmdecho" cmdechomode)
  (princ)
)
