        bpt1 (polar pt4 (- ang2 (* PI 0.5)) (* 0.5 (* _PLOTSCALE trwidth)))
        bpt2 (polar pt4 (+ ang2 (* PI 0.5)) (* 0.5 (* _PLOTSCALE trwidth)))
	bpt3 (polar bpt1 ang2 tandist)
