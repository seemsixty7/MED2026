(defun c:boxcloud()
   (medsmlayer _REVISION)
   (if (not xseglen)
       (setq xseglen (* 0.25 (* _PLOTSCALE (getvar "dimscale")))
             xlen xseglen
       )
       (setq xlen xseglen)
   )
   (if (not yseglen)
       (setq yseglen (* 0.25 (* _PLOTSCALE (getvar "dimscale")))
             ylen yseglen
       )
       (setq ylen yseglen)
   )
      
   (setq pt1 (getpoint "\nFirst Corner of Cloud: ")
         pt3 (getcorner pt1 "\nSecond Corner of Cloud: ")
         pt2 (list (car pt3) (cadr pt1))
         pt4 (list (car pt1) (cadr pt3))
         d1  (distance pt1 pt2)
         d2  (distance pt2 pt3)
    )
    (setq xseglen (getdist pt1 (strcat "\nX Distance for Clouding <"
                                        (rtos xseglen) ">: "))
    )
    (if (not xseglen)
      (setq xseglen xlen)
    )
    (setq yseglen (getdist pt1 (strcat "\nY Distance for Clouding <"
                                        (rtos yseglen) ">: "))
    )
    (if (not yseglen)
      (setq yseglen ylen)
    )
    (setq npt (polar pt1 (angle pt1 pt2) xseglen))
    (command "pline" pt1 npt)
    (while (> d1 (abs (distance pt1 npt)))
       (setq npt (polar npt (angle pt1 pt2) xseglen))
       (command npt)
    )
    (while (> d2 (abs (distance pt2 npt)))
       (setq npt (polar npt (angle pt2 pt3) xseglen))
       (command npt)
    )
    (while (> d1 (abs (distance pt3 npt)))
       (setq npt (polar npt (angle pt3 pt4) xseglen))
       (command npt)   
    )
    (while (> (- d2 yseglen) (abs (distance pt4 npt)))
       (setq npt (polar npt (angle pt4 pt1) xseglen))
       (command npt)
    )
   (command "c")
   (setq head (entlast)
        hdata (entget head)
        newhdata nil
   )
   (if (= (dxf 70 hdata) 0)
      (setq hdata (subst (cons 70 1) (assoc 70 hdata) hdata))
   )
   (setq bulge (list (cons 42 0.5)))
   (if (= (dxf 0 hdata) "LWPOLYLINE")
     (progn
        (foreach itmcd hdata
          (if (= (car itmcd) 42)
             (setq itmcd (cons 42 0.5))
         )
          (setq newhdata (append newhdata (list itmcd)))
       )
        (entmod newhdata)
     )
     (progn
        (setq en (dxf -1 hdata))
        (while (setq en (entnext en))
          (setq ed (entget en))
          (setq ed (append ed bulge))
           (entmod ed)
        )
        (entmod hdata)
        (entupd head)
     )
   )
   (princ)
)

(princ "Done.")
