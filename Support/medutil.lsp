(defun c:lb (/ ang1 ang2 count ent num old pt1 pt2 pt3 pt4
               ss1 trl trl1 trl1data trldata)
   (med_cur_set "c:lb")
   (setvar "cmdecho" 0)
   (initget 1)
   (prompt "\nSelect entity not to be broken ")
   (setq trl (nentsel)
         trldata (entget (car trl))
   )
   (if (= (dxf 0 trldata) "VERTEX")
     (setq trl1 (entnext (car trl))
           trl1data (entget trl1)
	   pt1 (dxf 10 trldata)
	   pt2 (dxf 10 trl1data)
     )
     (setq pt2 (dxf 10 trldata)
           pt1 (dxf 11 trldata)
     )
   )
   (initget 1)
   (prompt "\nSelect entities to be broken ")
   (setq ss1 (ssget)
         num (sslength ss1)
         count 0
   )
    (if bkd
       (setq old bkd)
       (setq bkd (* _PLOTSCALE 0.04) old bkd)
    )       
    (setq bkd (getdist (strcat "\nBreak distance <" (rtos bkd 2 4) ">:")))
    (if (not bkd)
     (setq bkd old)
    )
    (while (< count num)
         (setq brent (ssname ss1 count)
	       brdata(entget brent))
         (if (= (dxf 0 brdata) "POLYLINE")
	     (pbreak brent)
	     (progn 
	       (setq pt3 (dxf 10 brdata)
                     pt4 (dxf 11 brdata)
                     ang1 (angle pt3 pt4)
                     ang2 (angle pt4 pt3)
                     brint (inters pt1 pt2 pt3 pt4)
                     br1 (polar brint ang1 bkd)
                     br2 (polar brint ang2 bkd)
                     ent (ssname ss1 count)
               )
               (command "break" ent br1 br2)
	     )
         )
	 (setq count (1+ count))
    )
    (med_ret_ok)
    (princ)	
) 

(defun pbreak (ent / ang1 ang2 cnt numb pt4 pt3 ptlist)
   (setq brent (entnext ent)
         brdata (entget brent)
   )
   (while (= (dxf 0 brdata) "VERTEX")
      (setq ptlist (append ptlist (list (dxf 10 brdata))))
      (setq brent (entnext brent)
            brdata (entget brent)
      )
   )
   (setq cnt 0
         numb (1- (length ptlist))
   )
   (while (< cnt numb)
      (setq pt3 (nth cnt ptlist)
            pt4 (nth (1+ cnt) ptlist)
	    ang1 (angle pt3 pt4)
	    ang2 (angle pt4 pt3)
	    brint (inters pt1 pt2 pt3 pt4)
      )
      (if brint
        (progn
	 (setq br1 (polar brint ang1 bkd)
	       br2 (polar brint ang2 bkd)
	 )
	 (command "break" ent br1 br2)
	 (setq ent (entlast))
	)
      )
      (setq cnt (1+ cnt))
   )
   (setq ptlist nil
         brint nil
   )
)
(defun entlist ()
    (setq ename (ssname ss1 count)
          edata (entget ename)
    )
)
(defun c:fl ( / ss1 edata ename count num lname coff)
    (prompt "\nSelect entities upon layers to be frozen: ")
    (setvar "cmdecho" 0)
    (setq flss (ssget)
          num  (sslength flss)
	  count 0
    )
    (while (< count num)
         (setq ename (ssname flss count)
	       edata (entget ename)
	 )
         (set (read (strcat "lname" (itoa count))) (cdr (assoc 8 edata)))
         (setq count (1+ count))
    )
    (setq count 0)
    (command "layer")
    (while (< count num)
         (setq lname (eval (read (strcat "lname" (itoa count)))))
         (if (/= lname (getvar "CLAYER"))
              (command "f" lname)
              (setq coff (strcat "Did not turn off curent layer " lname))
         )
         (setq count (1+ count))
    )
    (command "")
    (if coff
         (progn
              (princ)
              (prompt coff)
              (princ)
    )    )
(princ)
)


(defun c:lisp( / rout)
   (setq rout (getstring "\nName of lisp file to load: "))
   (if (findfile (strcat rout ".lsp"))
       (load rout)
       (progn (terpri) (prompt "File name not found."))
   )
)




