(defun c:cl( / clss cllen clcnt clnew clent cldata cllay nwlay)
   (med_cur_set "C:CL")
   (prompt "\nSelect entities to be changed to selected layer: ")
   (setq clss (ssget)
         cllen(sslength clss)
         clcnt 0
   )
   (while (not (setq clnew (entsel "\nSelect Entity of desired layer: "))))
   (setq clnew (car clnew)
         clnew (dxf 8 (entget clnew))
   
   )
   (while (< clcnt cllen)
     (setq clent (ssname clss clcnt)
           cldata(entget clent)
           cllay (assoc 8 cldata)
           nwlay (cons 8 clnew)
           cldata(subst nwlay cllay cldata)
           clcnt (1+ clcnt)
     )
     (entmod cldata)
   )
   (prompt (strcat "\nEntities have been move to the " clnew " layer."))
   (med_ret_ok)
   (princ)
)

(defun c:em( / emss1 emss2 emlen emcnt empt )
  (prompt "\nSelect Boundries to extend to:")     
  (setq emss1 (ssget))
  (prompt "Select entities to be extended: ")
  (setq emss2 (ssget)
        emlen (sslength emss2)
        emcnt 0
        empt  (getpoint "\nSelect point to base extension: ")
  )
  (command "extend" emss1 "")
  (while (< emcnt emlen)
    (setq ement (ssname emss2 emcnt)
          ement (list ement empt)
          emcnt (1+ emcnt)
    )
    (command ement)
  )
  (command "")
  (princ)
)
(defun c:lt( / ltss ltnew ltnewlay ltlaydata ltewen)
   (med_cur_set "C:LT")
   (prompt "\nSelect entities to be changed to selected entity's linetype: ")
   (setq ltss (ssget))
   (while (not (setq ltnewen (entsel "\nSelect Entity of desired linetype: "))))
   (setq ltnewen (car ltnewen)
         ltnew   (dxf 6 (entget ltnewen))
   )
   (if (not ltnew)
     (progn
       (setq ltnewlay (dxf 8 (entget ltnewen))
             ltlaydata(tblsearch "LAYER" ltnewlay)
             ltnew (dxf 6 ltlaydata)
       )
       (setq ltans (getstring "\nSet linetypes to bylayer Yes/<No>:"))
       (if (not (or (= ltans "") (not (= (strcase ltans) "Y"))))
          (setq ltnew "Bylayer")
       )
     )
   )
   (command "change" ltss "" "P" "lt" ltnew "")
   (prompt (strcat "\nEntities have been changed to the " ltnew " linetype."))
   (med_ret_ok)
   (princ)
)

(defun c:plmake()
   (prompt "\nSelect lines to be changed to polylines: ")
   (setq ss1 (ssget)
         count 0
         num (sslength ss1)
   )
   (while (< count num)
          (setq en (ssname ss1 count)
                endt (entget en))
          (if (= (dxf 0 endt) "LINE")
                (command "pedit" en "y" "")
          )
          (setq count (1+ count))
    )
    (prompt "\nAll lines converted.")
    (princ)
)
