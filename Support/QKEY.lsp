(defun c:off2con( / mdata xdlist offent offpt)
   (if offdist
      (setq oldoffdist offdist)
      (setq oldoffdist 5.0)
   )
   (setq offent (entsel "\nSelect Entity to Offset to Conduit: "))
   (if offent
     (progn
       (setq offdist (getdist (strcat "\nDistance of offset<" (rtos oldoffdist 2 4) ">: ")))
       (if (not offdist)
	 (setq offdist oldoffdist)
       )
       (setq offpt (getpoint "\nOffset point: "))  
       (if offpt  
	 (progn  
	  (command "offset" offdist offent offpt "")  
	  (setq ment (entlast))  
	  (setq mdata (entget ment)  
		mpt  (dxf 10 mdata)  
	  )  
	  (if (/= (dxf 0 mdata) "POLYLINE")  
	    (progn  
	      (command "pedit" (list ment mpt) "y" "")  
	      (setq ment (entlast))  
	    )  
	  )  
	  (if (not (tblsearch "LAYER" (nth 0 _MCON)))  
	    (progn  
	     (setq currlay (getvar "celayer"))  
	     (smlayer _MCON)  
	     (setvar "CELAYER" currlay)  
	    )  
	  )  
	  (command "change" ment "" "p" "la" (nth 0 _MCON) "")  
	  (setq mdata(entget ment))  
	       (setq xdlist (bld_conduit _CODE _CSIZE "NONE" nil nil))  
	  (xdatadd ment xdlist)  
	 )  
       )  
     )
   )
)



