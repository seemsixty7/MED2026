(defun c:bldstl( / _stylenms stdata curcmdlst curalilst fname fn)
   (setq _stylenms (list (dxf 2 (tblnext "style" T))))
   (while (setq stdata (tblnext "style"))
     (setq _stylenms (append _stylenms (list (dxf 2 stdata))))
   )
   (setq curcmdlst (atoms-family 1)
         curalilst (getalias)
   )
   (setq fname (strcat (getvar "MYDOCUMENTSPREFIX") "\\MEDlsp.tmp"))
   (setq fn (open fname "w"))
   (write-line ";Moore Design Temporary lisp file for style command creation" fn)
   (close fn)
   (setq fn (open fname "a"))
   (foreach sty _stylenms
     (if (not (or (member (strcat "C:" sty) curcmdlst)
                  (member sty curalilst)
                  (> (length (mparse sty " " nil nil)) 1)
         )    )
       (progn
         (write-line (strcat "(defun c:" sty "()") fn)
         (write-line "(smlayer _MEDTEXT)" fn)
         (write-line (strcat "(command \"dtext\" \"s\" \"" sty "\")") fn)
         (write-line ")" fn)
       )
     )
   )
   (close fn)
   (load (strcat (getvar "MYDOCUMENTSPREFIX") "\\MEDlsp.tmp"))
)

(defun getalias (/ al_err al_oe s al_oce aliasi lineno first line lfile)

  (setq fname  (findfile "acad.pgp")
        aliasi (open fname "r")
        aliaslist nil
  )

  (if aliasi
    (progn
      (setq lineno 0
            first T
      )
      (while (setq line (read-line aliasi))
        ;; Check each line for leading semi-colon
        (if (and (/= (substr line 1 1) ";")     ; Leading semi-colon?
                 (/= (substr line 1 1) "")      ; Blank line?
                 (/= (substr line 1 1) "\n"))   ; Carriage return?
         (progn 
          (setq j      0
                al_str "" 
                c_str  ""
          )
          (while (/= (setq tmpstr (substr line (setq j (1+ j)) 1)) ",")
            (if (/= tmpstr " ")
              (setq al_str (strcat al_str tmpstr))
            )
          )
          (while (and (/= (setq tmpstr (substr line (setq j (1+ j)) 1)) "")
                      (/= tmpstr ";") 
                      (/= tmpstr ",")
                      (/= tmpstr "\n")
                 )
            (if (and (/= tmpstr " ") (/= tmpstr "*") (/= tmpstr "\t"))
              (setq c_str (strcat c_str tmpstr))
            )

          )
          (setq aliaslist (append aliaslist (list al_str)))
         )
        )
      )
    )
    ;; else
    (progn
      (princ "\nCouldn't find or read the file \"acad.pgp\". ")
    )
  )
  (setq aliasi (close aliasi))
  aliaslist
)

(defun linemake ( linept1 linept2 linelay / )
  (if (not linelay)
    (setq linelay (getvar "CLAYER"))
  )
  (setq linedat(list (cons 0 "LINE")
                     (cons 10 linept1) 
                     (cons 11 linept2)
                     (cons 8 linelay)
               )
  )
  (entmake linedat)
)   

(defun c:il()
  (setq ent (entsel "\nSelect Entity to Isolate Layer: "))
  (if ent
    (progn
      (setq ent (car ent)
            data(entget ent)
            laynam (dxf 8 data)
            _LAYLIST nil
      )
      (setq lay (tblnext "LAYER" T))
      (while lay
        (setq lnm (dxf 2 lay))
        (if (> (dxf 62 lay) 0)
           (setq _LAYLIST (append _LAYLIST (list lnm)))
        )
        (setq lay (tblnext "LAYER"))
      )
      (smlayer (list laynam nil nil))
      (command "layer" "off" "*" "" "")
    )
  )

)
(defun c:uil()
  (if _LAYLIST
     (progn
       (foreach lay _LAYLIST
          (command "layer" "on" lay "")
       )
     )
  )
  (setq _LAYLIST nil)
)

(defun c:blkreins()
  (if _BLKREINS
      (setq blknm _BLKREINS
	    _BLKREINS nil
      )
      (setq blknm (getstring "\nBlock Name to re-insert: "))
  )
  (setq cmdstat (getvar "cmdecho"))
  (setvar "cmdecho" 0)
  (if blknm
     (progn
        (setq blkss (ssget "x" (list (cons 0 "INSERT")
                                     (cons 2 blknm)
                               )     
                    )
        )
     )
  )
  (if blkss
   (progn
    (setq blklen (sslength blkss)
          blkcnt 0
    )
    (command "insert" (strcat blknm "=") nil)
    (while (< blkcnt blklen)
      (setq blkent (ssname blkss blkcnt)
            blkdata(entget blkent (list "*"))
            blk_hd blkent
            blkins (dxf 10 blkdata)
            blklay (dxf 8  blkdata)
            blkrot (dxf 50 blkdata)
            blksc  (dxf 41 blkdata)
            blkatts nil
            blkxdata (assoc -3 blkdata)
            blkcnt (1+ blkcnt)
      )
      (if (= (dxf 66 blkdata) 1)
         (progn
          (while (/= (dxf 0 blkdata) "SEQEND")
            (setq blkent (entnext blkent)
                  blkdata(entget blkent)
            )
            (setq attval (list (dxf 2 blkdata) (dxf 1 blkdata)
                               (dxf 50 blkdata) (dxf 10 blkdata)
                         )
                  blkatts (append blkatts (list attval))
            )
          )
         )
      )
      (command "layer" "t" blklay "s" blklay "")
      (setq oldreq (getvar "attreq"))
      (setvar "attreq" 0)
      (entdel blk_hd)
      (if _BLKOFFSET
        (setq blkins (polar blkins 0.0 (nth 0 _BLKOFFSET))
              blkins (polar blkins (* PI 0.5) (nth 1 _BLKOFFSET))
        )
      )
      (command "insert" blknm blkins blksc "" (angtos blkrot))
      (setq newblk (entlast)
            newent newblk
            newdata(entget newblk)
            newatts nil
      )
      (if blkxdata
        (setq newdata(append newdata (list blkxdata)))
      )
      (entmod newdata)
      (if (= (dxf 66 newdata) 1)
         (progn
          (while (/= (dxf 0 newdata) "SEQEND")
            (setq newent (entnext newent)
                  newdata(entget newent)
            )
            (setq atttag (dxf 2 newdata))
            (if (setq attitem (assoc atttag blkatts))
               (progn
                 (setq oldval (assoc 1 newdata)
                       newval (cons 1 (nth 1 attitem))
                       newdata(subst newval oldval newdata)
                      ; oldval (assoc 10 newdata)
                      ; newval (cons 10 (nth 3 attitem))
                      ; newdata(subst newval oldval newdata)
                       oldval (assoc 50 newdata)
                       newval (cons 50 (nth 2 attitem))
                       newdata(subst newval oldval newdata)
                 )
                 (entmod newdata)
               )
            )
          )
         )
      )
      (entupd newblk)
    )
   )
  )
  (setvar "attreq" oldreq)
  (setvar "cmdecho" cmdstat)
)

(defun c:linkprefix()
	(setq PrefixEnt (nentsel "\nSelect Prefix Text Entity: "))
	(if PrefixEnt
		(progn
			(prompt "\nSelect Text Entities to Prefix (Chars replaced will match the prefix selected):")
			(setq PrefixData (entget (car prefixent))
				  PrefixOID (vla-get-objectid (vlax-ename->vla-object (dxf -1 prefixdata)))
				  prefixvalue (strcat "%<\\AcObjProp Object(%<\\_ObjId " (itoa PrefixOID) ">%).TextString \\f \"%tc1\">%")
				  prefixtext (dxf 1 prefixdata)
				  prefixlength (strlen prefixtext)
				  textss (ssget)
			)
			(if textss
				(progn
					(setq cnt 0
						  textsslen (sslength textss)
					)
					(while (< cnt textsslen)
						(setq textdata (entget (ssname textss cnt))
							  cnt (1+ cnt)
						)
						(if (= (dxf 0 textdata) "TEXT")
							(progn
								(setq txtvalue (dxf 1 textdata))
								(if (> (strlen txtvalue) prefixlength)
									(setq newvalue (strcat prefixvalue (substr txtvalue (+ prefixlength 1))))
									(setq newvalue (strcat prefixvalue txtvalue))
								)
								(setq newentdata (subst (cons 1 newvalue) (assoc 1 textdata) textdata))
								(entmod newentdata)
							)
						)
					)
				)
			)
		)
	)
	(princ prefixvalue)
	(princ)
)

