(defun MEDDraw3DTrayTeeCrossFit (TrayDataList TrayCenterLine /
		  TrayPoint1 TrayPoint2 TrayPoint3 TrayPoint4 TrayPoint5 TrayPoint6 TrayPoint7 TrayWidth TrayDepth TrayFlange) ; List includes StartPoint EndPoint Width Depth Flange
	(setq Traypoints (bld_lw_ptlist TrayCenterLine)
		  TrayCenterLineData (entget TrayCenterLine)
		  TrayPoint38 (dxf 38 TrayCenterLineData)
		  TrayPoint1 (trans (append (cdr (nth 0 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1) 
		  TrayPoint2 (trans (append (cdr (nth 1 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint3 (trans (append (cdr (nth 2 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint4 (trans (append (cdr (nth 3 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint5 (trans (append (cdr (nth 4 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint6 (trans (append (cdr (nth 5 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint7 (trans (append (cdr (nth 6 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayWidth  (nth 2 TrayDataList)
		  TrayDepth  (nth 3 TrayDataList)
		  TrayFlange (nth 4 TrayDataList)
		  TrayDataList (list TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange)
		  ;TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBaseEnt (MEDBuild3DTrayBaseFromOutline TrayCenterLine)
		  TrayElevation (setvar "ELEVATION" TrayPoint38)
		  TempTrayCenter (MEDmaketray (list (list TrayPoint1 nil) (list TrayPoint2 (cdr (nth 1 (cadr Traypoints)))) (list TrayPoint3 nil) (list TrayPoint4 nil)) nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayFlangeEnt1 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TempTrayCenter (not (vtrayxdataget TrayCenterline)))
		  TempTrayCenter (entdel TempTrayCenter)
		  TrayDataList (list TrayPoint4 TrayPoint5 TrayWidth TrayDepth TrayFlange)
		  TrayElevation (setvar "ELEVATION" TrayPoint38)
		  TempTrayCenter (MEDmaketray (list (list TrayPoint4 nil) (list TrayPoint5 (cdr (nth 4 (cadr Traypoints)))) (list TrayPoint6 nil) (list TrayPoint7 nil)) nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayFlangeEnt2 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TempTrayCenter (not (vtrayxdataget TrayCenterline)))
		  TempTrayCenter (entdel TempTrayCenter)
    )
    (if (= (length (car TrayPoints)) 7)
    	(progn
    		(setq TrayDataList (list TrayPoint7 TrayPoint1 TrayWidth TrayDepth TrayFlange)
    			  TrayFlangeEnt3 (MEDBuild3DTrayFlange TrayDataList 1.0 (dxf 210 TRayCenterLineData))
    		)
    		(command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 TrayFlangeEnt3 "")
    	)
    	(progn
    		(setq TrayPoint8 (trans (append (cdr (nth 7 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
    			  TrayPoint9 (trans (append (cdr (nth 8 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
    			  TrayPoint10 (trans (append (cdr (nth 9 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
    			  TrayDataList (list TrayPoint7 TrayPoint8 TrayWidth TrayDepth TrayFlange)
    			  TrayElevation (setvar "ELEVATION" TrayPoint38)
    			  TempTrayCenter (maketray (list (list TrayPoint7 nil) (list TrayPoint8 (cdr (nth 4 (cadr Traypoints)))) (list TrayPoint9 nil) (list TrayPoint10 nil)) nil nil)
    			  TempTrayCenter (entlast)
    			  TrayFlangeEnt3 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TempTrayCenter (not (vtrayxdataget TrayCenterline)))
    			  TempTrayCenter (entdel TempTrayCenter)
    			  TrayDataList (list TrayPoint10 TrayPoint9 TrayWidth TrayDepth TrayFlange)
    			  TrayElevation (setvar "ELEVATION" TrayPoint38)
    			  TempTrayCenter (maketray (list (list TrayPoint10 nil) (list TrayPoint9 (cdr (nth 1 (cadr Traypoints)))) (list TrayPoint2 nil) (list TrayPoint1 nil)) nil nil)
    			  TempTrayCenter (entlast)
    			  TrayFlangeEnt4 (MEDBuild3DTrayFitFlange TrayDataList 1.0 TempTrayCenter (not (vtrayxdataget TrayCenterline)))
    			  TempTrayCenter (entdel TempTrayCenter)
    		)
    		(command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 TrayFlangeEnt3 TrayFlangeEnt4 "")
    	)
    		
    )
)    	 
    
(defun MEDBuild3DTrayBaseFromOutline (TrayCenterline)
	(setq TrayFittingData (xdataget TrayCenterLine _FITTING))
	(mtrayfit TrayCenterLine TrayFittingData T)
	(setq TrayFittingOutlineEnt (entlast))
	(command "Extrude" "l" "" MED_TRAY_MATERIALWIDTH)
    (setq TrayReturnEntity (entlast))
)

(defun c:trayteetest()
	(MEDConvertTrayTeeTo3d (car (entsel)))
)
(defun MEDConvertTrayTeeTo3D(TrayEntity)
	(setq TrayEntityData (entget TrayEntity)
		  TrayMEDData (xdataget TrayEntity _FITTING)
	)
	(if (equal (dxf 210 TrayEntityData) (list 0.0 0.0 1.0))
		(command "UCS" "")
		(command "ucs" "OB" trayentity)
	)
	(MEDDraw3DTrayTeeCrossFit (list nil
			             nil
			             (nth 2 TrayMEDData) ; Width
			             (nth 5 TrayMEDData) ; Depth
			             (nth 6 TrayMEDData) ; FlangeSize
			       )
		           TrayEntity
	)
)

(defun MEDBuild3DTrayFlangeFromEntity (MB3DTF_TrayData MB3DTF_FlipValue MB3DTF_Entity / TrayPoint1 TrayPoint2 TrayAngle) ;Flip value is 1.0 normal opposite is -1
	(setq TrayPoint1 (nth 0 MB3DTF_TrayData)
		  TrayPoint2 (nth 1 MB3DTF_TrayData)
		  TrayWidth  (nth 2 MB3DTF_TrayData)
		  TrayDepth  (nth 3 MB3DTF_TrayData)
		  TrayFlange (nth 4 MB3DTF_TrayData)
		  TrayLength (distance TrayPoint1 TrayPoint2)
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  TrayBasePoint1 (polar TrayPoint1 (+ TrayAngle (* MB3DTF_FlipValue PI 0.5)) (* TrayWidth 0.5))
;		  TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) (* TrayFlange 0.5))
;		  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ MED_TRAY_MATERIALWIDTH (nth 2 TrayFlangePoint1)))
;		  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (- (* TrayFlange 0.5) MED_TRAY_MATERIALWIDTH))
;		  TrayFlangePoint4 (list (nth 0 TrayFlangePoint3) (nth 1 TrayFlangePoint3) (+ (- TrayDepth (* 2.0 MED_TRAY_MATERIALWIDTH)) (nth 2 TrayFlangePoint3)))
;		  TrayFlangePoint5 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ (- TrayDepth MED_TRAY_MATERIALWIDTH) (nth 2 TrayFlangePoint1)))
;		  TrayFlangePoint6 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
;		  TrayFlangePoint7 (polar TrayFlangePoint6 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (* TrayFlange 0.5))
;     )
;     (command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 TrayFlangePoint4 TrayFlangePoint5 TrayFlangePoint6 TrayFlangePoint7 "C")
;     (command "Extrude" "l" "" "Path" MB3DTF_Entity)
;     (setq TrayReturnEntity (entlast))
	)
	(if (< (abs TrayFlange) (* 2.0 MED_TRAY_MATERIALWIDTH))
		(progn
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) MED_TRAY_MATERIALWIDTH)
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) MED_TRAY_MATERIALWIDTH)
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 "C")
		)
		(progn
			(if (< TrayFlange 0.0)
				(setq FlangeFLIP T)
				(setq FlangeFLIP nil)
			)
			(setq t1 MB3Dtf_TrayData t2 Traybasepoint1 t3 Traybasepoint2)
			(setq TrayFlangePoint1 (polar TrayBasePoint1 (+ TrayAngle (*  MB3DTF_FlipValue PI 0.5)) (* TrayFlange 0.5))
				  TrayFlangePoint2 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ MED_TRAY_MATERIALWIDTH (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint3 (polar TrayFlangePoint2 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (- (* TrayFlange 0.5) (if FlangeFlip (* -1 MED_TRAY_MATERIALWIDTH) MED_TRAY_MATERIALWIDTH)))
				  TrayFlangePoint4 (list (nth 0 TrayFlangePoint3) (nth 1 TrayFlangePoint3) (+ (- TrayDepth (* 2.0 MED_TRAY_MATERIALWIDTH)) (nth 2 TrayFlangePoint3)))
				  TrayFlangePoint5 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ (- TrayDepth MED_TRAY_MATERIALWIDTH) (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint6 (list (nth 0 TrayFlangePoint1) (nth 1 TrayFlangePoint1) (+ TrayDepth (nth 2 TrayFlangePoint1)))
				  TrayFlangePoint7 (polar TrayFlangePoint6 (+ TrayAngle (* PI  MB3DTF_FlipValue -0.5)) (* TrayFlange 0.5))
			)
			(command "3DPOLY" TrayBasePoint1 TrayFlangePoint1 TrayFlangePoint2 TrayFlangePoint3 TrayFlangePoint4 TrayFlangePoint5 TrayFlangePoint6 TrayFlangePoint7 "C")
		)
     )
     ;(command "Extrude" "l" "" "Dir" TrayBasePoint1 (polar TrayBasePoint1 Trayangle TrayLength))
     (command "Extrude" "l" "" "Path" MB3DTF_Entity)
     (setq TrayReturnEntity (entlast))
)

(defun MEDDraw3DTrayStraightReducer (TrayDataList TrayCenterLine /
		  TrayPoint1 TrayPoint2 TrayPoint3 TrayPoint4 TrayWidth TrayDepth TrayFlange TrayAngle) ; List includes StartPoint EndPoint Width Depth Flange
	(setq Traypoints (bld_lw_ptlist TrayCenterLine)
		  TrayReducerData (entget TrayCenterLine)
		  TrayPoint38 (dxf 38 TrayReducerData)
		  TrayPoint1 (trans (append (cdr (nth 0 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  t1 TrayPoint1
		  TrayPoint2 (trans (append (cdr (nth 1 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  t2 TrayPoint2
		  t3 Trayreducerdata
		  TrayWidth  (nth 2 TrayDataList)
		  TrayDepth  (nth 3 TrayDataList)
		  TrayFlange (nth 4 TrayDataList)
		  TrayAltWidth (nth 4 (xdataget TrayCenterLine _FITTING))
		  TrayAngle  (angle TrayPoint1 TrayPoint2)
		  tandist 7.0
	      apt1 (polar TrayPoint1 (- TrayAngle (* PI 0.5)) (* 0.5 (* _PLOTSCALE TrayWidth)))
	      apt2 (polar TrayPoint2 (+ TrayAngle (* PI 0.5)) (* 0.5 (* _PLOTSCALE TrayWidth)))
	      apt3 (polar apt1 TrayAngle (* _PLOTSCALE tandist))
	      apt4 (polar apt2 TrayAngle (* _PLOTSCALE tandist))
	      bpt1 (polar TrayPoint2 (+ TrayAngle (* PI 0.5)) (* 0.5 (* _PLOTSCALE TrayAltWidth)))
	      bpt2 (polar TrayPoint2 (- TrayAngle (* PI 0.5)) (* 0.5 (* _PLOTSCALE TrayAltWidth)))
	      bpt3 (polar bpt1 (+ PI TrayAngle) (* _PLOTSCALE tandist))
	      bpt4 (polar bpt2 (+ PI TrayAngle) (* _PLOTSCALE tandist))
		  TrayDataList (list TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange)
		  TrayBaseEnt (MEDBuild3DTrayBaseFromOutline TrayCenterLine)
		  mlist (list (list apt2 nil) (list apt4 nil) (list bpt3 nil) (list bpt1 nil))   
		  TempTrayCenter (MEDmaketray mlist nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayFlangeEnt1 (MEDBuild3DTrayFlangeFromEntity TrayDataList 1.0 TempTrayCenter)
		  mlist (list (list apt1 nil) (list apt3 nil) (list bpt4 nil) (list bpt2 nil))   
		  TempTrayCenter (MEDmaketray mlist nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayFlangeEnt2 (MEDBuild3DTrayFlangeFromEntity TrayDataList -1.0 TempTrayCenter)
    )
    (command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 "")
)

(defun MEDDraw3DTrayLeftOrRightReducer (TrayDataList TrayCenterLine /
		  TrayPoint1 TrayPoint2 TrayPoint3 TrayPoint4 TrayWidth TrayDepth TrayFlange TrayAngle) ; List includes StartPoint EndPoint Width Depth Flange
	(setq Traypoints (bld_lw_ptlist TrayCenterLine)
		  TrayReducerData (entget TrayCenterLine)
		  TrayPoint38 (dxf 38 TrayReducerData)
		  TrayPoint1 (trans (append (cdr (nth 0 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  TrayPoint2 (trans (append (cdr (nth 1 (car TrayPoints))) (list traypoint38)) TrayCenterLine 1)
		  t1 TrayPoint1
		  t2 TrayPoint2
		  TrayWidth  (nth 2 TrayDataList)
		  TrayDepth  (nth 3 TrayDataList)
		  TrayFlange (nth 4 TrayDataList)
		  TrayReducerData (xdataget TrayCenterLine _FITTING)
		  TrayAltWidth (nth 4 TrayReducerData)
		  ReducerData (med_getdesc "FITTING" (nth 3 TrayReducerData)) 
	)
	(if (= (strcase (substr ReducerData 1 1)) "L")
		(setq DirectionFactor 1)
		(setq DirectionFactor -1)
	)
	(setq TrueAngle  (angle TrayPoint2 TrayPoint1)
		  tandist 7.0
		  ReducerLength (distance TrayPoint1 TrayPoint2)
		  StockReducerLength 18.0
		  HalfAlt (* (- TrayWidth TrayAltWidth 0.5))
		  HalfSize2 (* TrayAltWidth 0.5)
		  SinOfAngle (/ ReducerLength StockReducerLength)
		  CosOfAngle (/ halfAlt StockReducerLength)
		  AngleOfFittingLine (* DirectionFactor (atan (/ SinOfAngle CosOfAngle)))
		  TrayAngle (+ TrueAngle AngleOfFittingLine)
		  OtherPoint2 (polar TrayPoint2 TrayAngle HalfAlt)
		  Trayangle (angle TrayPoint1 OtherPoint2)
		  OtherPoint2 (polar TrayPoint1 TrayAngle StockReducerLength)
	      apt1 (polar TrayPoint2 (+ TrayAngle (* DirectionFactor (* PI 0.5))) (* _PLOTSCALE HalfSize2))
	      apt2 (polar apt1 (+ TrayAngle PI) (* StockReducerLength _PLOTSCALE)) 
	      apt3 (polar  apt2 (- Trayangle (* DirectionFactor (* PI 0.5))) (* TrayWidth _PLOTSCALE))
	      t37 TrayAngle
	      apt4 (polar apt3 TrayAngle (* tandist _PLOTSCALE))
	      apt6 (polar TrayPoint2 (+ TrayAngle (* DirectionFactor (* PI 1.5))) (* _PLOTSCALE HalfSize2))
	      apt5 (polar apt6 (+ TrayAngle PI) (* tandist _PLOTSCALE))
		  TrayDataList (list TrayPoint1 TrayPoint2 TrayWidth TrayDepth TrayFlange)
		  TrayBaseEnt (MEDBuild3DTrayBaseFromOutline TrayCenterLine)
		  UseThisAngle (angle apt3 apt4)
		  OtherPoint2 (polar TrayPoint1 UseThisAngle StockReducerLength)
		  mlist (list (list apt2 nil) (list apt1 nil))   
		  TempTrayCenter (MEDmaketray mlist nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayDataList (list TrayPoint1 OtherPoint2 TrayWidth TrayDepth TrayFlange)
		  TrayFlangeEnt1 (MEDBuild3DTrayFlangeFromEntity TrayDataList (* 1.0 DirectionFactor) TempTrayCenter)
		  t5 Trayangle
		  mlist (list (list apt3 nil) (list apt4 nil) (list apt5 nil) (list apt6 nil))   
		  TempTrayCenter (MEDmaketray mlist nil nil (MEDGetCurrentOCS))
		  TempTrayCenter (entlast)
		  TrayFlangeEnt2 (MEDBuild3DTrayFlangeFromEntity TrayDataList (* -1.0 DirectionFactor) TempTrayCenter)
    )
    (command "union" TrayBaseEnt TrayFlangeEnt1 TrayFlangeEnt2 "")
)   


