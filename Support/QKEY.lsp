;this command will simply Label all tray elevations.
(defun c:ttags( / ctlt ctlay cctid ccten cctszl ctpt1 ctpt2 ctpt3 ctan ctlen ctinfo
	         keyent keydata blk)
	 (setq txtstylname "T1") ; Set Text Stylle Name Here
	 (setq ctlt (getvar "celtype"))
	 (setvar "attreq" 1)
	 (med_cur_set "c:ttag")
	 (ltback nil)
	 (setq ctlay (getvar "clayer"))
	 (smlayer _ECTAG)
	 (setvar "ATTDIA" 0)
	 (setq ctss (ssget (list (cons 0 "LWPOLYLINE") (cons -3 (list (list _TRAY))))))
	 (if ctss
		 (progn
			 (setq ctsslen (sslength ctss)
				   ctcnt 0
			 )
			 (while (< ctcnt ctsslen)
				 (setq cten (ssname ctss ctcnt)
					   ctelev   (dxf 38 (entget cten))
					   ctptlist (bld_lw_ptlist cten)
					   ctpt1    (cdr (nth 0 (car ctptlist)))
					   ctpt2    (cdr (nth 1 (car ctptlist)))
					   ctendata (xdataget cten _TRAY)
					   cttextpt (be ctpt1 ctpt2)
					   cttextro (angle ctpt1 ctpt2)
					   ctszl (nth 2 ctendata)
					   ctid  (nth 1 ctendata)
					   ctinfo (strcat (nth 2 (getsize nil ctszl)) " TRAY B.O.T EL.=")
					   ctcnt (1+ ctcnt)
				 )
				 (if (= cttextro PI)
					 (setq cttextro 0.0)
				 )
				 (if (= cttextro (* PI 1.5))
					 (setq cttextro (* PI 0.5))
				 )
				 (setvar "elevation" ctelev)
				 (command "text" "s" txtstylname cttextpt (angtos cttextro 1 4) (strcat ctinfo (rtos ctelev 4 2)))
			)
		)
	 )
	 (command "layer" "s" ctlay "")
	 (ltback ctlt)
)
(defun c:telev( / ctlt ctlay cctid ccten cctszl ctpt1 ctpt2 ctpt3 ctan ctlen ctinfo
	         keyent keydata blk)
	 ;(setq txtstylname "T1") ; Set Text Stylle Name Here
	 (setq txtstydata (assoc "T1" MED_TXT_STYLE_MAP)
		  txtstylname (cadr txtstydata)
	 )
	 (setq ctlt (getvar "celtype"))
	 (setq currenttab (getvar "ctab"))
	 (setvar "attreq" 1)
	 (med_cur_set "c:telev")
	 (ltback nil)
	 (setq ctlay (getvar "clayer"))
	 (smlayer _ECTAG)
	 (setvar "ATTDIA" 0)
	 (if (/= currenttab "Model")
		 (command "mspace")
	 )
	 (setq cten (nentsel "\nSelect Tray CenterLine" )
		   cten (car cten)
	 )
	 (if (/= currenttab "Model")
		 (command "pspace")
	 )
	 (if cten
		 (progn
			(setq ctelev   (dxf 38 (entget cten))
				  ctendata (xdataget cten _TRAY)
				  cttextpt (getpoint "\nSelect Point for Text Placement: ")
				  ctszl (nth 2 ctendata)
				  ctid  (nth 1 ctendata)
				  ctinfo (strcat (nth 2 (getsize nil ctszl)) " TRAY B.O.T. ELEV.=")
			)
			(setvar "elevation" ctelev)
			(setq cttextro (- 0.0 (getvar "viewtwist")))
			(command "text" "s" txtstylname cttextpt (angtos cttextro 2 4) (strcat ctinfo (rtos ctelev 4 2)))
		)
	 )
	 (command "layer" "s" ctlay "")
	 (ltback ctlt)
)



