(defun getmedlistdata( medent )
  (setq applist (xd_apps medent)
       numapps (length applist)
       appcnt  0
       rtstlst (list "")
 )
 (while (< appcnt numapps)
   (setq appnm (nth appcnt applist)
         appdata (cdr (xdataget medent appnm))
         datalen (length appdata)
         applen  (eval (read (strcat "len" (substr appnm 4))))
         numtags (/ datalen applen)
         tagcnt 0
   )
   (while (< tagcnt numtags)
     (cond
       ((= appnm _CABLE)
           (setq medtag (nth (+ 0 (* applen tagcnt)) appdata)
                 medsize(nth (+ 1 (* applen tagcnt)) appdata)
                 medcode(nth (+ 2 (* applen tagcnt)) appdata)
                 medrtag(nth (+ 3 (* applen tagcnt)) appdata)
                 meddist(nth (+ 4 (* applen tagcnt)) appdata)
                 medmesr(nth (+ 5 (* applen tagcnt)) appdata)
           )
	   (setq rtstlst (append rtstlst (list (strcat appnm "  [" medtag "]")
		                               (strcat "  Size  =" (rtos medsize 2 8))
                                               (strcat "  Code  =" (itoa medcode))
                                               (strcat "  Desc  =" (clookup medcode medsize appnm))
                                               (strcat "  Rtag  =" medrtag)
					  )
	                 )
           )
           (if (= medmesr "T")
             (progn
                (setq m_len (polylen medent))
                (setq rtstlst (append rtstlst (list (strcat "  Dist  = 0.0 (Calculated = " (rtos m_len) ")" ))))
             )
             (setq rtstlst (append rtstlst (list (strcat "  Dist  =" (rtos meddist)))))
           )
           (setq rtstlst (append rtstlst (list (strcat "  Mesr  =" medmesr ))))
       )
       ((= appnm _CONDUIT)
           (setq medtag (nth (+ 0 (* applen tagcnt)) appdata)
                 medsize(nth (+ 1 (* applen tagcnt)) appdata)
                 medcode(nth (+ 2 (* applen tagcnt)) appdata)
                 meddist(nth (+ 3 (* applen tagcnt)) appdata)
                 medmesr(nth (+ 4 (* applen tagcnt)) appdata)
           )
	   (setq rtstlst (append rtstlst (list (strcat appnm "  [" medtag "]")
		                               (strcat "  Size  =" (rtos medsize 2 8))
                                               (strcat "  Code  =" (itoa medcode))
                                               (strcat "  Desc  =" (clookup medcode medsize appnm))
                                           
					  )
	                 )
           )
           (if (= medmesr "T")
             (progn
                (setq m_len (polylen medent))
                (setq rtstlst (append rtstlst (list (strcat "  Dist  = 0.0 (Calculated = " (rtos m_len) ")" ))))
             )
             (setq rtstlst (append rtstlst (list (strcat "  Dist  =" (rtos meddist)))))
           )
           (setq rtstlst (append rtstlst (list (strcat "  Mesr  =" medmesr ))))
       )
       ((= appnm _TRAY)
           (setq medtag (nth (+ 0 (* applen tagcnt)) appdata)
                 medsize(nth (+ 1 (* applen tagcnt)) appdata)
                 medcode(nth (+ 2 (* applen tagcnt)) appdata)
                 meddist(nth (+ 3 (* applen tagcnt)) appdata)
                 meddpth(nth (+ 4 (* applen tagcnt)) appdata)
                 medmesr(nth (+ 5 (* applen tagcnt)) appdata)
                 medflng(nth (+ 6 (* applen tagcnt)) appdata)
                 
           )
    	   (setq rtstlst (append rtstlst (list (strcat appnm "  [" medtag "]")
		                               (strcat "  Size  =" (rtos medsize 2 8))
                                               (strcat "  Code  =" (itoa medcode))
                                               (strcat "  Desc  =" (clookup medcode medsize appnm))
                                               
					  )
	                 )
           )
           (if (= medmesr "T")
             (progn
                (setq m_len (polylen medent))
                (setq rtstlst (append rtstlst (list (strcat "  Dist  = 0.0 (Calculated = " (rtos m_len) ")" ))))
             )
             (setq rtstlst (append rtstlst (list (strcat "  Dist  =" (rtos meddist)))))
           )
           (setq rtstlst (append rtstlst (list (strcat "  Depth =" (rtos meddpth 2 8))
					       (strcat "  Mesr  =" medmesr )
					 )
		         )
           )
           (setq rtstlst (append rtstlst (list (strcat "  Flange=" (rtos medflng 2 2)))))
       )
       ((= appnm _FITTING)
           (setq medtag (nth (+ 0 (* applen tagcnt)) appdata)
                 medsize(nth (+ 1 (* applen tagcnt)) appdata)
                 medcode(nth (+ 2 (* applen tagcnt)) appdata)
                 medalt (nth (+ 3 (* applen tagcnt)) appdata)
                 meddpth(nth (+ 4 (* applen tagcnt)) appdata)
           )
	   (setq rtstlst (append rtstlst (list (strcat appnm "  [" medtag "]")
		                               (strcat "  Size  =" (rtos medsize 2 8))
                                               (strcat "  Code  =" (itoa medcode))
                                               (strcat "  Desc  =" (clookup medcode medsize appnm))
					       (strcat "  Alt   =" (rtos medalt  2 4))
                                               (strcat "  Depth =" (rtos meddpth 2 4))
                                               
					  )
	                 )
           )
           
       )
       ((= appnm _EQUIP)
           (setq medtag (nth (+ 0 (* applen tagcnt)) appdata)
                 medcode(nth (+ 1 (* applen tagcnt)) appdata)
           )
	   (setq rtstlst (append rtstlst (list (strcat appnm "  [" medtag "]")
		                               (strcat "  Code  =" (itoa medcode))
                                               (strcat "  Desc  =" (clookup medcode medsize appnm))
					                                                      
					  )
	                 )
           )
           
       )

     )
     (setq tagcnt (1+ tagcnt))
   )
   (setq appcnt (1+ appcnt))
 )

 (princ)
 rtstlst
)


