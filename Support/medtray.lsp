(defun opposite_tray_endpt (pln_hdent pl_endpt / pl_data ptlist ret_pt ptlistlen)
  (if (= (dxf 0 (entget pln_hdent)) "LWPOLYLINE")
    (progn
      (setq ptlist (bld_lw_ptlist pln_hdent)
	    ptlist (nth 0 ptlist)
	    otept1 (nth 0 ptlist)
	    otept2 (nth 1 ptlist)
      )
      (if (> (length pl_endpt) 2)
	(setq pl_endpt (list (nth 0 pl_endpt) (nth 1 pl_endpt)))
      )
      (if (equal (cdr otept1) pl_endpt 0.0000000001)
	(setq ret_pt (cdr otept2))
	(setq ret_pt (cdr otept1))
      )
    )
    (progn
      (setq pl_data (entget (entnext pln_hdent))
            ptlist  nil
      )
      (while (/= "SEQEND" (dxf 0 pl_data))
        (setq ptlist (append ptlist (list (dxf 10 pl_data)))
              pl_data (entget (entnext (dxf -1 pl_data)))
        )
      )
     (setq ptlistlen (length ptlist))
     (if (equal (nth 0 ptlist) pl_endpt)
       (progn
         (setq ret_pt (nth (1- ptlistlen) ptlist))
       )
       (progn
         (setq ret_pt (nth 0 ptlist))
       )
     )
    )
  )
  ret_pt
)

