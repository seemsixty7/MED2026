***POP3
**POP3TRAY
               [Cable Tray]
               [3D Tray Out]^C^CMAKE3DTRAY 
               [->Set Size]
                 [Width- ]
                 [   6"   ](setq _TRSIZE  6.0) 
                 [   9"   ](setq _TRSIZE  9.0) 
                 [  12"   ](setq _TRSIZE 12.0) 
                 [  18"   ](setq _TRSIZE 18.0) 
                 [  24"   ](setq _TRSIZE 24.0) 
                 [  30"   ](setq _TRSIZE 30.0) 
                 [  36"   ](setq _TRSIZE 36.0) 
                 [  42"   ](setq _TRSIZE 42.0) 
                 [<-  48"   ](setq _TRSIZE 48.0) 
               [->Set Depth]
                 [Depth- ]
                 [   3"   ](setq _TRDEPTH 3.0) 
                 [   4"   ](setq _TRDEPTH 4.0) 
                 [<-   6"   ](setq _TRDEPTH 6.0) 
               [->Set Radius]
                 [Radius-  ]
                 [12" Radius]^C^C(setq _TRFITTADD 0 _TRRAD 12.0) 
                 [24" Radius]^C^C(setq _TRFITTADD 1 _TRRAD 24.0) 
                 [36" Radius]^C^C(setq _TRFITTADD 2 _TRRAD 36.0) 
                 [<-48" Radius]^C^C(setq _TRFITTADD 120 _TRRAD 48.0) 
               [--]
               [TRAY PLAN VIEW...]
               [Heavy Duty Cable Tray]^C^C(setq _TRTYPE 2) TRAY 
               [Medium Duty Cable Tray]^C^C(setq _TRTYPE 1) TRAY 
               [Light Duty Cable Tray]^C^C(setq _TRTYPE 0) TRAY 
               [Plan Vert 90     ]^C^CTRAYV90 
               [Horizontal Offset]^C^CTRAYOFF 
               [Vertical Offset  ]^C^CPTRAYOFF 
               [TrayDown         ]^C^Ctraydn 
               [TrayUp           ]^C^Ctrayup 
               [->Plan Fittings]
                 [90 Elbow   ]^C^CTRAY90 
                 [60 Elbow   ]^C^CTRAY60 
                 [45 Elbow   ]^C^CTRAY45 
                 [30 Elbow   ]^C^CTRAY30 
                 [Tee        ]^C^CTRAYTEE 
                 [Cross      ]^C^CTRAYCROSS 
                 [Str RE     ]^C^CTRAYRE 
                 [Lft RE     ]^C^CTRAYREL 
                 [<-Rgt RE     ]^C^CTRAYRER 
               [ Icon ]$i=MED.MEDtraysldp $i=* 
               [--]
               [Cable Channel...]
               [4" Cable Channel]^C^C(setq _CHANSIZE 4.0) channel 
               [6" Cable Channel]^C^C(setq _CHANSIZE 6.0) channel 
               [Plan Vert 90    ]^C^CCHANV90 
               [Channel Down    ]^C^Cchandn 
               [Channel Up      ]^C^Cchanup 
               [Channel Offset  ]^C^CCHANOFF 
               [->Channel Fittings]
                 [30 Deg Chan. Fit]^C^Cchan30 
                 [45 Deg Chan. Fit]^C^Cchan45 
                 [60 Deg Chan. Fit]^C^Cchan60 
                 [90 Deg Chan. Fit]^C^Cchan90 
                 [Channel Cross   ]^C^CCHANCROSS 
                 [<-Channel Tee   ]^C^CCHANTEE 
               [ Icon ]$i=MED.MEDchansld $i=* 

