(defun c:showfieldcode()
	(setq ent (nentsel "\nSelect Entity to show field code"))
	(if ent
		(progn
			(setq entdata (entget (car ent)))
			(if (or (= (dxf 0 entdata) "TEXT") (= (dxf 0 entdata) "MTEXT") (= (dxf 0 "ATTRIB")))
				(progn
					(setq obj (vlax-ename->vla-object (dxf -1 entdata))
						  fieldcode (vla-fieldcode obj)
					)
					(princ "\n")
					(princ fieldcode)
				)
			)
		)
	)
)


