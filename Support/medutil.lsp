;;;This one builds a string of linked data for the Target Text/attribute to receive.
(defun c:setlink()
	(setq LinkEnt (nentsel "\nSelect Item to recieve Link data: "))
	(if LinkEnt
		(progn
			(command "undo" "m")
			(prompt "\nSelect Text/Attribute Entities Link to:")
			(setq LinkValue "")
			(while (setq textent (nentsel "\nSelect Text/Attribute: "))
				(setq linkedentdata (entget (car textent))
					  linkedentOID (vla-get-objectid (vlax-ename->vla-object (dxf -1 linkedentdata)))
				)
				(if (= LinkValue "")
					(setq LinkValue (strcat "%<\\AcObjProp Object(%<\\_ObjId "  (itoa linkedentOID) ">%).TextString \\f \"%tc1\">%"))
					(setq LinkValue (strcat LinkValue "-" "%<\\AcObjProp Object(%<\\_ObjId "  (itoa linkedentOID) ">%).TextString \\f \"%tc1\">%"))
				)
			)
			(setq LinkEntData (entget (car LinkEnt)))
			(if (or (= (dxf 0 LinkEntData) "ATTRIB")
					(= (dxf 0 LinkEntData) "TEXT")
			)
				(progn
					(setq newvalue LinkValue
						  newentdata (subst (cons 1 newvalue) (assoc 1 LinkEntData) LinkEntData)
					)
					(entmod newentdata)
					(if (= (dxf 0 LinkEntData) "TEXT")
						(entupd (dxf 330 newentdata))
					)
				)
			)
		)
		(princ "\nNothing Selected:")	
	)
	(princ)
)


