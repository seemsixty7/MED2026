(defun qt(prefix)
  (setq txtss (ssget))
  (if txtss
    (progn
      (setq catag (getstring "\nCable Tag: ")
            catag (strcat "PART OF " prefix "-" catag)
            num (sslength txtss)
            cnt 0
      )
      (while (< cnt num)
        (setq txtent (ssname txtss cnt)
              txtdata(entget txtent)
              old    (assoc 1 txtdata)
              new    (cons 1 catag)
              txtdata(subst new old txtdata)
              cnt (1+ cnt)
        )
        (entmod txtdata)
      )
    )
  )
)
(defun itag (prefix)
