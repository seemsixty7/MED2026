(defun trayfit(tryfitcode tryprompt)
  (setq trybas (entsel (strcat "\nSelect Tray for " tryprompt ": ")))
  (if trybas
     (progn
        (setq trybas (car trybas)
              trydat (xdataget trybas _TRAY)
        )
        (if trydat
          (progn
            (setq trysiz (nth 2 trydat)
                  trydpt (nth 5 trydat)
                  xdlist (bld_fitting tryfitcode trysiz "NONE" nil trydpt)
                  drpent (entsel (strcat "\nSelect Entity To add " tryprompt " Fitting to: "))
            )
          )
          (progn
            (setq trydat (xdataget trybas _FITTING)
                  trysiz (nth 2 trydat)
                  trydpt (nth 5 trydat)
                  xdlist (bld_fitting tryfitcode trysiz "NONE" nil trydpt)
                  drpent (entsel (strcat "\nSelect Entity To add " tryprompt " Fitting to: "))
            )
          )
        )
        (if drpent
           (progn
              (setq drpent (car drpent)
                    drpdat (xdataget drpent _FITTING)
              )
              (if drpdat
                 (progn
                    (setq c-code (nth 3 drpdat)
                          c-size (nth 2 drpdat)
                          c-tag  (nth 1 drpdat)
                          c-alt  (nth 4 drpdat)
                          c-dpt  (nth 5 drpdat)
                          xdclist (bld_fitting c-code c-size c-tag c-alt c-dpt)
                          xdlist (xdatappend xdclist xdlist)
                    )
                 )
              )
              (xdatadd drpent xdlist)
              (prompt "\nXdata has been added! ")
           )
           (Prompt "\nXdata Add has Failed!!!")
        )
     )
  )
)
