(defun m3dtray(trent)
  (setq trentdata (xdataget trent _TRAY)
	trentvdata (vtrayxdataget trent)
  )
  (if (and trentdata trentvdata)
    (progn
      
      (setq vtrydir (nth 3 trentvdata)
	    vtryadd (nth 4 trentvdata)
      )
      (if (= vtryadd 0.0)
	(progn

          (setq ptlist (bld_lw_ptlist trent)
                trpt1  (cdr (nth 0 (nth 0 ptlist)))
                trpt2  (cdr (nth 1 (nth 0 ptlist)))
                trang (angle trpt1 trpt2)
                trdist(distance trpt1 trpt2)
                trsize(nth 2 trentdata)
                trpt3 (polar trpt1 (- trang (* PI 0.5)) (* (* _PLOTSCALE trsize) 0.5))
                trpt4 (polar trpt3 trang trdist)
                trpt5 (polar trpt4 (+ trang (* PI 0.5)) (* _PLOTSCALE trsize))
                trpt6 (polar trpt5 (+ trang PI) trdist)
		3dmkelev (getvar "ELEVATION")
		3dworkelev (dxf 38 (entget trent))
          )
	  (setvar "ELEVATION" 3dworkelev)
          (pmake (list trpt3 trpt4 trpt5 trpt6) T)
	  (setvar "ELEVATION" 3dmkelev)
	  (command "extrude" (entlast) "" (* vtrydir (nth 4 trentdata)) "" )
        )
	(progn

	  (setq ptlist (bld_lw_ptlist trent)
		trpt1 (cdr (nth 0 (nth 0 ptlist)))
		trpt2 (cdr (nth 1 (nth 0 ptlist)))
		actgenang (angle trpt1 trpt2)
		trdist (distance trpt1 trpt2)
		actualdist (nth 4 trentdata)
		actualang  (nth 4 trentvdata)
		actualdir  (nth 3 trentvdata)
		trdpth     (nth 5 trentdata)
		useangle   (* actualang actualdir)
		;trpt1 (polar trpt1 (* PI -0.5) (* (nth 2 trentdata) 0.5))
	        trpt2 (polar trpt1 useangle actualdist)
	        trpt3 (polar trpt2 (+ useangle (* PI 0.5 actualdir)) (* _PLOTSCALE trdpth))
	        trpt4 (polar trpt1 (+ useangle (* PI 0.5 actualdir)) (* _PLOTSCALE trdpth))
	  )
	  (pmake (list trpt1 trpt2 trpt3 trpt4) T)
	  ;(SD)
	  (setq 3dvent (entlast)
	        3dventdata (entget 3dvent)
	        3dold  (assoc 210 3dventdata)
	        3dnew  (cons 210 (list 0.0 -1.0 -1.83691e-016))
	        3dventdata (subst 3dnew 3dold 3dventdata)
	        3dventdata (entmod 3dventdata)
	        3dventpts (nth 0 (bld_lw_ptlist 3dvent))
	        frompoint (trans (append (cdr (nth 0 3dventpts)) (list (dxf 38 3dventdata))) 3dvent 0)
	        movetopoint (append (polar trpt1 (+ actgenang (* PI -0.5)) (* 0.5 (* _PLOTSCALE (nth 2 trentdata)))) (list (dxf 38 (entget trent))))
          )
          (command "move" 3dvent "" frompoint movetopoint)
	  
          (command "rotate" 3dvent "" movetopoint (angtos actgenang 0 8))
          ;(command "move" 3dvent "" "0,0,0" (strcat "0,0," (rtos shiftfact 2 8)))
          (command "extrude" 3dvent "" (* -1 (* _PLOTSCALE (nth 2 trentdata))) "" )
	)
      )
    )
    (progn
     (if trentdata
     (progn
       (setq ptlist (bld_lw_ptlist trent)
             trpt1  (cdr (nth 0 (nth 0 ptlist)))
             trpt2  (cdr (nth 1 (nth 0 ptlist)))
             dpth (nth 5 trentdata)
             wdth (nth 2 trentdata)
             zcoord (dxf 38 (entget trent))
             genang (angle trpt1 trpt2)
             pt1 trpt1
             pt2 (polar trpt1 0.0 (distance trpt1 trpt2))
             pt3 (polar pt2 (+ (* PI 0.5) 0.0) (* _PLOTSCALE dpth))
             pt4 (polar pt1 (+ (* PI 0.5) 0.0) (* _PLOTSCALE dpth))
             _ZFLAG T
             passlist (list pt1 pt2 pt3 pt4)
             newpoint (polar trpt1 (- genang (* PI 0.5)) (* (* _PLOTSCALE wdth) 0.5))
	     newpoint (append newpoint (list zcoord))
             _USEELEV zcoord;0.0; (* -1 (cadr trpt1))
        )

        
        (pmake passlist T)
       ;(princ (dxf 10 (entget (entlast))))
       ;(setq test (entget (entlast)))
        (setq movepoint (append (dxf 10 (entget (entlast))) (list zcoord))
	;      testpt movepoint
              movepoint (trans movepoint (entlast) 0)
        )
       (princ movepoint)
        (command "move" (entlast) "" movepoint newpoint)
        (command "rotate" (entlast) "" newpoint (angtos genang 0 8))
        (command "extrude" (entlast) "" (* -1 (* _PLOTSCALE wdth)) "" )
      )
    )
   )
  )
)
(defun mtrayfit (trayfitent trayfitdata NoFlangeFlag)
	 (setq fitptbllist (bld_lw_ptlist trayfitent)
	fitptlist   (nth 0 fitptbllist)
	fitbllist   (nth 1 fitptbllist)
	fitwidth    (nth 2 trayfitdata)
	fitdpth     (nth 5 trayfitdata)
	fitalt      (nth 4 trayfitdata)
	m3delev     (getvar "ELEVATION")
	fitflange   (if (< (nth 6 trayfitdata) 0) 0.0 (nth 6 trayfitdata)) ;(nth 6 trayfitdata)
	trayfitentdata (entget trayfitent)
	fitOCS      (dxf 210 trayfitentdata)
  )
  (if NoFlangeFlag
  	  (setq fitflange 0.0)
  )
  (setvar "ELEVATION" (dxf 38 trayfitentdata))
  (xdstrip trayfitent _DOUBLE)
  (setq clay (getvar "CLAYER"))
      (if (not (tblsearch "layer" (nth 0 _MEDTRAY)))
        (progn
          (smlayer _MEDTRAY)
          (setvar "CLAYER" clay)
        )
      )
      (setq CR_LAYER (nth 0 _MEDTRAY))
  (cond
    ((= (length fitptlist) 4)
       (make_elbow fitptbllist (+ fitwidth fitflange))
       (xdrtray (entlast) trayfitent)
     )
    ((= (length fitptlist) 7)
       (make_tee fitptbllist (+ fitwidth fitflange))
       (xdrtray (entlast) trayfitent)
     )
    ((= (length fitptlist) 10)
       (make_cross fitptbllist (+ fitwidth fitflange))
       (xdrtray (entlast) trayfitent)
     )
    ((and (= (length fitptlist) 2)
	  (= 18.0 (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist)))))
       (make_re fitptbllist (+ fitwidth fitflange) (+ fitalt fitflange))
       (xdrtray (entlast) trayfitent)
     )
    ((and (= (length fitptlist) 2)
          (> (rem (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist))) 1.0) 0.0))
       (make_relr fitptbllist (+ fitwidth fitflange) (+ fitalt fitflange) trayfitent)
       (xdrtray (entlast) trayfitent)
     )
    ((vtrayxdataget trayfitent)
    	(m3dvtrayfit trayfitent)
    )
    (T nil)
    
  )
  (setvar "ELEVATION" m3delev)
)
(defun m3dtrayfit (trayfitent trayfitdata)
  (setq fitptbllist (bld_lw_ptlist trayfitent)
	fitptlist   (nth 0 fitptbllist)
	fitbllist   (nth 1 fitptbllist)
	fitwidth    (nth 2 trayfitdata)
	fitdpth     (nth 5 trayfitdata)
	fitalt      (nth 4 trayfitdata)
	m3delev     (getvar "ELEVATION")
	trayfitentdata (entget trayfitent)
  )
  (setvar "ELEVATION" (dxf 38 trayfitentdata))
  
  (cond
    ((= (length fitptlist) 4)
       (make_elbow fitptbllist fitwidth)
       (command "extrude" (entlast) "" (* _PLOTSCALE fitdpth) "")
    )
    ((= (length fitptlist) 7)
       (make_tee fitptbllist fitwidth)
       (command "extrude" (entlast) "" (* _PLOTSCALE fitdpth) "")
    )
    ((= (length fitptlist) 10)
       (make_cross fitptbllist fitwidth)
       (command "extrude" (entlast) "" (* _PLOTSCALE fitdpth) "")
    )
    ((and (= (length fitptlist) 2)
	  (= 18.0 (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist)))))
       (make_re fitptbllist fitwidth fitalt)
       (command "extrude" (entlast) "" (* _PLOTSCALE fitdpth) "")
    )
    ((and (= (length fitptlist) 2)
          (> (rem (distance (cdr (nth 0 fitptlist)) (cdr (nth 1 fitptlist))) 1.0) 0.0))
       (make_relr fitptbllist fitwidth fitalt trayfitent)
       (xdrtray (entlast) trayfitent)
       (command "extrude" (entlast) "" (* _PLOTSCALE fitdpth) "")
     )
    ((vtrayxdataget trayfitent)
     (m3dvtrayfit trayfitent)
    )
    (T nil)
    
  )
  (setvar "ELEVATION" m3delev)
  
)

