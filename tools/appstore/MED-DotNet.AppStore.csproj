<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux/CI build of MED-DotNet.dll for the App Store bundle (net472, AutoCAD 2020 API refs from NuGet). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MED-DotNet</AssemblyName>
    <RootNamespace>MEDDotNet</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/MED-DotNet/MED-DotNet/**/*.cs" Exclude="../../src/MED-DotNet/MED-DotNet/obj/**;../../src/MED-DotNet/MED-DotNet/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data.SQLite">
      <HintPath>../../Support/System.Data.SQLite.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
