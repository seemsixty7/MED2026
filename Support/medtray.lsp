(defun tryupdn( traydir trltype trptlist startingelev)
   (setq cltp (getvar "celtype"))
   (ltback trltype)
   (setq clay (getvar "CLAYER")
         acttraydir nil
   )
   (if (not trptlist)
     (progn
       (while (not (setq trbasent (entsel "\nSelect Tray item"))))
       (setq pt1 (osnap (cadr trbasent) "ENDPoint")
	     opt1(opposite_tray_endpt (car trbasent) pt1)
	     pt3 pt1
	     
       )
     )
     (progn
      (setq pt1 (nth 0 trptlist)
            pt3 (nth 1 trptlist)
      )
     )
   )
   (setq pt2  (list (car pt3) (cadr pt1) (caddr pt1))
         pt4  (list (car pt1) (cadr pt3) (caddr pt1))
	 trsizess (ssget "c" pt1 pt3)
	 trsize (get_tray_data trsizess)
         trdnverdata nil
         trdncnt 0
         trsizesslen (sslength trsizess)
   )
   (if (not startingelev)
     (progn
       (while (and (not trdnverdata) (< trdncnt trsizesslen))
         (setq trdnverdata (xdataget (ssname trsizess trdncnt) _FITTING)
	       trdncnt (1+ trdncnt)
         )
       )
       (if trdnverdata
	 (progn
           (setq trdnverdata (vtrayxdataget (ssname trsizess (1- trdncnt)))
		 trdnentdata (entget (ssname trsizess (1- trdncnt)))
		 trdnentelev (dxf 38 trdnentdata)
           )
           (if (= (nth 3 trdnverdata) 1)
	     (progn
	       (setq traydir "Up"
		     acttraydir "Up"
	   	     startingelev (+ trdnentelev (nth 3 trsize) (nth 1 trdnverdata) (nth 2 trdnverdata))
               )
	     )
	     (progn
	       (setq traydir "Down"
		     acttraydir "Down"
	   	     startingelev (- trdnentelev (+ (nth 1 trdnverdata) (nth 2 trdnverdata)))
               )
	     )
	   )
	 )
       )
     )
	   
   )
   (if _CHANTEE
     (setq trcode _CHANCODE)
     (setq trcode (+ _TRCODE _TRTYPE))
   )
   (setq trsz   (nth 0 trsize)
         trdpth (nth 3 trsize)
         trtag  (nth 1 trsize)
	 trlay  (nth 0 _MEDTRAY)
   )
   (if (not trptlist)
     (setq ang (angle pt1 opt1)
	   pt1 (polar pt1 (+ ang (* PI 0.5)) (* _PLOTSCALE (* 0.5 trsz)))
	   pt2 (polar pt1 (+ PI ang) (* _PLOTSCALE trdpth))
	   pt3 (polar pt2 (- ang (* PI 0.5)) (* _PLOTSCALE trsz))
	   pt4 (polar pt3 ang (* _PLOTSCALE trdpth))
     )
     (setq angofln(atan (/ trdpth trsz))
	 angpts (angle pt1 pt3)
	 pt2    (polar pt3 (+ PI (+ angpts angofln)) (* _PLOTSCALE trsz))
	 pt4    (polar pt1 (+ angpts angofln) (* _PLOTSCALE trsz))
     )
   )
  
   (if (not traydir)
     (setq traydir "Down")
   )
   (if (not trptlist)
      (setq mdprmpt(strcat "\nLength of " (clookup trcode trsz _TRAY)
                        " traveling " traydir
                        " <" (rtos _MEDDIST) ">: "
                   )
            trdist (getdist (be pt1 pt3) mdprmpt)
      )
      (setq trdist (nth 2 trptlist))
   )
   (if (not trdist)
      (setq trdist _MEDDIST)
      (setq _MEDDIST trdist)
   )
   (smlayer (list trlay nil nil))
   (if startingelev
     (progn
       (setq tryupdncurelev (getvar "ELEVATION"))
       (setvar "ELEVATION" startingelev)
     )
   )
   (pmake (list pt1 pt3 pt4 pt2) T)
   (if (= (type traydir) (type (list "")))
     (setq acttraydir (nth 1 traydir)
	   traydir (nth 0 traydir)
     )
   )
   (if (= traydir "Down")
     (progn
       (chg_ent_ltype (entlast) TR_DNLTYPE)
     )
     
   )
   (chg_tray_pl_wdth (entlast) _TR_X_WIDTH)
   (setq mlist (list (list (be pt1 pt4) nil)
                     (list (be pt2 pt3) nil)
               )
   )
   (maketray mlist nil _MEDCENLAY)
        
   (setq xdlist (bld_tray trcode trsz trtag trdist trdpth "F"))
   (xdatadd (entlast) xdlist)
   (if (= acttraydir "Down")
       (setq vtrydir -1)
       (setq vtrydir 1)
   )
   (addvtraydata (entlast) (list 0.0 0.0 vtrydir 0.0))
   (if startingelev
     (progn
       (setvar "ELEVATION" tryupdncurelev)
     )
   )
   (smlayer (list clay nil nil))
   (ltback cltp)
   (princ)
)

