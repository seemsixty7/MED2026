(defun c:sect( / pt1 pt2 val)
    (med_cur_set "C:SECT")
    (setq curatdia (getvar "ATTDIA"))
    (smlayer _MEDTEXT)
    (setq pt1 (getpoint "\nPick first section point"))
    (setvar "orthomode" 1)
    (setq pt2 (getpoint "\nPick second section point" pt1))
    (setq val (getstring "\nEnter section letter <A>: "))
    (setvar "attdia" 0)
    (command "insert" "sect1" pt1 (* 1.0 _SC) "" pt2 )
    (command "insert" "sect" pt1 (* 1.0 _SC) "" "" val)
    (command "copy" "l" "" pt1 pt2)
    (command "insert" "sect2" pt2 (* 1.0 _SC) "" pt1)
    (setvar "ATTDIA" curatdia)
    (med_ret_ok)
	(princ)
)
