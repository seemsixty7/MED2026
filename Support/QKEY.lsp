(defun motor(msize vert)
  (setq mtrfname (findfile "motor.dat")
        mtrfn    (open mtrfname "r")
  )
  (repeat 10 (read-line mtrfn))
  (setq mtrdata (read-line mtrfn))
  (while mtrdata
     (setq mtrsz (atof (substr mtrdata 1 6)))
     (if (= mtrsz msize)
       (progn
         (setq mtr_data mtrdata
               mtrdata nil
         )
       )
       (progn
         (setq mtrdata (read-line mtrfn))
       )
     )
  )
  (close mtrfn)
  (setq mtra (atof (substr mtr_data 7  8))
        mtrb (atof (substr mtr_data 15 8))
        mtrc (- (atof (substr mtr_data 23 8)) (* mtrb 0.5))
        mtrd (atof (substr mtr_data 31 8))
        mtpt (getpoint"\nStart Point: ")
  )
  (if vert
     (progn
        (command "circle" mtpt (* mtrb 0.5))
        (setq bxstpt mtpt)
     )
     (progn
       (setq mtang(getangle mtpt "\nAngle of Genration: ")
             mperc(* mtra 0.1875)
             mtrst(polar mtpt  mtang mperc)
             mtpt1(polar mtrst (+ mtang (* PI 1.5)) (* mtrb 0.5))
             mtpt2(polar mtpt1 mtang (- mtra (* mperc 2)))
             mtpt3(polar mtpt2 (+ mtang (* PI 0.5)) mtrb)
             mtpt4(polar mtpt3 (+ mtang PI) (- mtra (* mperc 2)))
             bxstpt  (polar mtpt mtang (* mtra 0.5))
       )
       (pmake (list mtpt1 mtpt2 mtpt3 mtpt4) T)
       (command "ellipse" "c" mtrst mtpt1 mtpt)
       (command "trim" mtpt2 "" (polar mtrst mtang mperc) "")
       (command "mirror" "l" "" (be mtpt3 mtpt4) (be mtpt1 mtpt2) "")
     )
  )
  (setq mtbxdir (getangle bxstpt "\nSelect Direction of Motor Box: ")
        bxpt    (polar bxstpt mtbxdir (* mtrb 0.5))
        bxpt1   (polar bxpt (+ mtbxdir (* PI 0.5)) (* mtrd 0.5))
        bxpt2   (polar bxpt1 mtbxdir mtrc)
        bxpt3   (polar bxpt2 (- mtbxdir (* PI 0.5)) mtrd)
        bxpt4   (polar bxpt3 (+ mtbxdir PI) mtrc)
  )
  (pmake (list bxpt1 bxpt2 bxpt3 bxpt4) T)
)

(defun c:wires()
  (setq stylnm _TXTSTYLE)      ;Change this to match the desired text style

  (smlayer _MEDTEXT)      ;This line reuires MED to be loaded

  (if (not oldvallist )
     (setq oldvallist "HN G")
  )
  (setq stpt   (getpoint "\nSelect point for tags: ")
        rot    (getpoint stpt "\nSelect Rotation for tags: ")
        genang (angle stpt rot)
  )
  (prompt "\nH=Hot N=Neutral Space=Spacer G=Ground S=Switchleg")

  (setq wirestr(getstring T (strcat "\nEnter Format String <" oldvallist ">: "))
        stang  (+ genang (/ PI 3.0))
        endang (+ stang PI)
        wlen   (* (* _PLOTSCALE 0.09375) _SC) ;Controls the length of the Hots
        nlen   (* (* _PLOTSCALE 0.15625) _SC) ;Controls the length of the Neutrals
        glen   (* (* _PLOTSCALE 0.15625) _SC) ;Controls the length of the Grounds
        slen   (* (* _PLOTSCALE 0.15625) _SC) ;Controls the length of the switch Leg
        sleg   (* (* _PLOTSCALE 0.0625)  _SC) ;Cnntrols the length of the leg on the switch leg
        spcr   (* (* _PLOTSCALE 0.05625) _SC) ;Spacer distance between each dash or squiggle
        cnt    0
  )
  (if (= wirestr "")
     (setq wirestr oldvallist)
  )
  (setq num (strlen wirestr)
        oldvallist wirestr
  )

  (while (< cnt num)
      (setq strval (strcase (substr wirestr (1+ cnt) 1)))
      (cond
        ((= strval "H")
          (setq spt (polar stpt stang (* 0.5 wlen))
                ept (polar spt  endang wlen)
          )
          (pmake (list spt ept) nil)
          (setq stpt (polar stpt genang spcr))
        )
        ((= strval "N")
          (setq spt (polar stpt stang (* 0.5 nlen))
                ept (polar spt  endang nlen)
                plin  '((0 . "POLYLINE"))
                vtxt1  (list (cons 0 "VERTEX") (cons 10 spt) (cons 42 0.4))
                vtxt2  (list (cons 0 "VERTEX") (cons 10 stpt) (cons 42 -0.4))
                vtxt3  (list (cons 0 "VERTEX") (cons 10 ept))
                sqend  (list (cons 0 "SEQEND"))
          )
          (entmake plin)
          (entmake vtxt1)
          (entmake vtxt2)
          (entmake vtxt3)
          (entmake sqend)
          (setq stpt (polar stpt genang spcr))
        )
        ((= strval " ")
          (setq stpt (polar stpt genang spcr))
        )
        ((= strval "G")
          (setq spt (polar stpt stang (* 0.5 glen))
                ept (polar spt  endang glen)
                txt (list (cons 0 "TEXT") (cons 1 "G")
                          (cons 10 ept) (cons 11 ept)
                          (cons 7 stylnm) (cons 50 genang)
                          (cons 40 (* 0.0625 _SC))
                          (cons 72 1) (cons 73 2)
                    )
          )
          (pmake (list spt ept) nil)
          (entmake txt)
          (setq stpt (polar stpt genang spcr))
        )
        ((= strval "S")
          (setq spt (polar stpt stang (* 0.5 slen))
                ept (polar spt  endang slen)
                npt (polar ept  genang sleg)
          )
          (pmake (list spt ept npt) nil)
          (setq stpt (polar stpt genang spcr))
        )
      )
      (setq cnt (1+ cnt))
  )
  (entmake)

)

(defun c:refdwg()
  (med_cur_set "C:REFDWG")
  (setq dwglist nil
        currlist nil
  )
  (setq lay (getvar "CLAYER"))
  (smlayer _MEDTEXT)
  (setq intpt (dxf 10 (entget (car (entsel "\nSelect Title Block: "))))
        intpt (polar intpt 0.0 (* _SC 29.4375))
        intpt (polar intpt (* PI 0.5) (* _SC 2.375))
  )
  (initget "Add New")
  (setq ans (getkword "\nAdd Refrences or New Refrences<N>: "))
  (if (= ans "Add")
    (progn
      (prompt "\nSelect Existing Reference drawings: ")
      (setq txtss (ssget)
            num   (sslength txtss)
            cnt   0

      )
      (while (< cnt num)
         (setq ent     (ssname txtss cnt)
               entdata (entget ent)
         )
         (if (= "TEXT" (dxf 0 entdata))
           (progn
              (setq ipt   (polar (dxf 11 entdata) (* PI 1.5) 0.025)
                    itm   (dxf 1 entdata)
                    ipt2  (polar ipt 0.0 (* _SC 0.375))
                    ipt2  (polar ipt2 (* PI 1.5) (* _SC 0.125))
                    ipt3  (polar ipt2 0.0 (* _SC 2.9366))
                    ipt3  (polar ipt3 (* PI 0.5) (* _SC 0.25))
                    dat1  (ssget "w" ipt2 ipt3)
              )
              (if dat1
                 (setq datlen(sslength dat1))
              )
              (if (< datlen 1)
                (progn
                  (setq dwgdesc (getdwgnm itm)
                        dwgnum itm
                        dwglist (append dwglist (list dwgnum))
                        currlist(append currlist (list (list dwgnum dwgdesc)))
                  )
                  (entdel ent)
                )
                (progn
                  (setq datent (ssname dat1 0)
                        dwgdesc (dxf 1 (entget datent))
                        dwgnum itm
                        dwglist (append dwglist (list dwgnum))
                        currlist(append currlist (list (list dwgnum dwgdesc)))
                  )
                  (entdel ent)
                  (entdel datent)
                )
              )
           )
         )
         (setq cnt (1+ cnt))
      )
    )
  )
  (while (/= (setq dwgitem(getstring T "\nDrawing Number: ")) "")
         (setq dwglist (append dwglist (list dwgitem)))
  )
  (setq dwglist (acad_strlsort dwglist)
        dwglist (reverse dwglist)
  )
  (foreach itm dwglist
     (setq pt1 (polar intpt 0.0 (* _SC 0.40894539)))
     (if (setq dwgdesc (assoc itm currlist))
        (setq dwgdesc (cadr dwgdesc))
        (setq dwgdesc (getdwgnm itm))
     )
     (setq dwgnum itm)
     (command "text" "s" "s1a" "m" intpt "" dwgnum)
     (command "text" "s" "s1a" "ml" pt1   "" dwgdesc)
     (setq intpt (polar intpt (* PI 0.5) (* _SC 0.25)))

  )
  (setvar "CLAYER" lay)
  (med_ret_ok)
  (princ)

)
(defun getdwgnm(dwgnum)
  (setq fn   (open (findfile "dwgindex.dat") "r")
        dline(read-line fn)
        dlcd (atoi (substr dline 1 16))
  )
  (while (and (/= dlcd dwgnum) dline)
    (setq dline(read-line fn))
    (if dline
       (setq dlcd (chopspace (substr dline 1 16)))
    )
  )
  (close fn)
  (if (not dline)
     (progn
       (setq dwgdesc "N/F")
     )
     (progn
       (setq dwgdesc (chopspace (substr dline 17 80)))
     )
  )
  dwgdesc
)

