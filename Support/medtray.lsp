                     (list pt7 nil)
                     (list pt8 nil)
               )
  )
  (maketray mlist T nil)
  
)




(defun pl_arc_info_from_buldge (gpt1 gpt2 gpbul)
   (setq gpang (* 4 (atan gpbul))
         gpchord(distance gpt1 gpt2)
         gpanga (- (/ 3.141592654 2.00000000) (/ gpang 2.00000000))
         gprad(/ (/ gpchord 2.00000000)(cos gpanga))
         gpdeg (* gpang (/ 180.000000000 3.141592654))
         gprtlen (* gpdeg gprad 0.017453293)
   )
   (list anga gpchord gpanga gprad gpdeg gprtlen)
)
(defun make_relr (redatalist trwidth1 trwidth2 trayfitent)
  (setq fitdata (xdataget trayfitent _FITTING))
  (setq redata (med_getdesc "FITTING" (nth 3 fitdata)))
  (if (= (strcase (substr redata 1 1)) "L")
	  (setq dirfac 1)
	  (setq dirfac -1)
  )
  (setq pts (nth 0 redatalist)
	pt1 (trans (append (cdr (nth 0 pts)) (list (getvar "ELEVATION"))) (MEDGetCurrentOCS) 1)
	pt2 (trans (append (cdr (nth 1 pts)) (list (getvar "ELEVATION"))) (MEDGetCurrentOCS) 1)
	linelen (distance pt1 pt2)
	redlen 18.0
	entang (angle pt2 pt1)
	halfalt (* (- trwidth1 trwidth2)0.5)
	halfsize2 (* trwidth2 0.5)
	sinofang (/ redlen linelen)
	cosofang (/ halfalt linelen)
	ang (* dirfac (atan (/ sinofang cosofang)))
	genang (+ entang ang)
	gpt1 (polar pt2 genang halfalt)
	genang (angle pt1 gpt1)
	tandist 7.0
  	apt1 (polar pt2 (+ genang (* dirfac (* PI 0.5))) (* _PLOTSCALE halfsize2))
	apt2 (polar apt1 (+ genang PI) (* redlen _PLOTSCALE)) 
	apt3 (polar  apt2 (- genang (* dirfac (* PI 0.5))) (* trwidth1 _PLOTSCALE))
	apt4 (polar apt3 genang (* tandist _PLOTSCALE))
	apt6 (polar pt2 (+ genang (* dirfac (* PI 1.5))) (* _PLOTSCALE halfsize2))
	apt5 (polar apt6 (+ genang PI) (* tandist _PLOTSCALE))
	mlist  (list (list apt1 nil)
                     (list apt2 nil)
                     (list apt3 nil)
                     (list apt4 nil)
                     (list apt5 nil)
                     (list apt6 nil)
               )
  )
  (MEDmaketray mlist T nil (MEDGetCurrentOCS))
)

