(defun c:par()
  (setq ss (ssget '((0 . "TEXT"))))
  (if ss
    (progn
      (setq num (sslength ss)
            cnt 0
      )
      (while (< cnt num)
        (setq ent (ssname ss cnt)
              data(entget ent)
              val (dxf 1 data)
              old (assoc 1 data)
              new (cons 1 (strcat "(" val ")"))
              data (subst new old data)
              cnt (1+ cnt)
        )
        (entmod data)
      )
    )
  )
)
(defun c:app()
  (setq ss (ssget '((0 . "TEXT"))))
  (if ss
    (progn
      (setq tapp (getstring "\nText to append: "))
      (setq num (sslength ss)
            cnt 0
      )
      (while (< cnt num)
        (setq ent (ssname ss cnt)
              data(entget ent)
              val (dxf 1 data)
              old (assoc 1 data)
              new (cons 1 (strcat  val tapp))
              data (subst new old data)
              cnt (1+ cnt)
        )
        (entmod data)
      )
    )
  )
)

(defun c:MEDfind()
  (initget "COnduit CAble Tray Fitting Equipment")
  (setq ans (getkword "Select COnduit/Cable/Tray/Fitting/Equipment <Tray>:"))
  (if (or (= ans "") (not ans))
    (setq ans "Tray")
  )
  (cond
    ((= ans "COnduit")
       (setq mdcd _CONDUIT)
    )
    ((= ans "CAble")
       (setq mdcd _CABLE)
    )
    ((= ans "Tray")
       (setq mdcd _TRAY)
    )
    ((= ans "Fitting")
       (setq mdcd _FITTING)
    )
    ((= ans "Equipment")
       (setq mdcd _EQUIP)
    )
  )
  (setq ss1 (ssget "X" (list (list -3 (list mdcd)))))
  ss1
)


; C:TTAG inserts a tray tagging block and retrieves info about Tray
; from entity selected
;

(defun c:ttag( / ctlt ctlay cctid ccten cctszl ctpt1 ctpt2 ctpt3 ctan ctlen ctinfo
	             keyent keydata blk)
	 (setq ctlt (getvar "celtype"))
	 (setvar "attreq" 1)
	 (med_cur_set "c:ttag")
	 (ltback nil)
	 (setq ctlay (getvar "clayer"))
	 (smlayer _ECTAG)
	 (setvar "ATTDIA" 0)
	 (setq cten     (entsel "\nSelect Tray to tag: ")
	       ctelev   (dxf 38 (entget (car cten)))
	       ctendata (xdataget (car cten) _TRAY)
	 )
	 (if ctendata
	   (progn
	     (setq ctszl (nth 2 ctendata)
		   ctid  (nth 1 ctendata)
	     )
	     (setq ctinfo (strcat (nth 2 (getsize nil ctszl)) "T."))
	     (if ctinfo
	       (progn
	     (setq blk "traytag"
		   mvdist (* _SC 1.0)
		   keyent (medleader nil nil 1.0 _ECTAG)
		   keydata (bld_lw_ptlist keyent)
		   keydata (car keydata)
		   keydata (reverse keydata)
		   keypt1 (cdr (nth 1 keydata))
		   keypt2 (cdr (nth 0 keydata))
		   keyrot(angle keypt1 keypt2)
	     )
	     (setq mvdata nil)
	     (cond
	       ((or (< keyrot (* PI 0.25)) (>= keyrot (* PI 1.75)))
		  (setq keyrot 0.0
			mvdata nil
		  )
	       )
	       ((and (>= keyrot (* PI 0.25)) (< keyrot (* PI 0.75)))
		  (setq keyrot (* PI 0.5)
			mvdata nil
		  )
	       )
	       ((and (>= keyrot (* PI 0.75)) (< keyrot (* PI 1.25)))
		  (setq keyrot 0.0
			keypt2 (polar keypt2 PI (- mvdist (* _SC 0.125)))
			mvdata PI
		  )
	       )
	       ((and (>= keyrot (* PI 1.25)) (< keyrot (* PI 1.75)))
		  (setq keyrot (* PI 0.5)
			keypt2 (polar keypt2 (* PI 1.5) (- mvdist (* _SC 0.125)))
			mvdata (* PI 1.5)
		  )
	       )
	     )

	     (setq elev  (getstring (strcat "\nElevation: <" (rtos ctelev 4 2) ">:")))
	     (if (= elev "")
	       (setq elev (strcat "B.O.T. EL. " (rtos ctelev 4 2)))
	       (setq elev (strcat "B.O.T. EL. " elev))
	     )
	     (setq esystem  (getstring (strcat "\nTraySystem: ")))
	     (command "insert" blk keypt2 (* _PLOTSCALE _SC) (* _PLOTSCALE _SC) 
		      (angtos keyrot) ctid ctinfo elev esystem
	     )
	     (setq hdent (entlast)
		   atent (sel_att_ent hdent "TR_SIZE" nil)
		   atdata (entget atent)
		   txtbx (textbox atdata)
		   addon (car (cadr txtbx))
		   mvdist (+ mvdist addon)
	     )
		
	     (if mvdata
	       (progn
		 (move_attrib hdent mvdata mvdist _TR_SIZETAG)
	       )
	     )

	       )
	       (progn
	       (princ)
	       (prompt "Invalid selection of Tray ")
	       (princ)
	       )
	     )
	   )
	   (progn
	     (princ)
	     (prompt "Invalid selection of Tray ")
	     (princ)
	   )
	 )
	 (setvar "CLAYER" ctlay)
	 (ltback ctlt)
)





;
; C:IT is a command for inserting instrument ballons into drawings
; and retrirving data from instruments selected
;


(defun c:it( / info info2 itang bsize pt1 pt2)
         (med_cur_set "c:it")
         (smlayer _MEDINST)
         (setvar "ATTDIA" 0)
         (setq bsize (* _SC 0.25))
         (setq info (getstring "\nInstrument Tag: ")
               info2 (getstring "\nInstrument number: "))
         (setq pt1 (getpoint "\nPick point"))
         (command "insert" "instag" "pscale" (* _PLOTSCALE _SC ))
               (setq pt2 (getpoint pt1 "\nTag location: "))
               (command pt2 (* _PLOTSCALE _SC) "" "" info info2)
         (setq itang (angle pt2 pt1))
         (setq pt3 (list (+ (* bsize (cos itang)) (car pt2)) (+ (* bsize (sin itang))
                    (cadr pt2))))
         (command "line" pt1 pt2 "")
         (command "break" pt2 pt3)
)

