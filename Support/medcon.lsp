)
(defun c:2lflex ( / 2lent 2lpt 2lent1 2lent2 tcode)
  (smlayer _MEDDETCON)
  (setq tcode _CODE
        _CODE _FLEXTYPE
  )
  (c:conduit)
  (chg_tray_pl_wdth (entlast) 0.0)
  (setq 2lent (entlast)
        2lpt (getvar "LASTPOINT")
  )
  (command "pedit" (list 2lent 2lpt) "s" "")
  (command "offset" (* _PLOTSCALE (* _ACSIZE 0.5)) (list 2lent 2lpt) (polar 2lpt 0.785398 (* _PLOTSCALE 1.0)))
  (setq 2lent1 (entlast))
  (command (list 2lent 2lpt) (polar 2lpt 3.92699 (* _PLOTSCALE 1.0)) "")
  (setq 2lent2 (entlast))
  (chg_tray_pl_wdth 2lent1 _CONDTLPLWIDTH)
  (chg_tray_pl_wdth 2lent2 _CONDTLPLWIDTH)
  (xdr2line  2lent1 2lent2 2lent)
  (setq _CODE tcode)
  (princ)
)

(defun c:confix ()
  (mk2lcon (car (entsel "\nSelect Conduit to fix: ")))
  (princ)
)
