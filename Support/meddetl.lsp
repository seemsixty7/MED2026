;; this function inserts jbox hub plates and hubs as required
;; per user input but does not allow creation of jboxes that
;; are non existance

(defun jbhub(maxsz maxstr bl inspt ang / pt pt1 pt2 apt ans)
 (ltback nil)
 (setq blhub "jbhub")
 (if (<= _CSIZE maxsz)
  (progn
  (initget 1 maxstr)
  (setq ans (getkword (strcat "\nNumber of hubs " maxstr ":")))
  (if (= ans "0")
    (progn
     (setq pt (polar inspt (+ ang 1.5708) (* _PLOTSCALE 0.375)))
     (if (= bl "jbhub4")
        (setq _FITTCODE 230)
        (setq _FITTCODE 227)
     )
     (setq _TAGSUPRESS T)
     (medblkins _MEDDETFIT bl inspt (angtos ang) 1 2)
    )
  )
  (if (= ans "1")
    (progn
     (setq pt (polar inspt (+ ang 1.5708) (* _PLOTSCALE 0.375)))
     (if (= bl "jbhub4")
        (setq _FITTCODE 229)
        (setq _FITTCODE 226)
     )
     (setq _TAGSUPRESS T)
     (medblkins _MEDDETFIT bl inspt (angtos ang) 1 2)
     (smlayer _MEDDETFIT)
     (insblk (strcat blhub _CLETT) pt 1.0 (angtos ang))
    )
  )
  (if (or (and (= bl "jbhub8") (= ans "2") (< _CSIZE 2.5))
          (and (= bl "jbhub4") (= ans "2") (< _CSIZE 1.0))
      )
    (progn
     (if (= bl "jbhub8")
       (setq pt (polar inspt (+ ang 1.5708) (* _PLOTSCALE 0.375))
             pt1 (polar pt ang (* _PLOTSCALE 2.125))
             pt2 (polar pt (+ ang 3.14159) (* _PLOTSCALE 2.125))
       )
       (setq pt (polar inspt (+ ang 1.5708) (* _PLOTSCALE 0.375))
             pt1 (polar pt ang (* _PLOTSCALE 1.0625))
             pt2 (polar pt (+ ang 3.14159) (* _PLOTSCALE 1.0625))

       )
     )
     (if (= bl "jbhub4")
        (setq _FITTCODE 228)
        (setq _FITTCODE 225)
     )
     (setq _TAGSUPRESS T)
     (medblkins _MEDDETFIT bl inspt (angtos ang) 1 2)
     (smlayer _MEDDETFIT)
     (insblk (strcat blhub _CLETT) pt1 1.0 (angtos ang))
     (insblk (strcat blhub _CLETT) pt2 1.0 (angtos ang))
    )
  )
  (if (and (= ans "3") (< _CSIZE 2.0))
    (progn
     (setq pt (polar inspt (+ ang 1.5708) (* _PLOTSCALE 0.375))
           pt1 (polar pt ang (* _PLOTSCALE 2.65625))
           pt2 (polar pt (+ ang 3.14159) (* _PLOTSCALE 2.65625))
     )
     (setq _FITTCODE 224)
     (setq _TAGSUPRESS T)
     (medblkins _MEDDETFIT bl inspt (angtos ang) 1 2)
     (smlayer _MEDDETFIT)
     (insblk (strcat blhub _CLETT) pt 1.0 (angtos ang))
     (insblk (strcat blhub _CLETT) pt1 1.0 (angtos ang))
     (insblk (strcat blhub _CLETT) pt2 1.0 (angtos ang))
    )
  ) 
  (if (not pt)
   (prompt "\nInvalid number of hubs for hub size\n")
  )
 )
 (prompt "\nConduit size is to large for jbox\n")
 )
)

(princ "Done.")
