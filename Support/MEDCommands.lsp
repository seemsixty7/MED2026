(defun MEDFixForExcelParse (StringToFix)
	(if (setq Quotefound (vl-string-search "\"" StringtoFix))
		(progn
			(setq ReturnString StringToFix
				  StartPos 1
			)
			(while Quotefound
				(setq ReturnString (strcat (substr ReturnString 1 QuoteFound) "\"" (substr ReturnString (1+ QuoteFound)))
					  StartPos (+ QuoteFound 2)
					  QuoteFound (vl-string-search "\"" ReturnString StartPos)
				)
			)
		)
		(setq ReturnString StringToFix)
	)
	(if (or (setq CommaFound (vl-string-search "," ReturnString)) StartPos)
		(setq ReturnString (strcat "\"" ReturnString "\""))
	)
	ReturnString
)
	

(defun c:MEDDBBackup()
	(setq MEDTYPEDataBaseRecords (MEDProcessSQLStatement "Select * from MEDTYPE")
	      BackupPathLocation (strcat (getmeddir 1) "\\MEDTYPE-DB-Backup.csv")
	      BackupFileHandle (open BackupPathLocation "w")
    )
	(if BackupFileHandle
		(foreach dbRecord MEDTYPEDatabaseRecords
			(setq RecordLine "")
			(foreach FieldItem dbRecord
				(cond
					((= (type fielditem) 'REAL)
						(setq usethis (itoa (fix fielditem)))
					)
					((not fielditem)
						(setq usethis "")
					)
					(T
						(setq usethis (MEDFixForExcelParse fielditem))
					)
				)
				(setq RecordLine (strcat RecordLine usethis ","))
			)
			(setq RecordLine (substr RecordLine 1 (1- (strlen RecordLine))))
			(write-line RecordLine BackupFileHandle)
		)
	)
	(close BackupFileHandle)
)
