(princ "\rLoading MEDCon...")
(defun c:conduit ( / conent conpt conqty xdlist contag cltp ptprompt)
    (med_cur_set "c:conduit")
    (setvar "cmdecho" 0)
    (setq cltp (getvar "celtype"))
    (ltback _LTP)
    (command "pline")

    (setq ptprompt (strcat "\nPick start point of " 
                           (clookup _CODE _CSIZE _CONDUIT) ": ")
          conpt (getpoint ptprompt)
    )
    (command conpt)

    (while (eq 1 (getvar "cmdactive"))
         (prompt "\nPick point: ")
         (command pause)
    )
    (setvar "filletrad" (* _MEDRADFAC _CSIZE _PLOTSCALE))
    (if (= _CONFILL 1)
      (command "fillet" "p" (list (entlast)(getvar "lastpoint")))  
    )
    (if (not _TAGOFF)
      (setq contag (getstring T "\nConduit Tag number <NONE>: "))
      (setq contag "NONE")
    )
    (if (= contag "")
       (setq contag "NONE")
    )
    (chg_tray_pl_wdth (entlast) _CONPLWIDTH)
    (setq xdlist (bld_conduit _CODE _CSIZE contag nil "T"))
    (xdatadd (entlast) xdlist)
    (ltback cltp)
    (princ)
    (med_ret_ok)
    (terpri)
)
(defun c:define ( / conent conpt conqty xdlist contag)
    (med_cur_set "c:define")
    (setvar "cmdecho" 0)
    (setvar "filletrad" (* 5 _CSIZE))
    (setq definent (car (entsel "\nSelect conduit run to define to current settings: ")))
    (xdstrip definent nil)
    (setq definentdata (entget definent))
    (if (not (and (= (dxf 0 definentdata) "POLYLINE")
                  (= (dxf 0 definentdata) "LWPOLYLINE")
             )
        )
      (progn
        (prompt "\nSelect all entities of conduit run (all entities must meet): ")
        (setq defineplm (ssget))
        (if (not defineplm)
           (command "pedit" definent "y" "") 
           (command "pedit" definent "y" "j" defineplm "" "")
        )
        (setq definent (entlast))
      )
    )
    (setq definen (entget definent)
          definent1 definent
    )
    (if (= _CONFILL 1)
      (command "fillet" "p" definent)
    )
    (if (not _TAGOFF)
      (setq contag (getstring T "\nConduit Tag number <NONE>: "))
      (setq contag "NONE")
    )
    (if (= contag "")
       (setq contag "NONE")
    )
    (setq xdlist (bld_conduit _CODE _CSIZE contag nil nil))
    (xdatadd definent xdlist)
    (princ)
    (med_ret_ok)
    (terpri)
)
(defun c:fc( / tem)
    (med_cur_set "c:fc")
    (if _FCSIZE
      (progn
       (setq tem _FCSIZE)
       (setq _FCSIZE (getdist (strcat "\nEnter conduit size:<" (rtos _FCSIZE 4) "> ")))
      )
      (setq _FCSIZE (getdist "\nEnter conduit size number only: "))
    )
    (if (not _FCSIZE)
      (setq _FCSIZE tem)
    )
    (setvar "filletrad" (* _MEDRADFAC _FCSIZE _PLOTSCALE))
    (command "fillet")
    (med_ret_ok)
    (princ)
)
(defun c:flex( / ep pt1 pt2 pt3 pt4 pt5 sp)
   (med_cur_set "c:flex")
   (princ)
   (setq pt1 (getpoint "Enter start point of flex ")
         pt2 (getpoint "\nEnter second point of flex" pt1)
   )
   (command "insert" "1flexcon" pt1 _SC "" pt2)
   (setq pt3 (getpoint "\nEnter third point of flex" pt2)
         pt5 (getpoint "\nEnter fourth point of flex" pt3)
         pt4 (getpoint "\nEnter last point of flex" pt5)
          sp (polar pt1 (angle pt1 pt2) (* _SC 0.03125))
          ep (polar pt4 (angle pt4 pt5) (* _SC 0.03125))
   )
   (command "pline" sp pt2 pt3 pt5 ep "" "pedit" "l" "s" "w"
            (* _SC 0.015625 _PLOTSCALE) "" "insert" "" pt4 _SC "" pt5
   )
   (med_ret_ok)
   (princ)
)
(defun c:consize(/)
   (med_cur_set "c:consize")
   (if (> (setq index_val (load_dialog "MED")) 0)
      (progn
         (if (new_dialog "Med_ConSize" index_val)
            (progn 
                (set_tile (eval (strcat "size" (strcase _CLETT T))) "1")
                (action_tile "sizea" "(newsz 0.840 \"A\" 0.50)")
                (action_tile "sizeb" "(newsz 1.050 \"B\" 0.75)")
                (action_tile "sizec" "(newsz 1.315 \"C\" 1.00)")
                (action_tile "sized" "(newsz 1.660 \"D\" 1.25)")
                (action_tile "sizee" "(newsz 1.9   \"E\" 1.50)")
                (action_tile "sizef" "(newsz 2.375 \"F\" 2.00)")
                (action_tile "sizeg" "(newsz 2.875 \"G\" 2.50)")
                (action_tile "sizeh" "(newsz 3.50  \"H\" 3.00)")
                (action_tile "sizei" "(newsz 4.0   \"I\" 3.50)")
                (action_tile "sizej" "(newsz 4.50  \"J\" 4.00)")
                (action_tile "sizek" "(newsz 5.563 \"K\" 5.00)")
                (action_tile "sizel" "(newsz 6.625 \"L\" 6.00)")
                (action_tile "runcon" "(done_dialog 2)")
                (action_tile "accept" "(done_dialog 1)")
                (action_tile "cancel" "(done_dialog 0)")


                (setq result (start_dialog))
            )
         )
         (unload_dialog index_val)
         (if (= result 1)
            (newsz nil nil nil)
         )
         (if (= result 2)
          (progn
            (newsz nil nil nil)
            (c:conduit)
          )
         )

      )
   )
   (med_ret_ok)
   (princ)
)

